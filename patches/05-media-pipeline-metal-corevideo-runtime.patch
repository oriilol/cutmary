+            kvImageNoError
+        );
+        assert_eq!(&argb[0..4], &[255, 200, 100, 50]);
+
+        let mut y_plane = [0u8; 4];
+        let mut uv_plane = [0u8; 2];
+        let y_buf = vImage_Buffer {
+            data: y_plane.as_mut_ptr().cast(),
+            width: 2,
+            height: 2,
+            rowBytes: 2,
+        };
+        let uv_buf = vImage_Buffer {
