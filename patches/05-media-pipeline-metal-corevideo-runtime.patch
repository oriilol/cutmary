+/// Decodes a `CGImage` bitmap_info into (channel order for R,G,B,A in memory,
+/// premultiplied, has_alpha, bpp_bytes).
+#[derive(Clone, Copy, Debug)]
+struct PixelLayout {
+    bpp: usize, // bytes per pixel: 1, 3, or 4
+    /// Memory byte index for [R, G, B, A] (when bpp == 4 or 3).
+    rgba_idx: [usize; 4],
+    premultiplied: bool,
+    has_alpha: bool,
+}
+
+fn layout_from_cg_format(bpc: u32, bpp: u32, bitmap_info: u32) -> PixelLayout {
+    let bytes = ((bpp as usize).max(bpc as usize)).div_ceil(8).clamp(1, 4);
+    let alpha_info = bitmap_info & 0x1F;
+    let byte_order = bitmap_info & 0x7000;
+    let little_32 = byte_order == 0x2000; // kCGBitmapByteOrder32Little
+    // kCGImageAlphaNone=0, PremultipliedLast=1, PremultipliedFirst=2,
+    // Last=3, First=4, NoneSkipLast=5, NoneSkipFirst=6, Only=7
+    let premultiplied = matches!(alpha_info, 1 | 2);
+    let has_alpha = matches!(alpha_info, 1 | 2 | 3 | 4 | 7);
+    let alpha_first = matches!(alpha_info, 2 | 4 | 6);
+    let rgba_idx = match (bytes, alpha_first, little_32) {
+        (4, false, false) => [0, 1, 2, 3], // RGBA (big/default)
+        (4, true, false) => [1, 2, 3, 0],  // ARGB (big/default)
+        (4, true, true) => [2, 1, 0, 3],   // BGRA (32Little + First = memory B,G,R,A)
+        (4, false, true) => [3, 2, 1, 0],  // ABGR (32Little + Last  = memory A,B,G,R)
+        (3, _, true) => [2, 1, 0, 3],      // BGR
+        (3, _, false) => [0, 1, 2, 3],     // RGB
+        _ => [0, 0, 0, 0],                 // Planar8 / Gray
+    };
+    PixelLayout {
+        bpp: bytes,
+        rgba_idx,
+        premultiplied,
+        has_alpha,
+    }
+}
+
+#[inline]
+unsafe fn read_rgba(row: *const u8, x: usize, layout: PixelLayout) -> [u8; 4] {
+    match layout.bpp {
+        4 => {
+            let off = x * 4;
+            let raw = unsafe {
+                [
+                    *row.add(off),
+                    *row.add(off + 1),
+                    *row.add(off + 2),
+                    *row.add(off + 3),
+                ]
+            };
+            let a = if layout.has_alpha {
+                raw[layout.rgba_idx[3]]
+            } else {
+                255
+            };
+            let mut r = raw[layout.rgba_idx[0]];
+            let mut g = raw[layout.rgba_idx[1]];
+            let mut b = raw[layout.rgba_idx[2]];
+            if layout.premultiplied {
+                r = unpremul_channel(r, a);
+                g = unpremul_channel(g, a);
+                b = unpremul_channel(b, a);
+            }
+            [r, g, b, a]
+        }
+        3 => {
+            let off = x * 3;
+            let raw = unsafe { [*row.add(off), *row.add(off + 1), *row.add(off + 2)] };
+            [
+                raw[layout.rgba_idx[0]],
+                raw[layout.rgba_idx[1]],
+                raw[layout.rgba_idx[2]],
+                255,
+            ]
+        }
+        _ => {
+            let v = unsafe { *row.add(x) };
+            [v, v, v, 255]
+        }
+    }
+}
+
+#[inline]
+unsafe fn write_rgba(row: *mut u8, x: usize, rgba: [u8; 4], layout: PixelLayout) {
+    let [mut r, mut g, mut b, mut a] = rgba;
+    if !layout.has_alpha {
+        a = 255;
+    } else if layout.premultiplied {
+        r = premul_channel(r, a);
+        g = premul_channel(g, a);
+        b = premul_channel(b, a);
+    }
+    match layout.bpp {
+        4 => {
+            let off = x * 4;
+            unsafe {
+                *row.add(off + layout.rgba_idx[0]) = r;
+                *row.add(off + layout.rgba_idx[1]) = g;
+                *row.add(off + layout.rgba_idx[2]) = b;
+                *row.add(off + layout.rgba_idx[3]) = a;
+            }
+        }
+        3 => {
+            let off = x * 3;
+            unsafe {
+                *row.add(off + layout.rgba_idx[0]) = r;
+                *row.add(off + layout.rgba_idx[1]) = g;
+                *row.add(off + layout.rgba_idx[2]) = b;
+            }
+        }
+        _ => {
+            let luma = ((u32::from(r) * 77 + u32::from(g) * 150 + u32::from(b) * 29) >> 8) as u8;
+            unsafe { *row.add(x) = luma };
+        }
+    }
+}
