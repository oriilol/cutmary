@@ -0,0 +1,910 @@
+//! `CVMetalTextureCache` and `CVOpenGLTextureCache`: GPU textures made from
+//! pixel buffers.
+//!
+//! Metal textures are cached per `(device, backing, plane, pixel_format, size)`
+//! so producer and consumer callers referencing the same `CVPixelBuffer` or
+//! `IOSurface` share one GPU `MTLTexture`, while CPU write unlocks re-upload
+//! updated pixels on the next lookup.
+
+use std::collections::HashMap;
+use std::ffi::c_void;
+use std::sync::atomic::Ordering;
+use std::sync::{Mutex, OnceLock};
+
+use corefoundation::base::CFTypeRef;
+use objc::class::Class;
+use objc::object::Id;
+use objc::sel::Sel;
+
+use super::{
+    BGRA, CVPixelBufferGetBaseAddressOfPlane, CVPixelBufferGetBytesPerRowOfPlane,
+    CVPixelBufferGetHeightOfPlane, CVPixelBufferGetPixelFormatType, CVPixelBufferGetPlaneCount,
+    CVPixelBufferGetWidthOfPlane, CVPixelBufferLockBaseAddress, CVPixelBufferUnlockBaseAddress,
+    ERROR, INVALID_ARGUMENT, Memory, READ_ONLY, SUCCESS, attribute, state,
+};
+
+/// `kCVReturnPixelBufferNotOpenGLCompatible`.
+const NOT_OPENGL_COMPATIBLE: i32 = -6683;
+/// `kCVReturnPixelBufferNotMetalCompatible`.
+const NOT_METAL_COMPATIBLE: i32 = -6684;
+/// `MTLTextureUsageShaderRead`, `ShaderWrite`, `RenderTarget`.
+const MTL_TEXTURE_USAGE_SHADER_READ: u64 = 1;
+const MTL_TEXTURE_USAGE_SHADER_WRITE: u64 = 2;
+const MTL_TEXTURE_USAGE_RENDER_TARGET: u64 = 4;
+
+#[derive(Clone, Copy, Eq, Hash, PartialEq)]
+struct SurfaceTextureKey {
+    surface_id: u32,
+    device: usize,
+    plane: usize,
+    pixel_format: u64,
+    width: usize,
+    height: usize,
+}
+
+pub(super) struct CachedMetalTexture {
+    device: usize,
+    plane: usize,
+    pixel_format: u64,
+    width: usize,
+    height: usize,
+    texture: usize,
+    cpu_gen: u64,
+    surface_seed: u32,
+}
+
+impl Drop for CachedMetalTexture {
+    fn drop(&mut self) {
+        if self.texture != 0 {
+            objc::arc::release(self.texture as Id);
+        }
+    }
+}
+
+static IOSURFACE_TEXTURES: OnceLock<Mutex<HashMap<SurfaceTextureKey, CachedMetalTexture>>> =
+    OnceLock::new();
+
+fn iosurface_textures() -> &'static Mutex<HashMap<SurfaceTextureKey, CachedMetalTexture>> {
+    IOSURFACE_TEXTURES.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+/// Drop cached Metal textures for an `IOSurface` once its use count returns to 0.
+pub(super) fn evict_surface(surface_id: u32) {
+    let mut dropped = Vec::new();
+    {
+        let mut map = iosurface_textures()
+            .lock()
+            .unwrap_or_else(|e| e.into_inner());
+        let keys: Vec<SurfaceTextureKey> = map
+            .keys()
+            .copied()
+            .filter(|k| k.surface_id == surface_id)
+            .collect();
+        for key in keys {
+            if let Some(entry) = map.remove(&key) {
+                dropped.push(entry);
+            }
+        }
+    }
+    drop(dropped);
+}
+/// `kCVPixelFormatType_32ARGB`.
+const ARGB: u32 = 0x20;
+const RGBA: u32 = u32::from_be_bytes(*b"RGBA");
+
+const GL_TEXTURE_RECTANGLE: u32 = 0x84F5;
+const GL_TEXTURE_BINDING_RECTANGLE: u32 = 0x84F6;
+const GL_RGBA8: i32 = 0x8058;
+const GL_RGBA: u32 = 0x1908;
+const GL_BGRA: u32 = 0x80E1;
+const GL_UNSIGNED_BYTE: u32 = 0x1401;
+const GL_UNSIGNED_INT_8_8_8_8: u32 = 0x8035;
+const GL_UNSIGNED_INT_8_8_8_8_REV: u32 = 0x8367;
+const GL_UNPACK_ROW_LENGTH: u32 = 0x0CF2;
+const GL_UNPACK_ALIGNMENT: u32 = 0x0CF5;
+const GL_PIXEL_UNPACK_BUFFER: u32 = 0x88EC;
+const GL_PIXEL_UNPACK_BUFFER_BINDING: u32 = 0x88EF;
+const GL_TEXTURE_MIN_FILTER: u32 = 0x2801;
+const GL_TEXTURE_MAG_FILTER: u32 = 0x2800;
+const GL_TEXTURE_WRAP_S: u32 = 0x2802;
+const GL_TEXTURE_WRAP_T: u32 = 0x2803;
+const GL_LINEAR: i32 = 0x2601;
+const GL_CLAMP_TO_EDGE: i32 = 0x812F;
+
+/// `MTLRegion`.
+#[repr(C)]
+struct Region {
+    origin: [u64; 3],
+    size: [u64; 3],
+}
+
+struct MetalCache {
+    /// The `id<MTLDevice>` textures are made on, retained.
+    device: Id,
+}
+
+impl Drop for MetalCache {
+    fn drop(&mut self) {
+        objc::arc::release(self.device);
+    }
+}
+
+struct MetalTexture {
+    /// The `id<MTLTexture>`, owned.
+    texture: Id,
+    /// The pixel buffer it was made from, retained as macOS does.
+    buffer: CFTypeRef,
+}
+
+impl Drop for MetalTexture {
+    fn drop(&mut self) {
+        objc::arc::release(self.texture);
+        // SAFETY: the retain this texture took.
+        unsafe { corefoundation::api::CFRelease(self.buffer) };
+    }
+}
+
+struct GlCache;
+
+struct GlTexture {
+    name: u32,
+    buffer: CFTypeRef,
+}
+
+impl Drop for GlTexture {
+    fn drop(&mut self) {
+        // FIXME (ACCURACY): the name is only deleted when some GL context is
+        // current on the releasing thread; contexts here share objects.
+        if !sdl3::video::gl_current_context().is_null()
+            && let Some(gl) = Gl::get()
+        {
+            // SAFETY: a texture name this cache made, with a context current.
+            unsafe { (gl.delete_textures)(1, &self.name) };
+        }
+        // SAFETY: the retain this texture took.
+        unsafe { corefoundation::api::CFRelease(self.buffer) };
+    }
+}
+
+fn register<T: 'static>(
+    slot: &'static OnceLock<usize>,
+    name: &'static std::ffi::CStr,
+) -> &'static Class {
+    let addr = *slot.get_or_init(|| {
+        corefoundation::bootstrap();
+        objc::class::ptr(corefoundation::boxed::register::<T>(name, None, true)) as usize
+    });
+    // SAFETY: the registered class lives for the process.
+    unsafe { &*(addr as *const Class) }
+}
+
+fn metal_cache_class() -> &'static Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    register::<MetalCache>(&CLASS, c"__CVMetalTextureCache")
+}
+
+fn metal_texture_class() -> &'static Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    register::<MetalTexture>(&CLASS, c"__CVMetalTexture")
+}
+
+fn gl_cache_class() -> &'static Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    register::<GlCache>(&CLASS, c"__CVOpenGLTextureCache")
+}
+
+fn gl_texture_class() -> &'static Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    register::<GlTexture>(&CLASS, c"__CVOpenGLTexture")
+}
+
+fn contents<'a, T>(object: CFTypeRef, class: &'static Class) -> Option<&'a T> {
+    if object.is_null() {
+        return None;
+    }
+    // SAFETY: a live CF object; its class is checked before the body is read.
+    unsafe { corefoundation::boxed::contents::<T>(object, class) }.map(|t| &*t)
+}
+
+/// One plane of a locked pixel buffer, or the whole of a packed one.
+struct PlaneView {
+    base: *const u8,
+    width: usize,
+    height: usize,
+    bytes_per_row: usize,
+}
+
+/// Locks `buffer` for reading and describes `plane`; `None` when the buffer is
+/// not one of this runtime's or has no such plane.
+fn lock_plane(buffer: CFTypeRef, plane: usize) -> Option<PlaneView> {
+    state(buffer)?;
+    // SAFETY: a pixel buffer of this crate's, checked above.
+    unsafe {
+        let planes = CVPixelBufferGetPlaneCount(buffer);
+        if plane >= planes.max(1) || CVPixelBufferLockBaseAddress(buffer, READ_ONLY) != SUCCESS {
+            return None;
+        }
+        // The plane accessors answer for the whole image of a packed buffer.
+        let view = PlaneView {
+            base: CVPixelBufferGetBaseAddressOfPlane(buffer, plane).cast(),
+            width: CVPixelBufferGetWidthOfPlane(buffer, plane),
+            height: CVPixelBufferGetHeightOfPlane(buffer, plane),
+            bytes_per_row: CVPixelBufferGetBytesPerRowOfPlane(buffer, plane),
+        };
+        if view.base.is_null() {
+            CVPixelBufferUnlockBaseAddress(buffer, READ_ONLY);
+            return None;
+        }
+        Some(view)
+    }
+}
+
+fn unlock(buffer: CFTypeRef) {
+    // SAFETY: a buffer `lock_plane` locked.
+    unsafe { CVPixelBufferUnlockBaseAddress(buffer, READ_ONLY) };
+}
+
+// --- Metal -------------------------------------------------------------------
+
+/// CVReturn CVMetalTextureCacheCreate(CFAllocatorRef, CFDictionaryRef
+/// cacheAttributes, id<MTLDevice>, CFDictionaryRef textureAttributes,
+/// CVMetalTextureCacheRef *).
+///
+/// # Safety
+/// `device` must be nil or an `MTLDevice`; `out` must be writable.
+pub unsafe extern "C" fn CVMetalTextureCacheCreate(
+    _allocator: CFTypeRef,
+    _cache_attributes: CFTypeRef,
+    device: Id,
+    _texture_attributes: CFTypeRef,
+    out: *mut CFTypeRef,
+) -> i32 {
+    if out.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: the caller's out-parameter.
+    unsafe { *out = std::ptr::null() };
+    if device.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    let made = corefoundation::boxed::make(
+        metal_cache_class(),
+        MetalCache {
+            device: objc::arc::retain(device),
+        },
+    );
+    if made.is_null() {
+        return super::ALLOCATION_FAILED;
+    }
+    // SAFETY: as above.
+    unsafe { *out = made };
+    SUCCESS
+}
+
+/// CVReturn CVMetalTextureCacheCreateTextureFromImage(CFAllocatorRef,
+/// CVMetalTextureCacheRef, CVImageBufferRef, CFDictionaryRef textureAttributes,
+/// MTLPixelFormat, size_t width, size_t height, size_t planeIndex,
+/// CVMetalTextureRef *).
+///
+/// # Safety
+/// The references must be live CF objects or null; `out` must be writable.
+#[allow(clippy::too_many_arguments)]
+pub unsafe extern "C" fn CVMetalTextureCacheCreateTextureFromImage(
+    _allocator: CFTypeRef,
+    cache: CFTypeRef,
+    image: CFTypeRef,
+    texture_attributes: CFTypeRef,
+    pixel_format: u64,
+    width: usize,
+    height: usize,
+    plane: usize,
+    out: *mut CFTypeRef,
+) -> i32 {
+    if out.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: the caller's out-parameter.
+    unsafe { *out = std::ptr::null() };
+    let Some(cache) = contents::<MetalCache>(cache, metal_cache_class()) else {
+        return INVALID_ARGUMENT;
+    };
+    if width == 0 || height == 0 {
+        return INVALID_ARGUMENT;
+    }
+    let Some(view) = lock_plane(image, plane) else {
+        return INVALID_ARGUMENT;
+    };
+    if width > view.width || height > view.height {
+        unlock(image);
+        return NOT_METAL_COMPATIBLE;
+    }
+    // SAFETY: null or a CF value from the caller's dictionary.
+    let requested_usage = unsafe {
+        corefoundation::collections::number(attribute(texture_attributes, "MetalTextureUsage"))
+    }
+    .and_then(|n| u64::try_from(n.as_i64()).ok())
+    .unwrap_or(0);
+    let usage = requested_usage | MTL_TEXTURE_USAGE_SHADER_READ | MTL_TEXTURE_USAGE_RENDER_TARGET;
+    let Some(pb_state) = state(image) else {
+        unlock(image);
+        return INVALID_ARGUMENT;
+    };
+    let cpu_gen = pb_state.cpu_generation.load(Ordering::Acquire);
+    let texture = match &pb_state.memory {
+        Memory::Surface(surface) => {
+            // SAFETY: live IOSurface owned by this pixel buffer.
+            let surface_id = unsafe { iosurface::IOSurfaceGetID(surface.object) };
+            let surface_seed = unsafe { iosurface::IOSurfaceGetSeed(surface.object) };
+            let key = SurfaceTextureKey {
+                surface_id,
+                device: cache.device as usize,
+                plane,
+                pixel_format,
+                width,
+                height,
+            };
+            let existing = {
+                let mut map = iosurface_textures()
+                    .lock()
+                    .unwrap_or_else(|e| e.into_inner());
+                map.get_mut(&key).map(|entry| {
+                    let dirty = entry.cpu_gen != cpu_gen || entry.surface_seed != surface_seed;
+                    entry.cpu_gen = cpu_gen;
+                    entry.surface_seed = surface_seed;
+                    (objc::arc::retain(entry.texture as Id), dirty)
+                })
+            };
+            match existing {
+                Some((tex, dirty)) => {
+                    if dirty {
+                        upload_metal_plane(tex, width, height, &view);
+                    }
+                    tex
+                }
+                None => {
+                    let tex =
+                        make_metal_texture(cache.device, pixel_format, width, height, usage, &view);
+                    if !tex.is_null() {
+                        let mut map = iosurface_textures()
+                            .lock()
+                            .unwrap_or_else(|e| e.into_inner());
+                        map.insert(
+                            key,
+                            CachedMetalTexture {
+                                device: cache.device as usize,
+                                plane,
+                                pixel_format,
+                                width,
+                                height,
+                                texture: objc::arc::retain(tex) as usize,
+                                cpu_gen,
+                                surface_seed,
+                            },
+                        );
+                    }
+                    tex
+                }
+            }
+        }
+        _ => {
+            let existing = {
+                let mut list = pb_state
+                    .metal_textures
+                    .lock()
+                    .unwrap_or_else(|e| e.into_inner());
+                list.iter_mut()
+                    .find(|e| {
+                        e.device == cache.device as usize
+                            && e.plane == plane
+                            && e.pixel_format == pixel_format
+                            && e.width == width
+                            && e.height == height
+                    })
+                    .map(|entry| {
+                        let dirty = entry.cpu_gen != cpu_gen;
+                        entry.cpu_gen = cpu_gen;
+                        (objc::arc::retain(entry.texture as Id), dirty)
+                    })
+            };
+            match existing {
+                Some((tex, dirty)) => {
+                    if dirty {
+                        upload_metal_plane(tex, width, height, &view);
+                    }
+                    tex
+                }
+                None => {
+                    let tex =
+                        make_metal_texture(cache.device, pixel_format, width, height, usage, &view);
+                    if !tex.is_null() {
+                        let mut list = pb_state
+                            .metal_textures
+                            .lock()
+                            .unwrap_or_else(|e| e.into_inner());
+                        list.push(CachedMetalTexture {
+                            device: cache.device as usize,
+                            plane,
+                            pixel_format,
+                            width,
+                            height,
+                            texture: objc::arc::retain(tex) as usize,
+                            cpu_gen,
+                            surface_seed: 0,
+                        });
+                    }
+                    tex
+                }
+            }
+        }
+    };
+    unlock(image);
+    if texture.is_null() {
+        return NOT_METAL_COMPATIBLE;
+    }
+    // SAFETY: a live pixel buffer, retained for the texture's lifetime.
+    let buffer = unsafe { corefoundation::api::CFRetain(image) };
+    let made = corefoundation::boxed::make(metal_texture_class(), MetalTexture { texture, buffer });
+    if made.is_null() {
+        return super::ALLOCATION_FAILED;
+    }
+    // SAFETY: as above.
+    unsafe { *out = made };
+    SUCCESS
+}
+
+fn upload_metal_plane(texture: Id, width: usize, height: usize, view: &PlaneView) {
+    // SAFETY: an `id<MTLTexture>` made on this runtime and a locked plane view.
+    unsafe {
+        let replace: unsafe extern "C" fn(Id, Sel, Region, u64, *const c_void, u64) =
+            std::mem::transmute(objc::msg::entry());
+        replace(
+            texture,
+            objc::sel::get("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"),
+            Region {
+                origin: [0; 3],
+                size: [width as u64, height as u64, 1],
+            },
+            0,
+            view.base.cast(),
+            view.bytes_per_row as u64,
+        );
+    }
+}
+
+/// A new texture on `device` holding `view`'s pixels, owned by the caller.
+fn make_metal_texture(
+    device: Id,
+    pixel_format: u64,
+    width: usize,
+    height: usize,
+    usage: u64,
+    view: &PlaneView,
+) -> Id {
+    let Some(class) = objc::class::lookup(c"MTLTextureDescriptor") else {
+        return std::ptr::null_mut();
+    };
+    // SAFETY: Metal's own signatures for each selector, sent to a descriptor
+    // class, a descriptor, a device and the texture it made.
+    unsafe {
+        let make_descriptor: unsafe extern "C" fn(Id, Sel, u64, u64, u64, bool) -> Id =
+            std::mem::transmute(objc::msg::entry());
+        let descriptor = make_descriptor(
+            objc::class::ptr(class) as Id,
+            objc::sel::get("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"),
+            pixel_format,
+            width as u64,
+            height as u64,
+            false,
+        );
+        if descriptor.is_null() {
+            return std::ptr::null_mut();
+        }
+        let set_usage: unsafe extern "C" fn(Id, Sel, u64) = std::mem::transmute(objc::msg::entry());
+        let new_texture: unsafe extern "C" fn(Id, Sel, Id) -> Id =
+            std::mem::transmute(objc::msg::entry());
+        // Try Read | Write | RenderTarget first so compute + render passes can
+        // both target the shared texture; fall back to Read | RenderTarget for
+        // formats without storage support.
+        set_usage(
+            descriptor,
+            objc::sel::get("setUsage:"),
+            usage | MTL_TEXTURE_USAGE_SHADER_WRITE,
+        );
+        let mut texture = new_texture(
+            device,
+            objc::sel::get("newTextureWithDescriptor:"),
+            descriptor,
+        );
+        if texture.is_null() {
+            set_usage(descriptor, objc::sel::get("setUsage:"), usage);
+            texture = new_texture(
+                device,
+                objc::sel::get("newTextureWithDescriptor:"),
+                descriptor,
+            );
+        }
+        if texture.is_null() {
+            return texture;
+        }
+        upload_metal_plane(texture, width, height, view);
+        texture
+    }
+}
+
+/// id<MTLTexture> CVMetalTextureGetTexture(CVMetalTextureRef), under the get rule.
+pub unsafe extern "C" fn CVMetalTextureGetTexture(texture: CFTypeRef) -> Id {
+    contents::<MetalTexture>(texture, metal_texture_class())
+        .map_or(std::ptr::null_mut(), |t| t.texture)
+}
+
+/// void CVMetalTextureCacheFlush(CVMetalTextureCacheRef, CVOptionFlags).
+pub unsafe extern "C" fn CVMetalTextureCacheFlush(_cache: CFTypeRef, _options: u64) {}
+
+// --- OpenGL ------------------------------------------------------------------
+
+/// The GL entry points texture upload needs, from the current driver.
+struct Gl {
+    gen_textures: unsafe extern "C" fn(i32, *mut u32),
+    delete_textures: unsafe extern "C" fn(i32, *const u32),
+    bind_texture: unsafe extern "C" fn(u32, u32),
+    tex_image_2d: unsafe extern "C" fn(u32, i32, i32, i32, i32, i32, u32, u32, *const c_void),
+    tex_parameteri: unsafe extern "C" fn(u32, u32, i32),
+    pixel_storei: unsafe extern "C" fn(u32, i32),
+    get_integerv: unsafe extern "C" fn(u32, *mut i32),
+    bind_buffer: unsafe extern "C" fn(u32, u32),
+}
+
+impl Gl {
+    fn get() -> Option<&'static Gl> {
+        static GL: OnceLock<Option<Gl>> = OnceLock::new();
+        GL.get_or_init(|| {
+            let f = |name: &std::ffi::CStr| sdl3::video::gl_proc_address(name);
+            // SAFETY: each pointer is the driver's entry point of that name,
+            // whose C signature is fixed by the GL specification.
+            unsafe {
+                Some(Gl {
+                    gen_textures: std::mem::transmute(f(c"glGenTextures")?),
+                    delete_textures: std::mem::transmute(f(c"glDeleteTextures")?),
+                    bind_texture: std::mem::transmute(f(c"glBindTexture")?),
+                    tex_image_2d: std::mem::transmute(f(c"glTexImage2D")?),
+                    tex_parameteri: std::mem::transmute(f(c"glTexParameteri")?),
+                    pixel_storei: std::mem::transmute(f(c"glPixelStorei")?),
+                    get_integerv: std::mem::transmute(f(c"glGetIntegerv")?),
+                    bind_buffer: std::mem::transmute(f(c"glBindBuffer")?),
+                })
+            }
+        })
+        .as_ref()
+    }
+}
+
+/// The GL upload format and type for a packed 32-bit pixel format, or `None`
+/// for a format a single GL texture cannot hold as macOS would.
+pub(crate) fn gl_upload_format(pixel_format: u32) -> Option<(u32, u32)> {
+    match pixel_format {
+        BGRA => Some((GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV)),
+        ARGB => Some((GL_BGRA, GL_UNSIGNED_INT_8_8_8_8)),
+        RGBA => Some((GL_RGBA, GL_UNSIGNED_BYTE)),
+        _ => None,
+    }
+}
+
+/// CVReturn CVOpenGLTextureCacheCreate(CFAllocatorRef, CFDictionaryRef
+/// cacheAttributes, CGLContextObj, CGLPixelFormatObj, CFDictionaryRef
+/// textureAttributes, CVOpenGLTextureCacheRef *).
+///
+/// FIXME (ACCURACY): textures are made in whichever GL context is current when
+/// one is asked for, not necessarily `context`; contexts here share objects.
+///
+/// # Safety
+/// `out` must be writable.
+pub unsafe extern "C" fn CVOpenGLTextureCacheCreate(
+    _allocator: CFTypeRef,
+    _cache_attributes: CFTypeRef,
+    context: *mut c_void,
+    _pixel_format: *mut c_void,
+    _texture_attributes: CFTypeRef,
+    out: *mut CFTypeRef,
+) -> i32 {
+    if out.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: the caller's out-parameter.
+    unsafe { *out = std::ptr::null() };
+    if context.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    let made = corefoundation::boxed::make(gl_cache_class(), GlCache);
+    if made.is_null() {
+        return super::ALLOCATION_FAILED;
+    }
+    // SAFETY: as above.
+    unsafe { *out = made };
+    SUCCESS
+}
+
+/// CVReturn CVOpenGLTextureCacheCreateTextureFromImage(CFAllocatorRef,
+/// CVOpenGLTextureCacheRef, CVImageBufferRef, CFDictionaryRef attributes,
+/// CVOpenGLTextureRef *).
+///
+/// # Safety
+/// The references must be live CF objects or null; `out` must be writable.
+pub unsafe extern "C" fn CVOpenGLTextureCacheCreateTextureFromImage(
+    _allocator: CFTypeRef,
+    cache: CFTypeRef,
+    image: CFTypeRef,
+    _attributes: CFTypeRef,
+    out: *mut CFTypeRef,
+) -> i32 {
+    if out.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: the caller's out-parameter.
+    unsafe { *out = std::ptr::null() };
+    if contents::<GlCache>(cache, gl_cache_class()).is_none() || state(image).is_none() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: a pixel buffer of this crate's, checked above.
+    let Some((format, kind)) = gl_upload_format(unsafe { CVPixelBufferGetPixelFormatType(image) })
+    else {
+        return NOT_OPENGL_COMPATIBLE;
+    };
+    let (Some(gl), false) = (Gl::get(), sdl3::video::gl_current_context().is_null()) else {
+        return ERROR;
+    };
+    let Some(view) = lock_plane(image, 0) else {
+        return INVALID_ARGUMENT;
+    };
+    let name = upload_gl_texture(gl, format, kind, &view);
+    unlock(image);
+    // SAFETY: a live pixel buffer, retained for the texture's lifetime.
+    let buffer = unsafe { corefoundation::api::CFRetain(image) };
+    let made = corefoundation::boxed::make(gl_texture_class(), GlTexture { name, buffer });
+    if made.is_null() {
+        return super::ALLOCATION_FAILED;
+    }
+    // SAFETY: as above.
+    unsafe { *out = made };
+    SUCCESS
+}
+
+/// A new rectangle texture holding `view`, leaving the caller's unpack state
+/// and texture binding as they were.
+fn upload_gl_texture(gl: &Gl, format: u32, kind: u32, view: &PlaneView) -> u32 {
+    const BYTES_PER_PIXEL: usize = 4;
+    // SAFETY: a context is current, checked by the caller; every piece of
+    // state changed here is read first and put back.
+    unsafe {
+        let mut saved = [0i32; 4];
+        (gl.get_integerv)(GL_TEXTURE_BINDING_RECTANGLE, &mut saved[0]);
+        (gl.get_integerv)(GL_UNPACK_ROW_LENGTH, &mut saved[1]);
+        (gl.get_integerv)(GL_UNPACK_ALIGNMENT, &mut saved[2]);
+        (gl.get_integerv)(GL_PIXEL_UNPACK_BUFFER_BINDING, &mut saved[3]);
+        let mut name = 0;
+        (gl.gen_textures)(1, &mut name);
+        (gl.bind_texture)(GL_TEXTURE_RECTANGLE, name);
+        (gl.bind_buffer)(GL_PIXEL_UNPACK_BUFFER, 0);
+        (gl.pixel_storei)(
+            GL_UNPACK_ROW_LENGTH,
+            (view.bytes_per_row / BYTES_PER_PIXEL) as i32,
+        );
+        (gl.pixel_storei)(GL_UNPACK_ALIGNMENT, 1);
+        (gl.tex_image_2d)(
+            GL_TEXTURE_RECTANGLE,
+            0,
+            GL_RGBA8,
+            view.width as i32,
+            view.height as i32,
+            0,
+            format,
+            kind,
+            view.base.cast(),
+        );
+        for (parameter, value) in [
+            (GL_TEXTURE_MIN_FILTER, GL_LINEAR),
+            (GL_TEXTURE_MAG_FILTER, GL_LINEAR),
+            (GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE),
+            (GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE),
+        ] {
+            (gl.tex_parameteri)(GL_TEXTURE_RECTANGLE, parameter, value);
+        }
+        (gl.pixel_storei)(GL_UNPACK_ROW_LENGTH, saved[1]);
+        (gl.pixel_storei)(GL_UNPACK_ALIGNMENT, saved[2]);
+        (gl.bind_buffer)(GL_PIXEL_UNPACK_BUFFER, saved[3] as u32);
+        (gl.bind_texture)(GL_TEXTURE_RECTANGLE, saved[0] as u32);
+        name
+    }
+}
+
+/// GLuint CVOpenGLTextureGetName(CVOpenGLTextureRef).
+pub unsafe extern "C" fn CVOpenGLTextureGetName(texture: CFTypeRef) -> u32 {
+    contents::<GlTexture>(texture, gl_texture_class()).map_or(0, |t| t.name)
+}
+
+/// GLenum CVOpenGLTextureGetTarget(CVOpenGLTextureRef): always a rectangle
+/// texture, as on macOS.
+pub unsafe extern "C" fn CVOpenGLTextureGetTarget(texture: CFTypeRef) -> u32 {
+    contents::<GlTexture>(texture, gl_texture_class()).map_or(0, |_| GL_TEXTURE_RECTANGLE)
+}
+
+/// void CVOpenGLTextureCacheFlush(CVOpenGLTextureCacheRef, CVOptionFlags).
+pub unsafe extern "C" fn CVOpenGLTextureCacheFlush(_cache: CFTypeRef, _options: u64) {}
+
+pub unsafe extern "C" fn CVOpenGLTextureCacheRelease(cache: CFTypeRef) {
+    if !cache.is_null() {
+        // SAFETY: a live cache the caller passed.
+        unsafe { corefoundation::api::CFRelease(cache) };
+    }
+}
+
+pub unsafe extern "C" fn CVOpenGLTextureRelease(texture: CFTypeRef) {
+    if !texture.is_null() {
+        // SAFETY: a live texture the caller passed.
+        unsafe { corefoundation::api::CFRelease(texture) };
+    }
+}
