+    class.replace_method(
+        objc::sel::get("commonFormat"),
+        af_common_format as *const std::ffi::c_void,
+        c"Q16@0:8",
+    );
+    class.replace_method(
+        objc::sel::get("isStandard"),
+        af_is_standard as *const std::ffi::c_void,
+        c"c16@0:8",
+    );
+}
