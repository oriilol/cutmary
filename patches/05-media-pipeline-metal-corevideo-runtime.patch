+        "active" => yes, c"B16@0:8";
+        "isUsed" => yes, c"B16@0:8";
+        "used" => yes, c"B16@0:8";
+        "arrayLength" => argument_array_length, c"Q16@0:8";
+        "textureType" => argument_texture_type, c"Q16@0:8";
+        "textureDataType" => argument_texture_data_type, c"Q16@0:8";
+        "isDepthTexture" => no, c"B16@0:8";
+        "bufferDataType" => argument_data_type, c"Q16@0:8";
+        "bufferDataSize" => argument_size, c"Q16@0:8";
+        "bufferAlignment" => argument_alignment, c"Q16@0:8";
+        "bufferStructType" => argument_struct, c"@16@0:8";
+        "bufferPointerType" => crate::nil, c"@16@0:8";
+        "threadgroupMemoryAlignment" => zero, c"Q16@0:8";
+        "threadgroupMemoryDataSize" => zero, c"Q16@0:8";
+        "threadgroupMemoryStructType" => crate::nil, c"@16@0:8";
+        "dealloc" => argument_dealloc, c"v16@0:8";
+    });
+    let class = object::register::<StructType>(c"RosemaryMTLStructType");
+    methods!(class, {
+        "members" => struct_members, c"@16@0:8";
+        "memberByName:" => member_by_name, c"@24@0:8@16";
+        "dataType" => struct_data_type, c"Q16@0:8";
+        "dealloc" => struct_dealloc, c"v16@0:8";
+    });
+    let class = object::register::<Member>(c"RosemaryMTLStructMember");
+    methods!(class, {
+        "name" => member_name, c"@16@0:8";
+        "offset" => member_offset, c"Q16@0:8";
+        "dataType" => member_data_type, c"Q16@0:8";
+        "structType" => member_struct, c"@16@0:8";
+        "arrayType" => member_array, c"@16@0:8";
