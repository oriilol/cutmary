+
+pub unsafe extern "C" fn vImagePremultiplyData_RGBA8888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..s.width {
+            let off = x * 4;
+            let (r, g, b, a) = unsafe {
+                (
+                    *sr.add(off),
+                    *sr.add(off + 1),
+                    *sr.add(off + 2),
+                    *sr.add(off + 3),
+                )
+            };
+            unsafe {
+                *dr.add(off) = premul_channel(r, a);
+                *dr.add(off + 1) = premul_channel(g, a);
+                *dr.add(off + 2) = premul_channel(b, a);
+                *dr.add(off + 3) = a;
+            }
+        }
+    }
+    kvImageNoError
+}
+
+#[derive(Clone, Copy)]
+enum BlendOp {
+    Normal,
+    Darken,
+    Lighten,
+    Multiply,
+    Screen,
+}
+
+unsafe fn premul_blend(
+    srcTop: *const vImage_Buffer,
+    srcBottom: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    op: BlendOp,
+) -> vImage_Error {
+    let (Some(t), Some(b), Some(d)) =
+        (valid_buf(srcTop), valid_buf(srcBottom), valid_buf(dest))
+    else {
+        return kvImageNullPointerArgument;
+    };
+    if t.width != d.width || t.height != d.height || b.width != d.width || b.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    for y in 0..d.height {
+        let tr = unsafe { row_ptr(&t, y) };
+        let br = unsafe { row_ptr(&b, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..d.width {
+            let off = x * 4;
+            let tp = unsafe {
+                [
+                    *tr.add(off) as f32 / 255.0,
+                    *tr.add(off + 1) as f32 / 255.0,
+                    *tr.add(off + 2) as f32 / 255.0,
+                    *tr.add(off + 3) as f32 / 255.0,
+                ]
+            };
+            let bp = unsafe {
+                [
+                    *br.add(off) as f32 / 255.0,
+                    *br.add(off + 1) as f32 / 255.0,
+                    *br.add(off + 2) as f32 / 255.0,
+                    *br.add(off + 3) as f32 / 255.0,
+                ]
+            };
+            let ta = tp[3];
+            let ba = bp[3];
+            let out_a = ta + ba * (1.0 - ta);
+            for c in 0..3 {
+                let s = tp[c];
+                let dst = bp[c];
+                let out_c = match op {
+                    BlendOp::Normal => s + dst * (1.0 - ta),
+                    BlendOp::Darken => (s * ba).min(dst * ta) + s * (1.0 - ba) + dst * (1.0 - ta),
+                    BlendOp::Lighten => (s * ba).max(dst * ta) + s * (1.0 - ba) + dst * (1.0 - ta),
+                    BlendOp::Multiply => s * dst + s * (1.0 - ba) + dst * (1.0 - ta),
+                    BlendOp::Screen => s + dst - s * dst,
+                };
+                unsafe { *dr.add(off + c) = clamp_u8(out_c * 255.0) };
+            }
+            unsafe { *dr.add(off + 3) = clamp_u8(out_a * 255.0) };
+        }
+    }
+    kvImageNoError
+}
