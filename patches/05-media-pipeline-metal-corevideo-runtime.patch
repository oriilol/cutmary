+            height: 2,
+            rowBytes: 8,
+        };
+        assert_eq!(
+            unsafe { vImageConvert_RGB888toARGB8888(&s_rgb, ptr::null(), 255, &d_argb, 0, 0) },
+            kvImageNoError
+        );
+        assert_eq!(&argb[0..4], &[255, 200, 100, 50]);
+
+        let mut y_plane = [0u8; 4];
+        let mut uv_plane = [0u8; 2];
+        let y_buf = vImage_Buffer {
+            data: y_plane.as_mut_ptr().cast(),
+            width: 2,
+            height: 2,
+            rowBytes: 2,
+        };
+        let uv_buf = vImage_Buffer {
+            data: uv_plane.as_mut_ptr().cast(),
+            width: 1,
+            height: 1,
+            rowBytes: 2,
+        };
+        let range = vImage_YpCbCrPixelRange {
+            Yp_bias: 16,
+            CbCr_bias: 128,
+            YpRangeMax: 235,
+            CbCrRangeMax: 240,
+            YpMax: 235,
+            YpMin: 16,
+            CbCrMax: 240,
+            CbCrMin: 16,
+        };
+        let mut to_yuv = [0u8; 128];
+        let mut to_rgb = [0u8; 128];
+        assert_eq!(
+            unsafe {
+                vImageConvert_ARGBToYpCbCr_GenerateConversion(
+                    &MATRIX_ARGB_TO_YCBCR_709,
+                    &range,
+                    to_yuv.as_mut_ptr().cast(),
+                    0,
+                    0,
+                    0,
+                )
+            },
+            kvImageNoError
+        );
+        assert_eq!(
+            unsafe {
+                vImageConvert_YpCbCrToARGB_GenerateConversion(
+                    &MATRIX_YCBCR_TO_ARGB_709,
+                    &range,
+                    to_rgb.as_mut_ptr().cast(),
+                    0,
+                    0,
+                    0,
+                )
+            },
+            kvImageNoError
+        );
+        assert_eq!(
+            unsafe {
+                vImageConvert_ARGB8888To420Yp8_CbCr8(
+                    &d_argb,
+                    &y_buf,
+                    &uv_buf,
+                    to_yuv.as_ptr().cast(),
+                    ptr::null(),
+                    0,
+                )
+            },
+            kvImageNoError
+        );
+        let mut out_argb = [0u8; 16];
+        let out_buf = vImage_Buffer {
+            data: out_argb.as_mut_ptr().cast(),
+            width: 2,
+            height: 2,
+            rowBytes: 8,
+        };
+        assert_eq!(
+            unsafe {
+                vImageConvert_420Yp8_CbCr8ToARGB8888(
+                    &y_buf,
+                    &uv_buf,
+                    &out_buf,
+                    to_rgb.as_ptr().cast(),
+                    ptr::null(),
+                    255,
+                    0,
+                )
+            },
+            kvImageNoError
+        );
+        assert_eq!(out_argb[0], 255);
+        assert!((i32::from(out_argb[1]) - 200).abs() <= 4);
+        assert!((i32::from(out_argb[2]) - 100).abs() <= 4);
+        assert!((i32::from(out_argb[3]) - 50).abs() <= 4);
+    }
+
+    #[test]
+    fn vdsp_and_matrix_globals_work() {
+        let a = [1.0f32, 2.0, 3.0];
