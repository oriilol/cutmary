+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) as *const u16 };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for i in 0..(s.width * 4) {
+            let v16 = unsafe { *sr.add(i) };
+            let v8 = ((u32::from(v16) * 255 + 32768) / 65535).min(255) as u8;
+            unsafe { *dr.add(i) = v8 };
+        }
+    }
+    kvImageNoError
+}
