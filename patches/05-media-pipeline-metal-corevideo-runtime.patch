new file mode 100644
index 00000000..4af46a99
--- /dev/null
+++ b/crates/metal_translate/tests/source_reflection.rs
@@ -0,0 +1,41 @@
+use metal_translate::{ReflectedType, TargetProfile, translate_msl};
+
+#[test]
+fn kernel_arguments_are_reflected_for_pipeline_reflection() {
+    // CapCut's SwingBaseBlender in-place flip: AGFX fails the pipeline when
+    // the reflection it asks for is nil.
+    let source = "using namespace metal;
+        kernel void verticalFlipInplace(texture2d<half, access::read> src [[texture(0)]],
+            texture2d<half, access::write> dst [[texture(1)]], ushort2 gid [[thread_position_in_grid]]) {
+            if (gid.x >= dst.get_width() || gid.y >= dst.get_height() / 2) return;
+            ushort2 flipped = ushort2(gid.x, dst.get_height() - 1 - gid.y);
+            half4 up = src.read(gid); half4 down = src.read(flipped);
+            dst.write(down, gid); dst.write(up, flipped);
+        }";
+    let mut target = TargetProfile::vulkan_1_3();
+    target.shader_storage_image_write_without_format = true;
+    target.shader_int16 = true;
+    let library = translate_msl(source, &target).unwrap();
+    let arguments = &library.entries[0].arguments;
+    let names: Vec<_> = arguments.iter().map(|a| (a.name.as_str(), a.index, a.texture_type, a.texture_data_type)).collect();
+    assert_eq!(names, [("src", 0, 2, 16), ("dst", 1, 2, 16)]);
+}
+
+#[test]
+fn buffer_struct_members_carry_names_offsets_and_types() {
+    let source = "using namespace metal;
+        struct Uniforms { float4x4 mvp; float alpha; float3 tint; float weights[2]; };
+        struct VOut { float4 position [[position]]; };
+        vertex VOut vs(uint id [[vertex_id]], constant Uniforms& u [[buffer(2)]]) {
+            VOut out; out.position = u.mvp * float4(u.tint * u.alpha, u.weights[1]); return out;
+        }";
+    let library = translate_msl(source, &TargetProfile::vulkan_1_3()).unwrap();
+    let argument = &library.entries[0].arguments[0];
+    assert_eq!((argument.name.as_str(), argument.index), ("u", 2));
+    let Some(ReflectedType::Struct { members, size, .. }) = &argument.buffer else {
+        panic!("{argument:?}");
+    };
+    let summary: Vec<_> = members.iter().map(|m| (m.name.as_str(), m.offset, m.ty.data_type())).collect();
+    assert_eq!(summary, [("mvp", 0, 15), ("alpha", 64, 3), ("tint", 80, 5), ("weights", 96, 2)]);
+    assert_eq!(*size, 112);
+}
