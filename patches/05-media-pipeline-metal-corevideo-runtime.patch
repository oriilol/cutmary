+pub unsafe extern "C" fn vImageConvert_ARGB8888To420Yp8_CbCr8(
+    src: *const vImage_Buffer,
+    destYp: *const vImage_Buffer,
+    destCbCr: *const vImage_Buffer,
+    info: *const c_void,
+    permuteMap: *const u8,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(yp), Some(cbcr)) =
+        (valid_buf(src), valid_buf(destYp), valid_buf(destCbCr))
+    else {
+        return kvImageNullPointerArgument;
+    };
+    let conv = read_argb_to_yuv_info(info);
+    let map = read_permute_map(permuteMap);
+    let w = s.width.min(yp.width);
+    let h = s.height.min(yp.height);
+    for y in 0..h {
+        let sr = unsafe { row_ptr(&s, y) };
+        let yr = unsafe { row_ptr_mut(&yp, y) };
+        let uvr = if y / 2 < cbcr.height {
+            Some(unsafe { row_ptr_mut(&cbcr, y / 2) })
+        } else {
+            None
+        };
+        for x in 0..w {
+            let raw = unsafe {
+                [
+                    *sr.add(x * 4),
+                    *sr.add(x * 4 + 1),
+                    *sr.add(x * 4 + 2),
+                    *sr.add(x * 4 + 3),
+                ]
+            };
