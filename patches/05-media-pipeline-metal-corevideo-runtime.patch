diff --git a/crates/metal_translate/src/spirv/reflect.rs b/crates/metal_translate/src/spirv/reflect.rs
new file mode 100644
index 00000000..14a0121e
--- /dev/null
+++ b/crates/metal_translate/src/spirv/reflect.rs
@@ -0,0 +1,248 @@
+//! Argument reflection for `MTLRenderPipelineReflection` and
+//! `MTLComputePipelineReflection`: each resource argument's name, slot and,
+//! for a buffer, the layout of the type it points at.
+
+use crate::ir::{Access, EntryPoint, Function, ResourceKind, TextureDimension, TextureType, Type};
+
+/// One `MTLArgument` of an entry point.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ArgumentReflection {
+    pub name: String,
+    pub kind: ResourceKind,
+    pub index: u32,
+    pub count: u32,
+    pub access: Access,
+    /// `MTLTextureType` of a texture argument, else 0.
+    pub texture_type: u64,
+    /// `MTLDataType` of a texture argument's texels, else 0.
+    pub texture_data_type: u64,
+    /// The pointee of a buffer argument.
+    pub buffer: Option<ReflectedType>,
+}
+
+/// A buffer's data type as `MTLStructType` / `MTLArrayType` describe it.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum ReflectedType {
+    Data {
+        data_type: u64,
+        size: u32,
+        alignment: u32,
+    },
+    Struct {
+        size: u32,
+        alignment: u32,
+        members: Vec<ReflectedMember>,
+    },
+    Array {
+        element: Box<ReflectedType>,
+        count: u32,
+        stride: u32,
+    },
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ReflectedMember {
+    pub name: String,
+    pub offset: u32,
+    pub ty: ReflectedType,
+}
+
+impl ReflectedType {
+    /// Its `MTLDataType`: `Struct` is 1 and `Array` 2.
+    pub fn data_type(&self) -> u64 {
+        match self {
+            ReflectedType::Data { data_type, .. } => *data_type,
+            ReflectedType::Struct { .. } => 1,
+            ReflectedType::Array { .. } => 2,
+        }
+    }
+
+    pub fn size_alignment(&self) -> (u32, u32) {
+        match self {
+            ReflectedType::Data {
+                size, alignment, ..
+            }
+            | ReflectedType::Struct {
+                size, alignment, ..
+            } => (*size, *alignment),
+            ReflectedType::Array {
+                element,
+                count,
+                stride,
+            } => (stride * count, element.size_alignment().1),
+        }
+    }
+}
+
+pub(super) fn argument_reflection(
+    entry: &EntryPoint,
+    function: &Function,
+) -> Vec<ArgumentReflection> {
+    entry
+        .resources
+        .iter()
+        .filter_map(|resource| {
+            let parameter = function.parameters.get(resource.argument as usize)?;
+            let (texture_type, texture_data_type) = match &parameter.ty {
+                Type::Texture(texture) => (texture_type(texture), texel_data_type(texture)),
+                _ => (0, 0),
+            };
+            let buffer = match (&resource.kind, &parameter.ty) {
+                (ResourceKind::Buffer, Type::Pointer { pointee, .. }) => {
+                    Some(reflect_type(pointee, 0))
+                }
+                _ => None,
+            };
+            Some(ArgumentReflection {
+                name: parameter.name.clone(),
+                kind: resource.kind,
+                index: resource.index,
+                count: resource.count,
+                access: resource.access,
+                texture_type,
+                texture_data_type,
+                buffer,
+            })
+        })
+        .collect()
+}
+
+fn reflect_type(ty: &Type, depth: u32) -> ReflectedType {
+    match ty {
+        Type::Struct(structure) if depth < 16 => ReflectedType::Struct {
+            size: structure.size,
+            alignment: structure.alignment.max(1),
+            members: structure
+                .fields
+                .iter()
+                .enumerate()
+                .map(|(i, field)| ReflectedMember {
+                    name: field.name.clone().unwrap_or_else(|| format!("field{i}")),
+                    offset: field.offset,
+                    ty: reflect_type(&field.ty, depth + 1),
+                })
+                .collect(),
+        },
+        Type::Array { element, count } if depth < 16 => {
+            // The MSL frontend lowers float/half matrices as column arrays.
+            if (2..=4).contains(count)
+                && let Type::Vector {
+                    element: scalar,
+                    lanes,
+                } = element.as_ref()
+                && (2..=4).contains(lanes)
+                && matches!(scalar.as_ref(), Type::Float { bits: 16 | 32 })
+            {
+                let matrix = Type::Matrix {
+                    column: element.clone(),
+                    columns: *count as u8,
+                };
+                let (size, alignment) = data_layout(&matrix);
+                return ReflectedType::Data {
+                    data_type: data_type(&matrix),
+                    size,
+                    alignment,
+                };
+            }
+            let element = reflect_type(element, depth + 1);
+            let (size, alignment) = element.size_alignment();
+            ReflectedType::Array {
+                stride: size.next_multiple_of(alignment.max(1)),
+                count: *count,
+                element: Box::new(element),
+            }
+        }
+        other => {
+            let (size, alignment) = data_layout(other);
+            ReflectedType::Data {
+                data_type: data_type(other),
+                size,
+                alignment,
+            }
+        }
+    }
+}
+
+fn data_type(ty: &Type) -> u64 {
+    match ty {
+        Type::Matrix { column, columns } => {
+            let Type::Vector { element, lanes } = column.as_ref() else {
+                return 0;
+            };
+            let base = match element.as_ref() {
+                Type::Float { bits: 32 } => 7,
+                Type::Float { bits: 16 } => 20,
+                _ => return 0,
+            };
+            base + u64::from(columns.saturating_sub(2)) * 3 + u64::from(lanes.saturating_sub(2))
+        }
+        Type::Pointer { .. } => 60,
+        Type::Texture(_) => 58,
+        Type::Sampler => 59,
+        Type::Vector { element, .. } | Type::Array { element, .. } => {
+            let signed = matches!(element.as_ref(), Type::Int { signed: true, .. });
+            super::metal_data_type(ty, signed)
+        }
+        Type::Int { signed, .. } => super::metal_data_type(ty, *signed),
+        _ => super::metal_data_type(ty, false),
+    }
+}
+
+fn data_layout(ty: &Type) -> (u32, u32) {
+    match ty {
+        Type::Bool => (1, 1),
+        Type::Int { bits, .. } | Type::Float { bits } => {
+            let size = u32::from(*bits / 8).max(1);
+            (size, size)
+        }
+        Type::Vector { element, lanes } => {
+            let (scalar, _) = data_layout(element);
+            let size = scalar * u32::from(if *lanes == 3 { 4 } else { *lanes });
+            (size, size)
+        }
+        Type::Matrix { column, columns } => {
+            let (size, alignment) = data_layout(column);
+            (size * u32::from(*columns), alignment)
+        }
+        Type::Pointer { .. } => (8, 8),
+        Type::Struct(structure) => (structure.size, structure.alignment.max(1)),
+        _ => (0, 1),
+    }
+}
+
+fn texture_type(texture: &TextureType) -> u64 {
+    match (texture.dimension, texture.array, texture.multisampled) {
+        (TextureDimension::D1, false, _) => 0,
+        (TextureDimension::D1, true, _) => 1,
+        (TextureDimension::D2, false, false) => 2,
+        (TextureDimension::D2, true, false) => 3,
+        (TextureDimension::D2, false, true) => 4,
+        (TextureDimension::D2, true, true) => 8,
+        (TextureDimension::Cube, false, _) => 5,
+        (TextureDimension::Cube, true, _) => 6,
+        (TextureDimension::D3, ..) => 7,
+        (TextureDimension::Buffer, ..) => 9,
+    }
+}
+
+fn texel_data_type(texture: &TextureType) -> u64 {
+    match *texture.texel {
+        Type::Float { bits: 16 } => 16,
+        Type::Float { .. } => 3,
+        Type::Int { bits: 16, .. } => {
+            if texture.signed {
+                37
+            } else {
+                41
+            }
+        }
+        Type::Int { .. } => {
+            if texture.signed {
+                29
+            } else {
+                33
+            }
+        }
+        _ => 0,
+    }
+}
