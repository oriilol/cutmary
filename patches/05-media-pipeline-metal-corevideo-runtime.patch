+pub unsafe extern "C" fn vImageBuffer_Init(
+    buf: *mut vImage_Buffer,
+    height: usize,
+    width: usize,
+    pixelBits: u32,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if buf.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    if pixelBits == 0 {
+        return kvImageInvalidParameter;
+    }
+    let raw_row = (width.saturating_mul(pixelBits as usize)).div_ceil(8);
+    let row_bytes = (raw_row + 15) & !15;
+    unsafe {
+        (*buf).height = height;
+        (*buf).width = width;
+        (*buf).rowBytes = row_bytes;
+    }
+    if (flags & kvImageNoAllocate) != 0 {
+        unsafe { (*buf).data = ptr::null_mut() };
+        return 16; // recommended alignment
+    }
+    let total = row_bytes.saturating_mul(height).max(16);
+    let data = unsafe { libc::calloc(1, total) };
+    if data.is_null() {
+        return kvImageMemoryAllocationError;
+    }
+    unsafe { (*buf).data = data };
+    kvImageNoError
+}
