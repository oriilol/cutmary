+pub unsafe extern "C" fn vImageConvert_ARGBToYpCbCr_GenerateConversion(
+    matrix: *const vImage_ARGBToYpCbCrMatrix,
+    pixelRange: *const vImage_YpCbCrPixelRange,
+    outInfo: *mut c_void,
+    _inType: u32,
+    _outType: u32,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    if matrix.is_null() || pixelRange.is_null() || outInfo.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    let m = unsafe { *matrix };
+    let r = unsafe { *pixelRange };
+    let q = |f: f32| (f * 4096.0).round().clamp(i16::MIN as f32, i16::MAX as f32) as i16;
+    let info = ArgbToYuvInfo {
+        r_yp: q(m.R_Yp),
+        g_yp: q(m.G_Yp),
+        b_yp: q(m.B_Yp),
+        r_cb: q(m.R_Cb),
+        g_cb: q(m.G_Cb),
+        b_cb_r_cr: q(m.B_Cb_R_Cr),
+        g_cr: q(m.G_Cr),
+        b_cr: q(m.B_Cr),
+        yp_bias: r.Yp_bias as i16,
+        cbcr_bias: r.CbCr_bias as i16,
+        yp_scale: (r.YpRangeMax - r.Yp_bias).max(1) as i16,
+        cbcr_scale: ((r.CbCrRangeMax - r.CbCr_bias) * 2).max(1) as i16,
+        yp_min: r.YpMin.clamp(0, 255) as u8,
+        yp_max: r.YpMax.clamp(0, 255) as u8,
+        cbcr_min: r.CbCrMin.clamp(0, 255) as u8,
+        cbcr_max: r.CbCrMax.clamp(0, 255) as u8,
+        magic: MAGIC_ARGB_TO_YUV,
+    };
+    unsafe { ptr::write_unaligned(outInfo.cast::<ArgbToYuvInfo>(), info) };
+    kvImageNoError
+}
