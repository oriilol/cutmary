+fn write_reflected(payload: &mut Vec<u8>, ty: &ReflectedType) {
+    match ty {
+        ReflectedType::Data {
+            data_type,
+            size,
+            alignment,
+        } => {
+            payload.push(0);
+            payload.extend_from_slice(&data_type.to_le_bytes());
+            write_u32(payload, *size);
+            write_u32(payload, *alignment);
+        }
+        ReflectedType::Struct {
+            size,
+            alignment,
+            members,
+        } => {
+            payload.push(1);
+            write_u32(payload, *size);
+            write_u32(payload, *alignment);
+            write_u32(payload, members.len() as u32);
+            for member in members {
+                write_string(payload, &member.name);
+                write_u32(payload, member.offset);
+                write_reflected(payload, &member.ty);
+            }
+        }
+        ReflectedType::Array {
+            element,
+            count,
+            stride,
+        } => {
+            payload.push(2);
+            write_u32(payload, *count);
+            write_u32(payload, *stride);
+            write_reflected(payload, element);
+        }
+    }
+}
+
+fn read_reflected(reader: &mut Reader<'_>, depth: u32) -> Option<ReflectedType> {
+    if depth > 32 {
+        return None;
+    }
+    Some(match reader.u8()? {
+        0 => ReflectedType::Data {
+            data_type: reader.u64()?,
+            size: reader.u32()?,
+            alignment: reader.u32()?,
+        },
+        1 => {
+            let size = reader.u32()?;
+            let alignment = reader.u32()?;
+            let count = reader.u32()? as usize;
+            let mut members = Vec::with_capacity(count.min(256));
+            for _ in 0..count {
+                members.push(ReflectedMember {
+                    name: reader.string()?,
+                    offset: reader.u32()?,
+                    ty: read_reflected(reader, depth + 1)?,
+                });
+            }
+            ReflectedType::Struct {
+                size,
+                alignment,
+                members,
+            }
+        }
+        2 => {
+            let count = reader.u32()?;
+            let stride = reader.u32()?;
+            ReflectedType::Array {
+                element: Box::new(read_reflected(reader, depth + 1)?),
+                count,
+                stride,
+            }
+        }
+        _ => return None,
+    })
+}
