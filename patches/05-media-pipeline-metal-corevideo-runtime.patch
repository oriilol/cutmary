+/// Compact 32-byte representation stored inside `vImage_ARGBToYpCbCr` (Apple's
+/// opaque struct is 128 bytes; keeping our payload <= 32 bytes is extra safe).
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct ArgbToYuvInfo {
+    r_yp: i16,
+    g_yp: i16,
+    b_yp: i16,
+    r_cb: i16,
+    g_cb: i16,
+    b_cb_r_cr: i16,
+    g_cr: i16,
+    b_cr: i16,
+    yp_bias: i16,
+    cbcr_bias: i16,
+    yp_scale: i16,
+    cbcr_scale: i16,
+    yp_min: u8,
+    yp_max: u8,
+    cbcr_min: u8,
+    cbcr_max: u8,
+    magic: u32,
+}
+
+const _: () = assert!(std::mem::size_of::<ArgbToYuvInfo>() == 32);
+
+/// Compact 32-byte representation stored inside `vImage_YpCbCrToARGB`.
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct YuvToArgbInfo {
+    yp: f32,
+    cr_r: f32,
+    cr_g: f32,
+    cb_g: f32,
+    cb_b: f32,
+    yp_bias: i16,
+    cbcr_bias: i16,
+    yp_range: i16,
+    cbcr_range: i16,
+    magic: u32,
+}
+
+const _: () = assert!(std::mem::size_of::<YuvToArgbInfo>() == 32);
+
+const MAGIC_ARGB_TO_YUV: u32 = 0x5649_4159; // "VIAY"
+const MAGIC_YUV_TO_ARGB: u32 = 0x5649_5941; // "VIYA"
+
