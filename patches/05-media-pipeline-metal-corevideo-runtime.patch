+unsafe fn rotate90_impl<const BPP: usize>(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    rotationConstant: u8,
+    backColor: *const u8,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    let mut bg = [0u8; BPP];
+    if !backColor.is_null() {
+        unsafe { ptr::copy_nonoverlapping(backColor, bg.as_mut_ptr(), BPP) };
+    }
+    let rot = rotationConstant & 3;
+    let sw = s.width as isize;
+    let sh = s.height as isize;
+    let dw = d.width as isize;
+    let dh = d.height as isize;
+    let edge_extend = (flags & kvImageEdgeExtend) != 0;
+
+    // Center-aligned rotation per Apple vImageRotate90 spec:
+    // rot 0: 0 deg, rot 1: 90 CCW, rot 2: 180, rot 3: 90 CW (270 CCW)
+    for dy in 0..dh {
+        let dr = unsafe { row_ptr_mut(&d, dy as usize) };
+        for dx in 0..dw {
+            let (sx, sy) = match rot {
+                0 => (dx + (sw - dw) / 2, dy + (sh - dh) / 2),
+                1 => (
+                    (sw - 1) - (dy + (sw - dh) / 2),
+                    dx + (sh - dw) / 2,
+                ),
+                2 => (
+                    (sw - 1) - (dx + (sw - dw) / 2),
+                    (sh - 1) - (dy + (sh - dh) / 2),
+                ),
+                3 => (
+                    dy + (sw - dh) / 2,
+                    (sh - 1) - (dx + (sh - dw) / 2),
+                ),
+                _ => unreachable!(),
+            };
+            let dst_px = unsafe { dr.add(dx as usize * BPP) };
+            if sx >= 0 && sx < sw && sy >= 0 && sy < sh {
+                let sr = unsafe { row_ptr(&s, sy as usize) };
+                unsafe { ptr::copy_nonoverlapping(sr.add(sx as usize * BPP), dst_px, BPP) };
+            } else if edge_extend && sw > 0 && sh > 0 {
+                let csx = sx.clamp(0, sw - 1) as usize;
+                let csy = sy.clamp(0, sh - 1) as usize;
+                let sr = unsafe { row_ptr(&s, csy) };
+                unsafe { ptr::copy_nonoverlapping(sr.add(csx * BPP), dst_px, BPP) };
+            } else {
+                unsafe { ptr::copy_nonoverlapping(bg.as_ptr(), dst_px, BPP) };
+            }
+        }
+    }
+    kvImageNoError
+}
+
