+/// Pointer cells exported as the GOT data globals `const vImage_*Matrix * const kvImage_*`.
+pub fn data_symbols() -> Vec<(String, u64)> {
+    static PTRS: std::sync::OnceLock<Vec<(String, u64)>> = std::sync::OnceLock::new();
+    PTRS.get_or_init(|| {
+        let cell_a601: &'static usize =
+            Box::leak(Box::new(&MATRIX_ARGB_TO_YCBCR_601 as *const _ as usize));
+        let cell_a709: &'static usize =
+            Box::leak(Box::new(&MATRIX_ARGB_TO_YCBCR_709 as *const _ as usize));
+        let cell_y601: &'static usize =
+            Box::leak(Box::new(&MATRIX_YCBCR_TO_ARGB_601 as *const _ as usize));
+        let cell_y709: &'static usize =
+            Box::leak(Box::new(&MATRIX_YCBCR_TO_ARGB_709 as *const _ as usize));
+        vec![
+            (
+                "_kvImage_ARGBToYpCbCrMatrix_ITU_R_601_4".to_string(),
+                cell_a601 as *const usize as u64,
+            ),
+            (
+                "_kvImage_ARGBToYpCbCrMatrix_ITU_R_709_2".to_string(),
+                cell_a709 as *const usize as u64,
+            ),
+            (
+                "_kvImage_YpCbCrToARGBMatrix_ITU_R_601_4".to_string(),
+                cell_y601 as *const usize as u64,
+            ),
+            (
+                "_kvImage_YpCbCrToARGBMatrix_ITU_R_709_2".to_string(),
+                cell_y709 as *const usize as u64,
+            ),
+        ]
+    })
+    .clone()
+}
+
+#[inline]
+fn clamp_u8(v: f32) -> u8 {
+    v.round().clamp(0.0, 255.0) as u8
+}
+
+#[inline]
+fn clamp_u8_i32(v: i32) -> u8 {
+    v.clamp(0, 255) as u8
+}
+
+#[inline]
+fn premul_channel(c: u8, a: u8) -> u8 {
+    ((u16::from(c) * u16::from(a) + 127) / 255) as u8
+}
+
+#[inline]
+fn unpremul_channel(c: u8, a: u8) -> u8 {
+    if a == 0 {
+        0
+    } else if a == 255 {
+        c
+    } else {
+        ((u32::from(c) * 255 + u32::from(a) / 2) / u32::from(a)).min(255) as u8
+    }
+}
+
+#[inline]
+fn valid_buf(buf: *const vImage_Buffer) -> Option<vImage_Buffer> {
+    if buf.is_null() {
+        return None;
+    }
+    let b = unsafe { *buf };
+    if b.width == 0 || b.height == 0 {
+        return Some(b);
+    }
+    if b.data.is_null() {
+        return None;
+    }
+    Some(b)
+}
+
+#[inline]
+unsafe fn row_ptr(buf: &vImage_Buffer, y: usize) -> *const u8 {
+    unsafe { (buf.data as *const u8).add(y * buf.rowBytes) }
+}
+
+#[inline]
+unsafe fn row_ptr_mut(buf: &vImage_Buffer, y: usize) -> *mut u8 {
+    unsafe { (buf.data as *mut u8).add(y * buf.rowBytes) }
+}
+
+// ---------------------------------------------------------------------------
+// Channel permutation
+// ---------------------------------------------------------------------------
+
+pub unsafe extern "C" fn vImagePermuteChannels_ARGB8888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    permuteMap: *const u8,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if permuteMap.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    let map = unsafe {
+        [
+            (*permuteMap.add(0) & 3) as usize,
+            (*permuteMap.add(1) & 3) as usize,
+            (*permuteMap.add(2) & 3) as usize,
+            (*permuteMap.add(3) & 3) as usize,
+        ]
+    };
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..s.width {
+            let off = x * 4;
+            let px = unsafe {
+                [
+                    *sr.add(off),
+                    *sr.add(off + 1),
+                    *sr.add(off + 2),
+                    *sr.add(off + 3),
+                ]
+            };
+            unsafe {
+                *dr.add(off) = px[map[0]];
+                *dr.add(off + 1) = px[map[1]];
+                *dr.add(off + 2) = px[map[2]];
+                *dr.add(off + 3) = px[map[3]];
+            }
+        }
+    }
+    kvImageNoError
+}
+
+// ---------------------------------------------------------------------------
+// Scaling (bilinear)
+// ---------------------------------------------------------------------------
+
+pub unsafe extern "C" fn vImageScale_ARGB8888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _tempBuffer: *mut c_void,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width == 0 || s.height == 0 || d.width == 0 || d.height == 0 {
+        return kvImageNoError;
+    }
+    let sx_scale = s.width as f64 / d.width as f64;
+    let sy_scale = s.height as f64 / d.height as f64;
+    let max_sx = (s.width - 1) as f64;
+    let max_sy = (s.height - 1) as f64;
+    for dy in 0..d.height {
+        let fy = ((dy as f64 + 0.5) * sy_scale - 0.5).clamp(0.0, max_sy);
+        let y0 = fy.floor() as usize;
+        let y1 = (y0 + 1).min(s.height - 1);
+        let wy = fy - y0 as f64;
+        let r0 = unsafe { row_ptr(&s, y0) };
+        let r1 = unsafe { row_ptr(&s, y1) };
+        let dr = unsafe { row_ptr_mut(&d, dy) };
+        for dx in 0..d.width {
+            let fx = ((dx as f64 + 0.5) * sx_scale - 0.5).clamp(0.0, max_sx);
+            let x0 = fx.floor() as usize;
+            let x1 = (x0 + 1).min(s.width - 1);
+            let wx = fx - x0 as f64;
+            let w00 = (1.0 - wx) * (1.0 - wy);
+            let w10 = wx * (1.0 - wy);
+            let w01 = (1.0 - wx) * wy;
+            let w11 = wx * wy;
+            for c in 0..4 {
+                let p00 = unsafe { *r0.add(x0 * 4 + c) } as f64;
+                let p10 = unsafe { *r0.add(x1 * 4 + c) } as f64;
+                let p01 = unsafe { *r1.add(x0 * 4 + c) } as f64;
+                let p11 = unsafe { *r1.add(x1 * 4 + c) } as f64;
+                let v = (p00 * w00 + p10 * w10 + p01 * w01 + p11 * w11)
+                    .round()
+                    .clamp(0.0, 255.0) as u8;
+                unsafe { *dr.add(dx * 4 + c) = v };
+            }
+        }
+    }
+    kvImageNoError
+}
