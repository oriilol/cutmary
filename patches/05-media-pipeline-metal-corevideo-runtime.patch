+//! H.273 / ISO/IEC 23091-2 code points representable by CoreVideo attachment values.
+
+use super::{CFTypeRef, key};
+
+pub extern "C" fn CVColorPrimariesGetStringForIntegerCodePoint(code: i32) -> CFTypeRef {
+    key(match code {
+        1 => "ITU_R_709_2",
+        5 => "EBU_3213",
+        6 | 7 => "SMPTE_C",
+        9 => "ITU_R_2020",
+        11 => "DCI_P3",
+        12 => "P3_D65",
+        _ => return std::ptr::null(),
+    })
+}
+
+pub extern "C" fn CVTransferFunctionGetStringForIntegerCodePoint(code: i32) -> CFTypeRef {
+    key(match code {
+        1 | 6 => "ITU_R_709_2",
+        4 | 5 => "UseGamma",
+        7 => "SMPTE_240M_1995",
+        8 => "Linear",
+        13 => "sRGB",
+        14 | 15 => "ITU_R_2020",
+        16 => "SMPTE_ST_2084_PQ",
+        17 => "SMPTE_ST_428_1",
+        18 => "ITU_R_2100_HLG",
+        _ => return std::ptr::null(),
+    })
+}
+
+pub extern "C" fn CVYCbCrMatrixGetStringForIntegerCodePoint(code: i32) -> CFTypeRef {
+    key(match code {
+        1 => "ITU_R_709_2",
+        5 | 6 => "ITU_R_601_4",
+        7 => "SMPTE_240M_1995",
+        9 => "ITU_R_2020",
+        _ => return std::ptr::null(),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn code_points_return_borrowed_constants_in_their_own_domain() {
+        for (code, expected) in [(1, "ITU_R_709_2"), (9, "ITU_R_2020"), (12, "P3_D65")] {
+            assert_eq!(
+                CVColorPrimariesGetStringForIntegerCodePoint(code),
+                key(expected)
+            );
+        }
+        assert_eq!(
+            CVTransferFunctionGetStringForIntegerCodePoint(16),
+            key("SMPTE_ST_2084_PQ")
+        );
+        assert_eq!(
+            CVTransferFunctionGetStringForIntegerCodePoint(18),
+            key("ITU_R_2100_HLG")
+        );
+        assert_eq!(
+            CVYCbCrMatrixGetStringForIntegerCodePoint(6),
+            key("ITU_R_601_4")
+        );
+        for code in [-1, 2, 255] {
+            assert!(CVColorPrimariesGetStringForIntegerCodePoint(code).is_null());
+            assert!(CVTransferFunctionGetStringForIntegerCodePoint(code).is_null());
+            assert!(CVYCbCrMatrixGetStringForIntegerCodePoint(code).is_null());
+        }
+    }
+}
