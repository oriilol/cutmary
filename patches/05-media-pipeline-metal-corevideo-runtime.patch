+pub unsafe extern "C" fn vImageConvert_420Yp8_CbCr8ToARGB8888(
+    srcYp: *const vImage_Buffer,
+    srcCbCr: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    info: *const c_void,
+    permuteMap: *const u8,
+    alpha: u8,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(yp), Some(cbcr), Some(d)) =
+        (valid_buf(srcYp), valid_buf(srcCbCr), valid_buf(dest))
+    else {
+        return kvImageNullPointerArgument;
+    };
+    let conv = read_yuv_to_argb_info(info);
+    let map = read_permute_map(permuteMap);
+    let w = d.width.min(yp.width);
+    let h = d.height.min(yp.height);
+    for y in 0..h {
+        let yr = unsafe { row_ptr(&yp, y) };
+        let cy = (y / 2).min(cbcr.height.saturating_sub(1));
+        let uvr = unsafe { row_ptr(&cbcr, cy) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..w {
+            let cx = (x / 2).min(cbcr.width.saturating_sub(1));
+            let yv = unsafe { *yr.add(x) };
+            let cbv = unsafe { *uvr.add(cx * 2) };
+            let crv = unsafe { *uvr.add(cx * 2 + 1) };
+            let [r, g, b] = yuv_to_rgb_px(yv, cbv, crv, &conv);
+            let argb = [alpha, r, g, b];
+            unsafe {
+                *dr.add(x * 4) = argb[map[0]];
+                *dr.add(x * 4 + 1) = argb[map[1]];
+                *dr.add(x * 4 + 2) = argb[map[2]];
+                *dr.add(x * 4 + 3) = argb[map[3]];
+            }
+        }
+    }
