+/// `ROSEMARY_TRACE_SHADER_CACHE`: one line per miss - which input, how big,
+/// and whether translating it worked - so a key translated again and again,
+/// or a failure the caller never reports, shows up.
+fn trace_miss(
+    frontend: Frontend,
+    key: &[u8; 32],
+    len: usize,
+    library: &Result<TranslatedLibrary, TranslateError>,
+) {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*ON.get_or_init(|| std::env::var_os("ROSEMARY_TRACE_SHADER_CACHE").is_some()) {
+        return;
+    }
+    let key: String = key[..8].iter().map(|b| format!("{b:02x}")).collect();
+    match library {
+        Ok(_) => eprintln!(
+            "rosemary: shader cache: miss {key} frontend {} bytes {len} translated",
+            frontend.tag()
+        ),
+        Err(error) => eprintln!(
+            "rosemary: shader cache: miss {key} frontend {} bytes {len} failed: {}",
+            frontend.tag(),
+            error.to_string().lines().next().unwrap_or_default()
+        ),
+    }
+}
