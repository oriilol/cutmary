+/// MSL 5.2.1: a buffer, texture or sampler argument given no location takes
+/// the first index of its kind that no other argument of the function uses.
+fn implicit_locations(params: &[Param], index: impl Fn(&Expr) -> Result<u32>) -> Result<Vec<Param>> {
+    const LOCATED: [&str; 3] = ["buffer", "texture", "sampler"];
+    let kind = |param: &Param| match param.ty {
+        Ty::Texture(_) => Some(LOCATED[1]),
+        Ty::Sampler => Some(LOCATED[2]),
+        _ if param.indirection != Indirection::Value
+            && matches!(param.space, Some(Space::Constant | Space::Device)) =>
+        {
+            Some(LOCATED[0])
+        }
+        _ => None,
+    };
+    let mut used = Vec::new();
+    for attribute in params.iter().flat_map(|param| &param.attributes) {
+        if let Some(name) = LOCATED.iter().find(|name| **name == attribute.name)
+            && let [argument] = attribute.args.as_slice()
+        {
+            used.push((*name, index(argument)?));
+        }
+    }
+    let mut located = params.to_vec();
+    for param in &mut located {
+        let Some(kind) = kind(param).filter(|_| param.attributes.is_empty()) else {
+            continue;
+        };
+        let slot = (0..).find(|slot| !used.contains(&(kind, *slot))).unwrap_or(0);
+        used.push((kind, slot));
+        let value = Expr { kind: ExprKind::Int { value: u64::from(slot), unsigned: true }, line: param.line };
+        param.attributes.push(Attribute { name: kind.to_string(), args: vec![value], line: param.line });
+    }
+    Ok(located)
+}
