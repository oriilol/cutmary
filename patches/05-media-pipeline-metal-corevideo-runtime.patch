+    finish_converter(
+        Converter {
+            src: EndpointFormat::Cg(layout_from_cg_format(
+                sf.bitsPerComponent,
+                sf.bitsPerPixel,
+                sf.bitmapInfo,
+            )),
+            dst: EndpointFormat::Cg(layout_from_cg_format(
+                df.bitsPerComponent,
