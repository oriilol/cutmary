+//! `MTLRenderPipelineReflection` / `MTLComputePipelineReflection`, built from
+//! the translator's argument reflection. Engines such as AGFX treat a nil
+//! reflection as a failed pipeline and bind uniforms by struct member name.
+
+use corefoundation::base::CFTypeRef;
+use metal_translate::{ArgumentReflection, EntryArtifact, ReflectedType};
+use objc::object::Id;
+use objc::sel::Sel;
+
+use crate::object::{self, methods};
+
+struct Argument {
+    name: Id,
+    kind: u64,
+    access: u64,
+    index: u64,
+    array_length: u64,
+    texture_type: u64,
+    texture_data_type: u64,
+    data_type: u64,
+    size: u64,
+    alignment: u64,
+    struct_type: Id,
+    array_type: Id,
+}
+
+struct StructType {
+    members: Id,
+    list: Vec<Id>,
+}
+
+struct Member {
+    name: Id,
+    offset: u64,
+    data_type: u64,
+    struct_type: Id,
+    array_type: Id,
+}
+
+struct ArrayType {
+    element_type: u64,
+    length: u64,
+    stride: u64,
+    struct_type: Id,
+    array_type: Id,
+}
+
+struct Reflection {
+    first: Id,
+    second: Id,
+}
+
+fn array(items: &[Id]) -> Id {
+    let refs: Vec<CFTypeRef> = items.iter().map(|item| *item as CFTypeRef).collect();
+    corefoundation::collections::new_array(
+        &refs,
+        corefoundation::callbacks::Policy::from_type_callbacks(),
+        false,
+    ) as Id
+}
+
+/// The struct and array type objects (+1) a reflected type has, if any.
+fn nested(ty: &ReflectedType) -> (Id, Id) {
+    match ty {
+        ReflectedType::Data { .. } => (std::ptr::null_mut(), std::ptr::null_mut()),
+        ReflectedType::Struct { members, .. } => {
+            let list: Vec<Id> = members
+                .iter()
+                .map(|member| {
+                    let (struct_type, array_type) = nested(&member.ty);
+                    object::make(
+                        c"RosemaryMTLStructMember",
+                        Member {
+                            name: foundation::string::from_str(&member.name),
+                            offset: u64::from(member.offset),
+                            data_type: member.ty.data_type(),
+                            struct_type,
+                            array_type,
+                        },
+                    )
+                })
+                .collect();
+            let members = array(&list);
+            (
+                object::make(c"RosemaryMTLStructType", StructType { members, list }),
+                std::ptr::null_mut(),
+            )
+        }
+        ReflectedType::Array {
+            element,
+            count,
+            stride,
+        } => {
+            let (struct_type, array_type) = nested(element);
+            (
+                std::ptr::null_mut(),
+                object::make(
+                    c"RosemaryMTLArrayType",
+                    ArrayType {
+                        element_type: element.data_type(),
+                        length: u64::from(*count),
+                        stride: u64::from(*stride),
+                        struct_type,
+                        array_type,
+                    },
+                ),
+            )
+        }
+    }
+}
+
+fn argument(reflected: &ArgumentReflection) -> Id {
+    use metal_translate::ir::{Access, ResourceKind};
+    let kind = match reflected.kind {
+        ResourceKind::Texture => 2,
+        ResourceKind::Sampler => 3,
+        _ => 0,
+    };
+    let access = match reflected.access {
+        Access::ReadWrite => 1,
+        Access::Write => 2,
+        _ => 0,
+    };
+    let (data_type, size, alignment, struct_type, array_type) = match &reflected.buffer {
+        Some(ty) => {
+            let (size, alignment) = ty.size_alignment();
+            let (struct_type, array_type) = nested(ty);
+            (ty.data_type(), size, alignment, struct_type, array_type)
+        }
+        None => (0, 0, 0, std::ptr::null_mut(), std::ptr::null_mut()),
+    };
+    object::make(
+        c"RosemaryMTLArgument",
+        Argument {
+            name: foundation::string::from_str(&reflected.name),
+            kind,
+            access,
+            index: u64::from(reflected.index),
+            array_length: u64::from(reflected.count.max(1)),
+            texture_type: reflected.texture_type,
+            texture_data_type: reflected.texture_data_type,
+            data_type,
+            size: u64::from(size),
+            alignment: u64::from(alignment),
+            struct_type,
+            array_type,
+        },
+    )
+}
+
+/// A +1 `NSArray` of `MTLArgument`s for an entry point (empty without one).
+fn arguments(artifact: Option<&EntryArtifact>) -> Id {
+    let list: Vec<Id> = artifact
+        .map(|artifact| artifact.arguments.iter().map(argument).collect())
+        .unwrap_or_default();
+    let result = array(&list);
+    for item in list {
+        objc::arc::release(item);
+    }
+    result
+}
+
+/// An autoreleased `MTLRenderPipelineReflection`.
+pub(crate) fn render(vertex: Option<&EntryArtifact>, fragment: Option<&EntryArtifact>) -> Id {
+    let reflection = object::make(
+        c"RosemaryMTLRenderPipelineReflection",
+        Reflection {
+            first: arguments(vertex),
+            second: arguments(fragment),
+        },
+    );
+    objc::arc::autorelease(reflection)
+}
+
+/// An autoreleased `MTLComputePipelineReflection`.
+pub(crate) fn compute(kernel: Option<&EntryArtifact>) -> Id {
+    let reflection = object::make(
+        c"RosemaryMTLComputePipelineReflection",
+        Reflection {
+            first: arguments(kernel),
+            second: std::ptr::null_mut(),
+        },
+    );
+    objc::arc::autorelease(reflection)
+}
+
+macro_rules! getter {
+    ($name:ident, $body:ty, $field:ident, $ret:ty) => {
+        unsafe extern "C" fn $name(receiver: Id, _sel: Sel) -> $ret {
+            // SAFETY: registered on the class whose body this is.
+            unsafe { object::body_ref::<$body>(receiver) }.$field
+        }
+    };
+}
+
+getter!(argument_name, Argument, name, Id);
+getter!(argument_type, Argument, kind, u64);
+getter!(argument_access, Argument, access, u64);
+getter!(argument_index, Argument, index, u64);
+getter!(argument_array_length, Argument, array_length, u64);
+getter!(argument_texture_type, Argument, texture_type, u64);
+getter!(argument_texture_data_type, Argument, texture_data_type, u64);
+getter!(argument_data_type, Argument, data_type, u64);
+getter!(argument_size, Argument, size, u64);
+getter!(argument_alignment, Argument, alignment, u64);
+getter!(argument_struct, Argument, struct_type, Id);
+getter!(struct_members, StructType, members, Id);
+getter!(member_name, Member, name, Id);
+getter!(member_offset, Member, offset, u64);
+getter!(member_data_type, Member, data_type, u64);
+getter!(member_struct, Member, struct_type, Id);
+getter!(member_array, Member, array_type, Id);
+getter!(array_element_type, ArrayType, element_type, u64);
+getter!(array_length, ArrayType, length, u64);
+getter!(array_stride, ArrayType, stride, u64);
+getter!(array_struct, ArrayType, struct_type, Id);
+getter!(array_array, ArrayType, array_type, Id);
+getter!(reflection_first, Reflection, first, Id);
+getter!(reflection_second, Reflection, second, Id);
+
+unsafe extern "C" fn yes(_receiver: Id, _sel: Sel) -> bool {
+    true
+}
+
+unsafe extern "C" fn no(_receiver: Id, _sel: Sel) -> bool {
+    false
+}
+
+unsafe extern "C" fn zero(_receiver: Id, _sel: Sel) -> u64 {
+    0
+}
+
+unsafe extern "C" fn struct_data_type(_receiver: Id, _sel: Sel) -> u64 {
+    1
+}
+
+unsafe extern "C" fn array_data_type(_receiver: Id, _sel: Sel) -> u64 {
+    2
+}
+
+unsafe extern "C" fn member_by_name(receiver: Id, _sel: Sel, name: Id) -> Id {
+    // SAFETY: an `RosemaryMTLStructType`.
+    let body = unsafe { object::body_ref::<StructType>(receiver) };
+    body.list
+        .iter()
+        .copied()
+        .find(|member| {
+            // SAFETY: a member of this crate's; both are strings.
+            let own = unsafe { object::body_ref::<Member>(*member) }.name;
+            !name.is_null()
+                && unsafe { corefoundation::api::CFEqual(own as CFTypeRef, name as CFTypeRef) } != 0
+        })
+        .unwrap_or(std::ptr::null_mut())
+}
+
+fn release_all(ids: &[Id]) {
+    for id in ids {
+        if !id.is_null() {
+            objc::arc::release(*id);
+        }
+    }
+}
+
+unsafe extern "C" fn argument_dealloc(receiver: Id, _sel: Sel) {
+    // SAFETY: an `RosemaryMTLArgument`, which owns these references.
+    let body = unsafe { object::body_ref::<Argument>(receiver) };
+    release_all(&[body.name, body.struct_type, body.array_type]);
+    objc::arc::finalize(receiver);
+}
+
+unsafe extern "C" fn struct_dealloc(receiver: Id, _sel: Sel) {
+    // SAFETY: an `RosemaryMTLStructType`; the list's references are the
+    // array's own after construction, so only the array and the Vec go.
+    let body = unsafe { object::body::<StructType>(receiver) };
+    release_all(&body.list);
+    release_all(&[body.members]);
+    // SAFETY: the body is dropped exactly once, before the object is freed.
+    unsafe { std::ptr::drop_in_place(body) };
+    objc::arc::finalize(receiver);
+}
+
+unsafe extern "C" fn member_dealloc(receiver: Id, _sel: Sel) {
+    // SAFETY: an `RosemaryMTLStructMember`.
+    let body = unsafe { object::body_ref::<Member>(receiver) };
+    release_all(&[body.name, body.struct_type, body.array_type]);
+    objc::arc::finalize(receiver);
+}
+
+unsafe extern "C" fn array_dealloc(receiver: Id, _sel: Sel) {
+    // SAFETY: an `RosemaryMTLArrayType`.
+    let body = unsafe { object::body_ref::<ArrayType>(receiver) };
+    release_all(&[body.struct_type, body.array_type]);
+    objc::arc::finalize(receiver);
+}
+
+unsafe extern "C" fn reflection_dealloc(receiver: Id, _sel: Sel) {
+    // SAFETY: a pipeline reflection of this crate's.
+    let body = unsafe { object::body_ref::<Reflection>(receiver) };
+    release_all(&[body.first, body.second]);
+    objc::arc::finalize(receiver);
+}
+
+pub(crate) fn install() {
