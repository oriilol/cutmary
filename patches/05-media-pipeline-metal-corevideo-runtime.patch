+    } else {
+        unsafe {
+            [
+                *backColor.add(0),
+                *backColor.add(1),
+                *backColor.add(2),
+                *backColor.add(3),
+            ]
+        }
+    };
+    unsafe { affine_warp_impl::<4>(src, dest, transform, bg, flags) }
+}
