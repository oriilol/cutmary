+pub unsafe extern "C" fn vImageConvert_AnyToAny(
+    converter: *const c_void,
+    srcs: *const vImage_Buffer,
+    dests: *const vImage_Buffer,
+    _tempBuffer: *mut c_void,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    if converter.is_null() || srcs.is_null() || dests.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    let conv = unsafe { &*converter.cast::<Converter>() };
+    let src_layout = match conv.src {
+        EndpointFormat::Cg(l) => Some(l),
+        EndpointFormat::Cv(f) => cv_to_pixel_layout(f),
+    };
+    let dst_layout = match conv.dst {
+        EndpointFormat::Cg(l) => Some(l),
+        EndpointFormat::Cv(f) => cv_to_pixel_layout(f),
+    };
+
+    match (conv.src, conv.dst) {
+        (EndpointFormat::Cv(FOURCC_420V | FOURCC_420F), EndpointFormat::Cg(dl)) => {
+            let (Some(yp), Some(cbcr), Some(d)) = (
+                valid_buf(srcs),
+                valid_buf(unsafe { srcs.add(1) }),
+                valid_buf(dests),
+            ) else {
+                return kvImageNullPointerArgument;
+            };
+            let info = read_yuv_to_argb_info(ptr::null());
+            let w = d.width.min(yp.width);
+            let h = d.height.min(yp.height);
+            for y in 0..h {
+                let yr = unsafe { row_ptr(&yp, y) };
+                let uvr = unsafe { row_ptr(&cbcr, (y / 2).min(cbcr.height.saturating_sub(1))) };
+                let dr = unsafe { row_ptr_mut(&d, y) };
+                for x in 0..w {
+                    let cx = (x / 2).min(cbcr.width.saturating_sub(1));
+                    let [r, g, b] = yuv_to_rgb_px(
+                        unsafe { *yr.add(x) },
+                        unsafe { *uvr.add(cx * 2) },
+                        unsafe { *uvr.add(cx * 2 + 1) },
+                        &info,
+                    );
+                    unsafe { write_rgba(dr, x, [r, g, b, 255], dl) };
+                }
+            }
+            kvImageNoError
+        }
+        (EndpointFormat::Cg(sl), EndpointFormat::Cv(FOURCC_420V | FOURCC_420F)) => {
+            let (Some(s), Some(yp), Some(cbcr)) = (
+                valid_buf(srcs),
+                valid_buf(dests),
+                valid_buf(unsafe { dests.add(1) }),
+            ) else {
+                return kvImageNullPointerArgument;
+            };
+            let info = read_argb_to_yuv_info(ptr::null());
+            let w = s.width.min(yp.width);
+            let h = s.height.min(yp.height);
+            for y in 0..h {
+                let sr = unsafe { row_ptr(&s, y) };
+                let yr = unsafe { row_ptr_mut(&yp, y) };
+                let uvr = if y / 2 < cbcr.height {
+                    Some(unsafe { row_ptr_mut(&cbcr, y / 2) })
+                } else {
+                    None
+                };
+                for x in 0..w {
+                    let [r, g, b, _] = unsafe { read_rgba(sr, x, sl) };
+                    let [yv, cbv, crv] = rgb_to_yuv_px(r, g, b, &info);
+                    unsafe { *yr.add(x) = yv };
+                    if (y & 1) == 0
+                        && (x & 1) == 0
+                        && let Some(p) = uvr
+                        && x / 2 < cbcr.width
+                    {
+                        unsafe {
+                            *p.add(x) = cbv;
+                            *p.add(x + 1) = crv;
+                        }
+                    }
+                }
+            }
+            kvImageNoError
+        }
+        _ => {
+            let (Some(sl), Some(dl)) = (src_layout, dst_layout) else {
+                return kvImageInvalidParameter;
+            };
+            let (Some(s), Some(d)) = (valid_buf(srcs), valid_buf(dests)) else {
+                return kvImageNullPointerArgument;
+            };
+            let w = s.width.min(d.width);
+            let h = s.height.min(d.height);
+            for y in 0..h {
+                let sr = unsafe { row_ptr(&s, y) };
+                let dr = unsafe { row_ptr_mut(&d, y) };
+                for x in 0..w {
+                    let rgba = unsafe { read_rgba(sr, x, sl) };
+                    unsafe { write_rgba(dr, x, rgba, dl) };
+                }
+            }
+            kvImageNoError
+        }
+    }
+}
+
+pub unsafe extern "C" fn vImageBuffer_InitWithCVPixelBuffer(
+    buf: *mut vImage_Buffer,
+    desiredFormat: *mut vImage_CGImageFormat,
+    cvPixelBuffer: CFTypeRef,
+    _cvImageFormat: *const c_void,
+    _backgroundColor: *const f64,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if buf.is_null() || desiredFormat.is_null() || cvPixelBuffer.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    let w = unsafe { corevideo::pixel_buffer::CVPixelBufferGetWidth(cvPixelBuffer) };
+    let h = unsafe { corevideo::pixel_buffer::CVPixelBufferGetHeight(cvPixelBuffer) };
+    let fourcc = unsafe { corevideo::pixel_buffer::CVPixelBufferGetPixelFormatType(cvPixelBuffer) };
+    let fmt = unsafe { &mut *desiredFormat };
+    if fmt.bitsPerComponent == 0 {
+        fmt.bitsPerComponent = 8;
+    }
+    if fmt.bitsPerPixel == 0 {
+        fmt.bitsPerPixel = 32;
+    }
+    let err = unsafe { vImageBuffer_Init(buf, h, w, fmt.bitsPerPixel, flags) };
+    if err != kvImageNoError || (flags & kvImageNoAllocate) != 0 {
+        return err;
+    }
+    let dl = layout_from_cg_format(fmt.bitsPerComponent, fmt.bitsPerPixel, fmt.bitmapInfo);
+    unsafe { corevideo::pixel_buffer::CVPixelBufferLockBaseAddress(cvPixelBuffer, 1) };
+    let d = unsafe { *buf };
+    if matches!(fourcc, FOURCC_420V | FOURCC_420F) {
+        let yp = vImage_Buffer {
+            data: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBaseAddressOfPlane(cvPixelBuffer, 0)
+            },
+            width: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetWidthOfPlane(cvPixelBuffer, 0)
+            },
+            height: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetHeightOfPlane(cvPixelBuffer, 0)
+            },
+            rowBytes: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBytesPerRowOfPlane(cvPixelBuffer, 0)
+            },
+        };
+        let cbcr = vImage_Buffer {
+            data: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBaseAddressOfPlane(cvPixelBuffer, 1)
+            },
+            width: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetWidthOfPlane(cvPixelBuffer, 1)
+            },
+            height: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetHeightOfPlane(cvPixelBuffer, 1)
+            },
+            rowBytes: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBytesPerRowOfPlane(cvPixelBuffer, 1)
+            },
+        };
+        if !yp.data.is_null() && !cbcr.data.is_null() {
+            let info = read_yuv_to_argb_info(ptr::null());
+            for y in 0..h {
+                let yr = unsafe { row_ptr(&yp, y) };
+                let uvr = unsafe { row_ptr(&cbcr, (y / 2).min(cbcr.height.saturating_sub(1))) };
+                let dr = unsafe { row_ptr_mut(&d, y) };
+                for x in 0..w {
+                    let cx = (x / 2).min(cbcr.width.saturating_sub(1));
+                    let [r, g, b] = yuv_to_rgb_px(
+                        unsafe { *yr.add(x) },
+                        unsafe { *uvr.add(cx * 2) },
+                        unsafe { *uvr.add(cx * 2 + 1) },
+                        &info,
+                    );
+                    unsafe { write_rgba(dr, x, [r, g, b, 255], dl) };
+                }
+            }
+        }
+    } else if matches!(fourcc, FOURCC_Y420 | FOURCC_F420) {
+        let yp = vImage_Buffer {
+            data: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBaseAddressOfPlane(cvPixelBuffer, 0)
+            },
+            width: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetWidthOfPlane(cvPixelBuffer, 0)
+            },
+            height: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetHeightOfPlane(cvPixelBuffer, 0)
+            },
+            rowBytes: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBytesPerRowOfPlane(cvPixelBuffer, 0)
+            },
+        };
+        let cb = vImage_Buffer {
+            data: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBaseAddressOfPlane(cvPixelBuffer, 1)
+            },
+            width: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetWidthOfPlane(cvPixelBuffer, 1)
+            },
+            height: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetHeightOfPlane(cvPixelBuffer, 1)
+            },
+            rowBytes: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBytesPerRowOfPlane(cvPixelBuffer, 1)
+            },
+        };
+        let cr = vImage_Buffer {
+            data: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBaseAddressOfPlane(cvPixelBuffer, 2)
+            },
+            width: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetWidthOfPlane(cvPixelBuffer, 2)
+            },
+            height: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetHeightOfPlane(cvPixelBuffer, 2)
+            },
+            rowBytes: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBytesPerRowOfPlane(cvPixelBuffer, 2)
+            },
+        };
+        if !yp.data.is_null() && !cb.data.is_null() && !cr.data.is_null() {
+            let info = read_yuv_to_argb_info(ptr::null());
+            for y in 0..h {
+                let yr = unsafe { row_ptr(&yp, y) };
+                let cy = (y / 2).min(cb.height.saturating_sub(1));
+                let cbr = unsafe { row_ptr(&cb, cy) };
+                let crr = unsafe { row_ptr(&cr, cy.min(cr.height.saturating_sub(1))) };
+                let dr = unsafe { row_ptr_mut(&d, y) };
+                for x in 0..w {
+                    let cx = (x / 2).min(cb.width.saturating_sub(1));
+                    let [r, g, b] = yuv_to_rgb_px(
+                        unsafe { *yr.add(x) },
+                        unsafe { *cbr.add(cx) },
+                        unsafe { *crr.add(cx.min(cr.width.saturating_sub(1))) },
+                        &info,
+                    );
+                    unsafe { write_rgba(dr, x, [r, g, b, 255], dl) };
+                }
+            }
+        }
+    } else if let Some(sl) = cv_to_pixel_layout(fourcc) {
+        let base = unsafe { corevideo::pixel_buffer::CVPixelBufferGetBaseAddress(cvPixelBuffer) };
+        let bpr = unsafe { corevideo::pixel_buffer::CVPixelBufferGetBytesPerRow(cvPixelBuffer) };
+        if !base.is_null() {
+            let s = vImage_Buffer {
+                data: base,
+                width: w,
+                height: h,
+                rowBytes: bpr,
+            };
+            for y in 0..h {
+                let sr = unsafe { row_ptr(&s, y) };
+                let dr = unsafe { row_ptr_mut(&d, y) };
+                for x in 0..w {
+                    let rgba = unsafe { read_rgba(sr, x, sl) };
+                    unsafe { write_rgba(dr, x, rgba, dl) };
+                }
+            }
+        }
+    }
+    unsafe { corevideo::pixel_buffer::CVPixelBufferUnlockBaseAddress(cvPixelBuffer, 1) };
+    kvImageNoError
+}
+
+pub unsafe extern "C" fn vImageBuffer_CopyToCVPixelBuffer(
+    src: *const vImage_Buffer,
+    srcFormat: *const vImage_CGImageFormat,
+    cvPixelBuffer: CFTypeRef,
+    _cvImageFormat: *const c_void,
+    _backgroundColor: *const f64,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let Some(s) = valid_buf(src) else {
+        return kvImageNullPointerArgument;
+    };
+    if srcFormat.is_null() || cvPixelBuffer.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    let sf = unsafe { *srcFormat };
+    let sl = layout_from_cg_format(sf.bitsPerComponent, sf.bitsPerPixel, sf.bitmapInfo);
+    let w = s
+        .width
+        .min(unsafe { corevideo::pixel_buffer::CVPixelBufferGetWidth(cvPixelBuffer) });
+    let h = s
+        .height
+        .min(unsafe { corevideo::pixel_buffer::CVPixelBufferGetHeight(cvPixelBuffer) });
+    let fourcc = unsafe { corevideo::pixel_buffer::CVPixelBufferGetPixelFormatType(cvPixelBuffer) };
+    unsafe { corevideo::pixel_buffer::CVPixelBufferLockBaseAddress(cvPixelBuffer, 0) };
+    if matches!(fourcc, FOURCC_420V | FOURCC_420F) {
+        let yp = vImage_Buffer {
+            data: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBaseAddressOfPlane(cvPixelBuffer, 0)
+            },
+            width: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetWidthOfPlane(cvPixelBuffer, 0)
+            },
+            height: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetHeightOfPlane(cvPixelBuffer, 0)
+            },
+            rowBytes: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBytesPerRowOfPlane(cvPixelBuffer, 0)
+            },
+        };
+        let cbcr = vImage_Buffer {
+            data: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBaseAddressOfPlane(cvPixelBuffer, 1)
+            },
+            width: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetWidthOfPlane(cvPixelBuffer, 1)
+            },
+            height: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetHeightOfPlane(cvPixelBuffer, 1)
+            },
+            rowBytes: unsafe {
+                corevideo::pixel_buffer::CVPixelBufferGetBytesPerRowOfPlane(cvPixelBuffer, 1)
+            },
+        };
+        if !yp.data.is_null() && !cbcr.data.is_null() {
+            let info = read_argb_to_yuv_info(ptr::null());
+            for y in 0..h {
+                let sr = unsafe { row_ptr(&s, y) };
+                let yr = unsafe { row_ptr_mut(&yp, y) };
+                let uvr = if y / 2 < cbcr.height {
+                    Some(unsafe { row_ptr_mut(&cbcr, y / 2) })
+                } else {
+                    None
+                };
+                for x in 0..w {
+                    let [r, g, b, _] = unsafe { read_rgba(sr, x, sl) };
+                    let [yv, cbv, crv] = rgb_to_yuv_px(r, g, b, &info);
+                    unsafe { *yr.add(x) = yv };
+                    if (y & 1) == 0
+                        && (x & 1) == 0
+                        && let Some(p) = uvr
+                        && x / 2 < cbcr.width
+                    {
+                        unsafe {
+                            *p.add(x) = cbv;
+                            *p.add(x + 1) = crv;
+                        }
+                    }
+                }
+            }
+        }
+    } else if let Some(dl) = cv_to_pixel_layout(fourcc) {
+        let base = unsafe { corevideo::pixel_buffer::CVPixelBufferGetBaseAddress(cvPixelBuffer) };
+        let bpr = unsafe { corevideo::pixel_buffer::CVPixelBufferGetBytesPerRow(cvPixelBuffer) };
+        if !base.is_null() {
+            let d = vImage_Buffer {
+                data: base,
+                width: w,
+                height: h,
+                rowBytes: bpr,
+            };
+            for y in 0..h {
+                let sr = unsafe { row_ptr(&s, y) };
+                let dr = unsafe { row_ptr_mut(&d, y) };
+                for x in 0..w {
+                    let rgba = unsafe { read_rgba(sr, x, sl) };
+                    unsafe { write_rgba(dr, x, rgba, dl) };
+                }
+            }
+        }
+    }
+    unsafe { corevideo::pixel_buffer::CVPixelBufferUnlockBaseAddress(cvPixelBuffer, 0) };
+    kvImageNoError
+}
+
+// ---------------------------------------------------------------------------
+// vDSP vector operations
+// ---------------------------------------------------------------------------
+
+pub unsafe extern "C" fn vDSP_vsmul(
+    a: *const f32,
+    ia: isize,
+    b: *const f32,
+    c: *mut f32,
+    ic: isize,
+    n: usize,
+) {
+    if a.is_null() || b.is_null() || c.is_null() || n == 0 {
+        return;
+    }
+    let scale = unsafe { *b };
+    for i in 0..n as isize {
+        let v = unsafe { *a.offset(i * ia) } * scale;
+        unsafe { *c.offset(i * ic) = v };
+    }
+}
+
+pub unsafe extern "C" fn vDSP_vasm(
+    a: *const f32,
+    ia: isize,
+    b: *const f32,
+    ib: isize,
+    c: *const f32,
+    d: *mut f32,
+    id: isize,
+    n: usize,
+) {
+    if a.is_null() || b.is_null() || c.is_null() || d.is_null() || n == 0 {
+        return;
+    }
+    let scale = unsafe { *c };
+    for i in 0..n as isize {
+        let v = (unsafe { *a.offset(i * ia) } + unsafe { *b.offset(i * ib) }) * scale;
+        unsafe { *d.offset(i * id) = v };
+    }
+}
