+pub unsafe extern "C" fn vImageMatrixMultiply_ARGB8888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    matrix: *const i16,
+    divisor: i32,
+    pre_bias: *const i16,
+    post_bias: *const i32,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if matrix.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    let div = if divisor == 0 { 1 } else { divisor } as i64;
+    let mut m = [0i64; 16];
+    for (i, slot) in m.iter_mut().enumerate() {
+        *slot = i64::from(unsafe { *matrix.add(i) });
+    }
+    let pre = if pre_bias.is_null() {
+        [0i64; 4]
+    } else {
+        unsafe {
+            [
+                i64::from(*pre_bias.add(0)),
+                i64::from(*pre_bias.add(1)),
+                i64::from(*pre_bias.add(2)),
+                i64::from(*pre_bias.add(3)),
+            ]
+        }
+    };
+    let post = if post_bias.is_null() {
+        [0i64; 4]
+    } else {
+        unsafe {
+            [
+                i64::from(*post_bias.add(0)),
+                i64::from(*post_bias.add(1)),
+                i64::from(*post_bias.add(2)),
+                i64::from(*post_bias.add(3)),
+            ]
+        }
+    };
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..s.width {
+            let off = x * 4;
+            let p = unsafe {
+                [
+                    i64::from(*sr.add(off)) + pre[0],
+                    i64::from(*sr.add(off + 1)) + pre[1],
+                    i64::from(*sr.add(off + 2)) + pre[2],
+                    i64::from(*sr.add(off + 3)) + pre[3],
+                ]
+            };
+            // vImage matrix is column-major: dest[col] = sum_row(src[row] * matrix[row*4 + col])
+            let mut out = [0u8; 4];
+            for col in 0..4 {
+                let sum = p[0] * m[col]
+                    + p[1] * m[4 + col]
+                    + p[2] * m[8 + col]
+                    + p[3] * m[12 + col]
+                    + post[col];
+                out[col] = (sum / div).clamp(0, 255) as u8;
+            }
+            unsafe { ptr::copy_nonoverlapping(out.as_ptr(), dr.add(off), 4) };
+        }
+    }
+    kvImageNoError
+}
+
+pub unsafe extern "C" fn vImageMatrixMultiply_ARGB8888ToPlanar8(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    matrix: *const i16,
+    divisor: i32,
+    pre_bias: *const i16,
+    post_bias: i32,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if matrix.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    let div = if divisor == 0 { 1 } else { divisor } as i64;
+    let m = unsafe {
+        [
+            i64::from(*matrix.add(0)),
+            i64::from(*matrix.add(1)),
+            i64::from(*matrix.add(2)),
+            i64::from(*matrix.add(3)),
+        ]
+    };
+    let pre = if pre_bias.is_null() {
+        [0i64; 4]
+    } else {
+        unsafe {
+            [
+                i64::from(*pre_bias.add(0)),
+                i64::from(*pre_bias.add(1)),
+                i64::from(*pre_bias.add(2)),
+                i64::from(*pre_bias.add(3)),
+            ]
+        }
+    };
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..s.width {
+            let off = x * 4;
+            let sum = (i64::from(unsafe { *sr.add(off) }) + pre[0]) * m[0]
+                + (i64::from(unsafe { *sr.add(off + 1) }) + pre[1]) * m[1]
+                + (i64::from(unsafe { *sr.add(off + 2) }) + pre[2]) * m[2]
+                + (i64::from(unsafe { *sr.add(off + 3) }) + pre[3]) * m[3]
+                + i64::from(post_bias);
+            unsafe { *dr.add(x) = (sum / div).clamp(0, 255) as u8 };
+        }
+    }
+    kvImageNoError
+}
