+pub unsafe extern "C" fn vImageConvolve_ARGB8888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _tempBuffer: *mut c_void,
+    srcOffsetToROI_X: usize,
+    srcOffsetToROI_Y: usize,
+    kernel: *const i16,
+    kernel_height: u32,
+    kernel_width: u32,
+    divisor: i32,
+    backgroundColor: *const u8,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if kernel.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    let kw = kernel_width as isize;
+    let kh = kernel_height as isize;
+    if kw <= 0 || kh <= 0 {
+        return kvImageInvalidKernelSize;
+    }
+    let div = if divisor == 0 {
+        let mut sum: i32 = 0;
+        for i in 0..(kw * kh) as usize {
+            sum += i32::from(unsafe { *kernel.add(i) });
+        }
+        if sum == 0 { 1 } else { sum }
+    } else {
+        divisor
+    };
+    let bg = if backgroundColor.is_null() {
+        [0u8; 4]
+    } else {
+        unsafe {
+            [
+                *backgroundColor.add(0),
+                *backgroundColor.add(1),
+                *backgroundColor.add(2),
+                *backgroundColor.add(3),
+            ]
+        }
+    };
+    let edge = (flags & kvImageEdgeExtend) != 0 || backgroundColor.is_null();
+    let leave_alpha = (flags & kvImageLeaveAlphaUnchanged) != 0;
+    let sw = s.width as isize;
+    let sh = s.height as isize;
+    let half_w = kw / 2;
+    let half_h = kh / 2;
+
+    for dy in 0..d.height {
+        let dr = unsafe { row_ptr_mut(&d, dy) };
+        let cy = dy as isize + srcOffsetToROI_Y as isize;
+        for dx in 0..d.width {
+            let cx = dx as isize + srcOffsetToROI_X as isize;
+            let mut acc = [0i64; 4];
+            for ky in 0..kh {
+                let sy = cy + ky - half_h;
+                for kx in 0..kw {
+                    let sx = cx + kx - half_w;
+                    let k = i64::from(unsafe { *kernel.add((ky * kw + kx) as usize) });
+                    let px = if sx >= 0 && sx < sw && sy >= 0 && sy < sh {
+                        let sr = unsafe { row_ptr(&s, sy as usize) };
+                        let off = sx as usize * 4;
+                        unsafe {
+                            [
+                                *sr.add(off),
+                                *sr.add(off + 1),
+                                *sr.add(off + 2),
+                                *sr.add(off + 3),
+                            ]
+                        }
+                    } else if edge && sw > 0 && sh > 0 {
+                        let csx = sx.clamp(0, sw - 1) as usize;
+                        let csy = sy.clamp(0, sh - 1) as usize;
+                        let sr = unsafe { row_ptr(&s, csy) };
+                        let off = csx * 4;
+                        unsafe {
+                            [
+                                *sr.add(off),
+                                *sr.add(off + 1),
+                                *sr.add(off + 2),
+                                *sr.add(off + 3),
+                            ]
+                        }
+                    } else {
+                        bg
+                    };
+                    for c in 0..4 {
+                        acc[c] += i64::from(px[c]) * k;
+                    }
+                }
+            }
+            let off = dx * 4;
+            for c in 0..4 {
+                if leave_alpha && c == 0 {
+                    let csx = cx.clamp(0, sw.saturating_sub(1)) as usize;
+                    let csy = cy.clamp(0, sh.saturating_sub(1)) as usize;
+                    let sr = unsafe { row_ptr(&s, csy) };
+                    unsafe { *dr.add(off) = *sr.add(csx * 4) };
+                } else {
+                    let v = (acc[c] / i64::from(div)).clamp(0, 255) as u8;
+                    unsafe { *dr.add(off + c) = v };
+                }
+            }
+        }
+    }
+    kvImageNoError
+}
+
+unsafe fn morph_minmax_impl(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    srcOffsetToROI_X: usize,
+    srcOffsetToROI_Y: usize,
+    kernel: *const u8,
+    kernel_height: u32,
+    kernel_width: u32,
+    flags: vImage_Flags,
+    is_max: bool,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    let kw = kernel_width as isize;
+    let kh = kernel_height as isize;
+    if kw <= 0 || kh <= 0 {
+        return kvImageInvalidKernelSize;
+    }
+    let sw = s.width as isize;
+    let sh = s.height as isize;
+    let half_w = kw / 2;
+    let half_h = kh / 2;
+    let leave_alpha = (flags & kvImageLeaveAlphaUnchanged) != 0;
+
+    for dy in 0..d.height {
+        let dr = unsafe { row_ptr_mut(&d, dy) };
+        let cy = dy as isize + srcOffsetToROI_Y as isize;
+        for dx in 0..d.width {
+            let cx = dx as isize + srcOffsetToROI_X as isize;
+            let mut best = if is_max { [0i32; 4] } else { [255i32; 4] };
+            for ky in 0..kh {
+                let sy = (cy + ky - half_h).clamp(0, sh.saturating_sub(1)) as usize;
+                let sr = unsafe { row_ptr(&s, sy) };
+                for kx in 0..kw {
+                    let sx = (cx + kx - half_w).clamp(0, sw.saturating_sub(1)) as usize;
+                    let kval = if kernel.is_null() {
+                        0i32
+                    } else {
+                        i32::from(unsafe { *kernel.add((ky * kw + kx) as usize) })
+                    };
+                    let off = sx * 4;
+                    for c in 0..4 {
+                        let sv = i32::from(unsafe { *sr.add(off + c) });
+                        if is_max {
+                            best[c] = best[c].max(sv - kval);
+                        } else {
+                            best[c] = best[c].min(sv + kval);
+                        }
+                    }
+                }
+            }
+            let off = dx * 4;
+            for c in 0..4 {
+                if leave_alpha && c == 0 {
+                    let csx = cx.clamp(0, sw.saturating_sub(1)) as usize;
+                    let csy = cy.clamp(0, sh.saturating_sub(1)) as usize;
+                    let sr = unsafe { row_ptr(&s, csy) };
+                    unsafe { *dr.add(off) = *sr.add(csx * 4) };
+                } else {
+                    unsafe { *dr.add(off + c) = clamp_u8_i32(best[c]) };
+                }
+            }
+        }
+    }
+    kvImageNoError
+}
