+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct vImage_ARGBToYpCbCrMatrix {
+    pub R_Yp: f32,
+    pub G_Yp: f32,
+    pub B_Yp: f32,
+    pub R_Cb: f32,
+    pub G_Cb: f32,
+    pub B_Cb_R_Cr: f32,
+    pub G_Cr: f32,
+    pub B_Cr: f32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
