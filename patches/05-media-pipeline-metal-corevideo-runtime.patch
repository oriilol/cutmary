+pub unsafe extern "C" fn vImageConvert_ARGB8888To422CbYpCrYp8(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    info: *const c_void,
+    permuteMap: *const u8,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    let conv = read_argb_to_yuv_info(info);
+    let map = read_permute_map(permuteMap);
+    let w = s.width.min(d.width);
+    let h = s.height.min(d.height);
+    for y in 0..h {
+        let sr = unsafe { row_ptr(&s, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        let mut x = 0;
+        while x + 1 < w {
+            let raw0 = unsafe {
+                [
+                    *sr.add(x * 4),
+                    *sr.add(x * 4 + 1),
+                    *sr.add(x * 4 + 2),
+                    *sr.add(x * 4 + 3),
+                ]
+            };
+            let raw1 = unsafe {
+                [
+                    *sr.add((x + 1) * 4),
+                    *sr.add((x + 1) * 4 + 1),
+                    *sr.add((x + 1) * 4 + 2),
+                    *sr.add((x + 1) * 4 + 3),
+                ]
+            };
+            let [y0, cb0, cr0] = rgb_to_yuv_px(raw0[map[1]], raw0[map[2]], raw0[map[3]], &conv);
+            let [y1, cb1, cr1] = rgb_to_yuv_px(raw1[map[1]], raw1[map[2]], raw1[map[3]], &conv);
+            let cb = ((u16::from(cb0) + u16::from(cb1)) / 2) as u8;
+            let cr = ((u16::from(cr0) + u16::from(cr1)) / 2) as u8;
+            // UYVY (2vuy): Cb, Y0, Cr, Y1
+            unsafe {
+                *dr.add(x * 2) = cb;
+                *dr.add(x * 2 + 1) = y0;
+                *dr.add(x * 2 + 2) = cr;
+                *dr.add(x * 2 + 3) = y1;
+            }
+            x += 2;
+        }
+    }
+    kvImageNoError
+}
