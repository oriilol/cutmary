+//! Accelerate framework (`vImage` and `vDSP`) implementation for Rosemary.
+//!
+//! Covers the pixel-conversion, channel-permutation, scaling, rotation,
+//! reflection, affine-warp, YpCbCr, alpha-blending, convolution/morphology,
+//! CGImage/CVPixelBuffer interop, and vector math entry points used by macOS
+//! media editors (including CapCut's `libcccreator`, `libVECreator`,
+//! `libvideoeditor`, and `libEffectSDK`).
+
+#![allow(non_snake_case, non_camel_case_types, non_upper_case_globals)]
+#![allow(clippy::missing_safety_doc)]
+
+use std::ffi::c_void;
+use std::ptr;
+
+use corefoundation::base::CFTypeRef;
+
+pub type vImage_Error = isize;
+pub type vImage_Flags = u32;
+
+pub const kvImageNoError: vImage_Error = 0;
+pub const kvImageRoiLargerThanInputBuffer: vImage_Error = -21766;
+pub const kvImageInvalidKernelSize: vImage_Error = -21767;
+pub const kvImageInvalidEdgeStyle: vImage_Error = -21768;
+pub const kvImageInvalidOffset_X: vImage_Error = -21769;
+pub const kvImageInvalidOffset_Y: vImage_Error = -21770;
+pub const kvImageMemoryAllocationError: vImage_Error = -21771;
+pub const kvImageNullPointerArgument: vImage_Error = -21772;
+pub const kvImageInvalidParameter: vImage_Error = -21773;
+pub const kvImageBufferSizeMismatch: vImage_Error = -21774;
+pub const kvImageUnknownFlagsBit: vImage_Error = -21775;
+
+pub const kvImageNoFlags: vImage_Flags = 0;
+pub const kvImageLeaveAlphaUnchanged: vImage_Flags = 1;
+pub const kvImageCopyInPlace: vImage_Flags = 2;
+pub const kvImageBackgroundColorFill: vImage_Flags = 4;
+pub const kvImageEdgeExtend: vImage_Flags = 8;
+pub const kvImageDoNotTile: vImage_Flags = 16;
+pub const kvImageHighQualityResampling: vImage_Flags = 32;
+pub const kvImageTruncateKernel: vImage_Flags = 64;
+pub const kvImageGetTempBufferSize: vImage_Flags = 128;
+pub const kvImageNoAllocate: vImage_Flags = 512;
+
+// Wait: verify kvImageGetTempBufferSize and kvImageNoAllocate flag bits from
+// Apple's <vImage/vImage_Types.h>:
+//   kvImageNoFlags                = 0
+//   kvImageLeaveAlphaUnchanged    = 1
+//   kvImageCopyInPlace            = 2
+//   kvImageBackgroundColorFill    = 4
+//   kvImageEdgeExtend             = 8
+//   kvImageDoNotTile              = 16
+//   kvImageHighQualityResampling  = 32
+//   kvImageTruncateKernel         = 64
+//   kvImageGetTempBufferSize      = 128
+//   kvImagePrintDiagnosticsToConsole = 256
+//   kvImageNoAllocate             = 512
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct vImage_Buffer {
+    pub data: *mut c_void,
+    pub height: usize,
+    pub width: usize,
+    pub rowBytes: usize,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct vImage_CGImageFormat {
+    pub bitsPerComponent: u32,
+    pub bitsPerPixel: u32,
+    pub colorSpace: CFTypeRef,
+    pub bitmapInfo: u32,
+    pub version: u32,
+    pub decode: *const f64,
+    pub renderingIntent: i32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct vImage_CGAffineTransform {
+    pub a: f64,
+    pub b: f64,
+    pub c: f64,
+    pub d: f64,
+    pub tx: f64,
+    pub ty: f64,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct vImage_ARGBToYpCbCrMatrix {
+    pub R_Yp: f32,
+    pub G_Yp: f32,
+    pub B_Yp: f32,
+    pub R_Cb: f32,
+    pub G_Cb: f32,
+    pub B_Cb_R_Cr: f32,
+    pub G_Cr: f32,
+    pub B_Cr: f32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct vImage_YpCbCrToARGBMatrix {
+    pub Yp: f32,
+    pub Cr_R: f32,
+    pub Cr_G: f32,
+    pub Cb_G: f32,
+    pub Cb_B: f32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct vImage_YpCbCrPixelRange {
+    pub Yp_bias: i32,
+    pub CbCr_bias: i32,
+    pub YpRangeMax: i32,
+    pub CbCrRangeMax: i32,
+    pub YpMax: i32,
+    pub YpMin: i32,
+    pub CbCrMax: i32,
+    pub CbCrMin: i32,
+}
+
+/// Compact 32-byte representation stored inside `vImage_ARGBToYpCbCr` (Apple's
+/// opaque struct is 128 bytes; keeping our payload <= 32 bytes is extra safe).
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct ArgbToYuvInfo {
+    r_yp: i16,
+    g_yp: i16,
+    b_yp: i16,
+    r_cb: i16,
+    g_cb: i16,
+    b_cb_r_cr: i16,
+    g_cr: i16,
+    b_cr: i16,
+    yp_bias: i16,
+    cbcr_bias: i16,
+    yp_scale: i16,
+    cbcr_scale: i16,
+    yp_min: u8,
+    yp_max: u8,
+    cbcr_min: u8,
+    cbcr_max: u8,
+    magic: u32,
+}
+
+const _: () = assert!(std::mem::size_of::<ArgbToYuvInfo>() == 32);
+
+/// Compact 32-byte representation stored inside `vImage_YpCbCrToARGB`.
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct YuvToArgbInfo {
+    yp: f32,
+    cr_r: f32,
+    cr_g: f32,
+    cb_g: f32,
+    cb_b: f32,
+    yp_bias: i16,
+    cbcr_bias: i16,
+    yp_range: i16,
+    cbcr_range: i16,
+    magic: u32,
+}
+
+const _: () = assert!(std::mem::size_of::<YuvToArgbInfo>() == 32);
+
+const MAGIC_ARGB_TO_YUV: u32 = 0x5649_4159; // "VIAY"
+const MAGIC_YUV_TO_ARGB: u32 = 0x5649_5941; // "VIYA"
+
+static MATRIX_ARGB_TO_YCBCR_601: vImage_ARGBToYpCbCrMatrix = vImage_ARGBToYpCbCrMatrix {
+    R_Yp: 0.299,
+    G_Yp: 0.587,
+    B_Yp: 0.114,
+    R_Cb: -0.168736,
+    G_Cb: -0.331264,
+    B_Cb_R_Cr: 0.5,
+    G_Cr: -0.418688,
+    B_Cr: -0.081312,
+};
+
+static MATRIX_ARGB_TO_YCBCR_709: vImage_ARGBToYpCbCrMatrix = vImage_ARGBToYpCbCrMatrix {
+    R_Yp: 0.2126,
+    G_Yp: 0.7152,
+    B_Yp: 0.0722,
+    R_Cb: -0.114572,
+    G_Cb: -0.385428,
+    B_Cb_R_Cr: 0.5,
+    G_Cr: -0.454153,
+    B_Cr: -0.045847,
+};
+
+static MATRIX_YCBCR_TO_ARGB_601: vImage_YpCbCrToARGBMatrix = vImage_YpCbCrToARGBMatrix {
+    Yp: 1.0,
+    Cr_R: 1.402,
+    Cr_G: -0.714136,
+    Cb_G: -0.344136,
+    Cb_B: 1.772,
+};
+
+static MATRIX_YCBCR_TO_ARGB_709: vImage_YpCbCrToARGBMatrix = vImage_YpCbCrToARGBMatrix {
+    Yp: 1.0,
+    Cr_R: 1.5748,
+    Cr_G: -0.468124,
+    Cb_G: -0.187324,
+    Cb_B: 1.8556,
+};
+
+/// Pointer cells exported as the GOT data globals `const vImage_*Matrix * const kvImage_*`.
+pub fn data_symbols() -> Vec<(String, u64)> {
+    static PTRS: std::sync::OnceLock<Vec<(String, u64)>> = std::sync::OnceLock::new();
+    PTRS.get_or_init(|| {
+        let cell_a601: &'static usize =
+            Box::leak(Box::new(&MATRIX_ARGB_TO_YCBCR_601 as *const _ as usize));
+        let cell_a709: &'static usize =
+            Box::leak(Box::new(&MATRIX_ARGB_TO_YCBCR_709 as *const _ as usize));
+        let cell_y601: &'static usize =
+            Box::leak(Box::new(&MATRIX_YCBCR_TO_ARGB_601 as *const _ as usize));
+        let cell_y709: &'static usize =
+            Box::leak(Box::new(&MATRIX_YCBCR_TO_ARGB_709 as *const _ as usize));
+        vec![
+            (
+                "_kvImage_ARGBToYpCbCrMatrix_ITU_R_601_4".to_string(),
+                cell_a601 as *const usize as u64,
+            ),
+            (
+                "_kvImage_ARGBToYpCbCrMatrix_ITU_R_709_2".to_string(),
+                cell_a709 as *const usize as u64,
+            ),
+            (
+                "_kvImage_YpCbCrToARGBMatrix_ITU_R_601_4".to_string(),
+                cell_y601 as *const usize as u64,
+            ),
+            (
+                "_kvImage_YpCbCrToARGBMatrix_ITU_R_709_2".to_string(),
+                cell_y709 as *const usize as u64,
+            ),
+        ]
+    })
+    .clone()
+}
+
+#[inline]
+fn clamp_u8(v: f32) -> u8 {
+    v.round().clamp(0.0, 255.0) as u8
+}
+
+#[inline]
+fn clamp_u8_i32(v: i32) -> u8 {
+    v.clamp(0, 255) as u8
+}
+
+#[inline]
+fn premul_channel(c: u8, a: u8) -> u8 {
+    ((u16::from(c) * u16::from(a) + 127) / 255) as u8
+}
+
+#[inline]
+fn unpremul_channel(c: u8, a: u8) -> u8 {
+    if a == 0 {
+        0
+    } else if a == 255 {
+        c
+    } else {
+        ((u32::from(c) * 255 + u32::from(a) / 2) / u32::from(a)).min(255) as u8
+    }
+}
+
+#[inline]
+fn valid_buf(buf: *const vImage_Buffer) -> Option<vImage_Buffer> {
+    if buf.is_null() {
+        return None;
+    }
+    let b = unsafe { *buf };
+    if b.width == 0 || b.height == 0 {
+        return Some(b);
+    }
+    if b.data.is_null() {
+        return None;
+    }
+    Some(b)
+}
+
+#[inline]
+unsafe fn row_ptr(buf: &vImage_Buffer, y: usize) -> *const u8 {
+    unsafe { (buf.data as *const u8).add(y * buf.rowBytes) }
+}
+
+#[inline]
+unsafe fn row_ptr_mut(buf: &vImage_Buffer, y: usize) -> *mut u8 {
+    unsafe { (buf.data as *mut u8).add(y * buf.rowBytes) }
+}
+
+// ---------------------------------------------------------------------------
+// Channel permutation
+// ---------------------------------------------------------------------------
+
+pub unsafe extern "C" fn vImagePermuteChannels_ARGB8888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    permuteMap: *const u8,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if permuteMap.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    let map = unsafe {
+        [
+            (*permuteMap.add(0) & 3) as usize,
+            (*permuteMap.add(1) & 3) as usize,
+            (*permuteMap.add(2) & 3) as usize,
+            (*permuteMap.add(3) & 3) as usize,
+        ]
+    };
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..s.width {
+            let off = x * 4;
+            let px = unsafe {
+                [
+                    *sr.add(off),
+                    *sr.add(off + 1),
+                    *sr.add(off + 2),
+                    *sr.add(off + 3),
+                ]
+            };
+            unsafe {
+                *dr.add(off) = px[map[0]];
+                *dr.add(off + 1) = px[map[1]];
+                *dr.add(off + 2) = px[map[2]];
+                *dr.add(off + 3) = px[map[3]];
+            }
+        }
+    }
+    kvImageNoError
+}
+
+// ---------------------------------------------------------------------------
+// Scaling (bilinear)
+// ---------------------------------------------------------------------------
+
+pub unsafe extern "C" fn vImageScale_ARGB8888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _tempBuffer: *mut c_void,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width == 0 || s.height == 0 || d.width == 0 || d.height == 0 {
+        return kvImageNoError;
+    }
+    let sx_scale = s.width as f64 / d.width as f64;
+    let sy_scale = s.height as f64 / d.height as f64;
+    let max_sx = (s.width - 1) as f64;
+    let max_sy = (s.height - 1) as f64;
+    for dy in 0..d.height {
+        let fy = ((dy as f64 + 0.5) * sy_scale - 0.5).clamp(0.0, max_sy);
+        let y0 = fy.floor() as usize;
+        let y1 = (y0 + 1).min(s.height - 1);
+        let wy = fy - y0 as f64;
+        let r0 = unsafe { row_ptr(&s, y0) };
+        let r1 = unsafe { row_ptr(&s, y1) };
+        let dr = unsafe { row_ptr_mut(&d, dy) };
+        for dx in 0..d.width {
+            let fx = ((dx as f64 + 0.5) * sx_scale - 0.5).clamp(0.0, max_sx);
+            let x0 = fx.floor() as usize;
+            let x1 = (x0 + 1).min(s.width - 1);
+            let wx = fx - x0 as f64;
+            let w00 = (1.0 - wx) * (1.0 - wy);
+            let w10 = wx * (1.0 - wy);
+            let w01 = (1.0 - wx) * wy;
+            let w11 = wx * wy;
+            for c in 0..4 {
+                let p00 = unsafe { *r0.add(x0 * 4 + c) } as f64;
+                let p10 = unsafe { *r0.add(x1 * 4 + c) } as f64;
+                let p01 = unsafe { *r1.add(x0 * 4 + c) } as f64;
+                let p11 = unsafe { *r1.add(x1 * 4 + c) } as f64;
+                let v = (p00 * w00 + p10 * w10 + p01 * w01 + p11 * w11)
+                    .round()
+                    .clamp(0.0, 255.0) as u8;
+                unsafe { *dr.add(dx * 4 + c) = v };
+            }
+        }
+    }
+    kvImageNoError
+}
+
+pub unsafe extern "C" fn vImageScale_Planar8(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _tempBuffer: *mut c_void,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width == 0 || s.height == 0 || d.width == 0 || d.height == 0 {
+        return kvImageNoError;
+    }
+    let sx_scale = s.width as f64 / d.width as f64;
+    let sy_scale = s.height as f64 / d.height as f64;
+    let max_sx = (s.width - 1) as f64;
+    let max_sy = (s.height - 1) as f64;
+    for dy in 0..d.height {
+        let fy = ((dy as f64 + 0.5) * sy_scale - 0.5).clamp(0.0, max_sy);
+        let y0 = fy.floor() as usize;
+        let y1 = (y0 + 1).min(s.height - 1);
+        let wy = fy - y0 as f64;
+        let r0 = unsafe { row_ptr(&s, y0) };
+        let r1 = unsafe { row_ptr(&s, y1) };
+        let dr = unsafe { row_ptr_mut(&d, dy) };
+        for dx in 0..d.width {
+            let fx = ((dx as f64 + 0.5) * sx_scale - 0.5).clamp(0.0, max_sx);
+            let x0 = fx.floor() as usize;
+            let x1 = (x0 + 1).min(s.width - 1);
+            let wx = fx - x0 as f64;
+            let p00 = unsafe { *r0.add(x0) } as f64;
+            let p10 = unsafe { *r0.add(x1) } as f64;
+            let p01 = unsafe { *r1.add(x0) } as f64;
+            let p11 = unsafe { *r1.add(x1) } as f64;
+            let v = (p00 * (1.0 - wx) * (1.0 - wy)
+                + p10 * wx * (1.0 - wy)
+                + p01 * (1.0 - wx) * wy
+                + p11 * wx * wy)
+                .round()
+                .clamp(0.0, 255.0) as u8;
+            unsafe { *dr.add(dx) = v };
+        }
+    }
+    kvImageNoError
+}
