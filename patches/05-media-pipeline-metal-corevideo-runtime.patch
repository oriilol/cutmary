+pub unsafe extern "C" fn vImageScale_Planar8(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _tempBuffer: *mut c_void,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width == 0 || s.height == 0 || d.width == 0 || d.height == 0 {
+        return kvImageNoError;
+    }
+    let sx_scale = s.width as f64 / d.width as f64;
+    let sy_scale = s.height as f64 / d.height as f64;
+    let max_sx = (s.width - 1) as f64;
+    let max_sy = (s.height - 1) as f64;
+    for dy in 0..d.height {
+        let fy = ((dy as f64 + 0.5) * sy_scale - 0.5).clamp(0.0, max_sy);
+        let y0 = fy.floor() as usize;
+        let y1 = (y0 + 1).min(s.height - 1);
+        let wy = fy - y0 as f64;
+        let r0 = unsafe { row_ptr(&s, y0) };
+        let r1 = unsafe { row_ptr(&s, y1) };
+        let dr = unsafe { row_ptr_mut(&d, dy) };
+        for dx in 0..d.width {
+            let fx = ((dx as f64 + 0.5) * sx_scale - 0.5).clamp(0.0, max_sx);
+            let x0 = fx.floor() as usize;
+            let x1 = (x0 + 1).min(s.width - 1);
+            let wx = fx - x0 as f64;
+            let p00 = unsafe { *r0.add(x0) } as f64;
+            let p10 = unsafe { *r0.add(x1) } as f64;
+            let p01 = unsafe { *r1.add(x0) } as f64;
+            let p11 = unsafe { *r1.add(x1) } as f64;
+            let v = (p00 * (1.0 - wx) * (1.0 - wy)
+                + p10 * wx * (1.0 - wy)
+                + p01 * (1.0 - wx) * wy
+                + p11 * wx * wy)
+                .round()
+                .clamp(0.0, 255.0) as u8;
+            unsafe { *dr.add(dx) = v };
+        }
+    }
+    kvImageNoError
+}
