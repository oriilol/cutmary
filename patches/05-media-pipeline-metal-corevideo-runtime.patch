+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn bgra_buffer(width: usize, height: usize) -> CFTypeRef {
+        let mut buffer = std::ptr::null();
+        // SAFETY: a fresh buffer of a supported format, written to `buffer`.
+        let made = unsafe {
+            super::super::CVPixelBufferCreate(
+                std::ptr::null(),
+                width,
+                height,
+                BGRA,
+                std::ptr::null(),
+                &mut buffer,
+            )
+        };
+        assert_eq!(made, SUCCESS);
+        buffer
+    }
+
+    #[test]
+    fn metal_cache_validates_its_arguments() {
+        let mut cache = 1 as CFTypeRef;
+        // SAFETY: a writable out-parameter and a nil device.
+        assert_eq!(
+            unsafe {
+                CVMetalTextureCacheCreate(
+                    std::ptr::null(),
+                    std::ptr::null(),
+                    std::ptr::null_mut(),
+                    std::ptr::null(),
+                    &mut cache,
+                )
+            },
+            INVALID_ARGUMENT
+        );
+        assert!(cache.is_null(), "the out-parameter is cleared on failure");
+        let buffer = bgra_buffer(4, 4);
+        let mut texture = 1 as CFTypeRef;
+        // SAFETY: a null cache and a live buffer.
+        let result = unsafe {
+            CVMetalTextureCacheCreateTextureFromImage(
+                std::ptr::null(),
+                std::ptr::null(),
+                buffer,
+                std::ptr::null(),
+                80,
+                4,
+                4,
+                0,
+                &mut texture,
+            )
+        };
+        assert_eq!(result, INVALID_ARGUMENT);
+        assert!(texture.is_null());
+        // SAFETY: a texture-less lookup on null answers null.
+        assert!(unsafe { CVMetalTextureGetTexture(std::ptr::null()) }.is_null());
+        unsafe { super::super::CVPixelBufferRelease(buffer) };
+    }
+
+    #[test]
+    fn gl_cache_refuses_formats_one_texture_cannot_hold() {
+        assert_eq!(
+            gl_upload_format(BGRA),
+            Some((GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV))
+        );
+        assert_eq!(
+            gl_upload_format(ARGB),
+            Some((GL_BGRA, GL_UNSIGNED_INT_8_8_8_8))
+        );
+        assert_eq!(gl_upload_format(RGBA), Some((GL_RGBA, GL_UNSIGNED_BYTE)));
+        assert_eq!(gl_upload_format(super::super::NV12_VIDEO), None);
+
+        let mut cache = std::ptr::null();
+        // SAFETY: a non-null stand-in context; the cache does not dereference it.
+        assert_eq!(
+            unsafe {
+                CVOpenGLTextureCacheCreate(
+                    std::ptr::null(),
+                    std::ptr::null(),
+                    1 as *mut c_void,
+                    std::ptr::null_mut(),
+                    std::ptr::null(),
+                    &mut cache,
+                )
+            },
+            SUCCESS
+        );
+        let mut nv12 = std::ptr::null();
+        // SAFETY: a fresh NV12 buffer.
+        assert_eq!(
+            unsafe {
+                super::super::CVPixelBufferCreate(
+                    std::ptr::null(),
+                    4,
+                    4,
+                    super::super::NV12_VIDEO,
+                    std::ptr::null(),
+                    &mut nv12,
+                )
+            },
+            SUCCESS
+        );
+        let mut texture = 1 as CFTypeRef;
+        // SAFETY: a live cache and buffer.
+        let result = unsafe {
+            CVOpenGLTextureCacheCreateTextureFromImage(
+                std::ptr::null(),
+                cache,
+                nv12,
+                std::ptr::null(),
+                &mut texture,
+            )
+        };
+        assert_eq!(result, NOT_OPENGL_COMPATIBLE);
+        assert!(texture.is_null());
+        assert_eq!(unsafe { CVOpenGLTextureGetName(std::ptr::null()) }, 0);
+        assert_eq!(
+            unsafe { CVOpenGLTextureGetTarget(cache) },
+            0,
+            "a cache is not a texture"
+        );
+        unsafe {
+            super::super::CVPixelBufferRelease(nv12);
+            CVOpenGLTextureCacheRelease(cache);
+        }
+    }
+
+    #[test]
+    fn locks_the_requested_plane_of_a_planar_buffer() {
+        let mut nv12 = std::ptr::null();
+        // SAFETY: a fresh 8x6 NV12 buffer.
+        assert_eq!(
+            unsafe {
+                super::super::CVPixelBufferCreate(
+                    std::ptr::null(),
+                    8,
+                    6,
+                    super::super::NV12_VIDEO,
+                    std::ptr::null(),
+                    &mut nv12,
+                )
+            },
+            SUCCESS
+        );
+        let luma = lock_plane(nv12, 0).expect("luma plane");
+        assert_eq!((luma.width, luma.height), (8, 6));
+        unlock(nv12);
+        let chroma = lock_plane(nv12, 1).expect("chroma plane");
+        assert_eq!((chroma.width, chroma.height), (4, 3));
+        assert!(chroma.bytes_per_row >= 8, "two bytes per CbCr pair");
+        unlock(nv12);
+        assert!(lock_plane(nv12, 2).is_none(), "NV12 has two planes");
+        let bgra = bgra_buffer(2, 2);
+        assert!(lock_plane(bgra, 0).is_some());
+        unlock(bgra);
+        assert!(lock_plane(bgra, 1).is_none());
+        unsafe {
+            super::super::CVPixelBufferRelease(nv12);
+            super::super::CVPixelBufferRelease(bgra);
+        }
+    }
+}
