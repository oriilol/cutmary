+unsafe fn reflect_h<const BPP: usize>(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    let mut row_tmp = vec![0u8; s.width * BPP];
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..s.width {
+            let src_x = s.width - 1 - x;
+            unsafe {
+                ptr::copy_nonoverlapping(
+                    sr.add(src_x * BPP),
+                    row_tmp.as_mut_ptr().add(x * BPP),
+                    BPP,
+                );
+            }
+        }
+        unsafe { ptr::copy_nonoverlapping(row_tmp.as_ptr(), dr, s.width * BPP) };
+    }
+    kvImageNoError
+}
+
+unsafe fn reflect_v<const BPP: usize>(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    let row_len = s.width * BPP;
+    if s.data == d.data {
+        let mut tmp = vec![0u8; row_len];
+        for y in 0..s.height / 2 {
+            let y2 = s.height - 1 - y;
+            let r1 = unsafe { row_ptr_mut(&d, y) };
+            let r2 = unsafe { row_ptr_mut(&d, y2) };
+            unsafe {
+                ptr::copy_nonoverlapping(r1, tmp.as_mut_ptr(), row_len);
+                ptr::copy_nonoverlapping(r2, r1, row_len);
+                ptr::copy_nonoverlapping(tmp.as_ptr(), r2, row_len);
+            }
+        }
+    } else {
+        for y in 0..s.height {
+            let sr = unsafe { row_ptr(&s, s.height - 1 - y) };
+            let dr = unsafe { row_ptr_mut(&d, y) };
+            unsafe { ptr::copy_nonoverlapping(sr, dr, row_len) };
+        }
+    }
+    kvImageNoError
+}
