+        cr_g: m.Cr_G,
+        cb_g: m.Cb_G,
+        cb_b: m.Cb_B,
+        yp_bias: r.Yp_bias as i16,
+        cbcr_bias: r.CbCr_bias as i16,
+        yp_range: (r.YpRangeMax - r.Yp_bias).max(1) as i16,
+        cbcr_range: ((r.CbCrRangeMax - r.CbCr_bias) * 2).max(1) as i16,
