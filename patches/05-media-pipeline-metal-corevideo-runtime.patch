+pub unsafe extern "C" fn vImageConvert_ARGB16UToARGB8888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) as *const u16 };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for i in 0..(s.width * 4) {
+            let v16 = unsafe { *sr.add(i) };
+            let v8 = ((u32::from(v16) * 255 + 32768) / 65535).min(255) as u8;
+            unsafe { *dr.add(i) = v8 };
+        }
+    }
+    kvImageNoError
+}
+
+pub unsafe extern "C" fn vImageConvert_Planar16FtoPlanar8(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) as *const u16 };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..s.width {
+            let f = half::f16::from_bits(unsafe { *sr.add(x) }).to_f32();
+            let v = (f * 255.0).round().clamp(0.0, 255.0) as u8;
+            unsafe { *dr.add(x) = v };
+        }
+    }
+    kvImageNoError
+}
