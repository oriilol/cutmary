+const AUDIO_FORMAT_LINEAR_PCM: u32 = u32::from_be_bytes(*b"lpcm");
+const AUDIO_FORMAT_FLAG_IS_FLOAT: u32 = 1 << 0;
+const AUDIO_FORMAT_FLAG_IS_SIGNED_INTEGER: u32 = 1 << 2;
+const AUDIO_FORMAT_FLAG_IS_PACKED: u32 = 1 << 3;
+const AUDIO_FORMAT_FLAG_IS_NON_INTERLEAVED: u32 = 1 << 5;
+
+fn make_common_asbd(
+    common_format: usize,
+    sample_rate: f64,
+    channels: u32,
+    interleaved: bool,
+) -> AudioStreamBasicDescription {
+    let (bits, is_float) = match common_format {
+        1 => (32u32, true),  // AVAudioPCMFormatFloat32
+        2 => (64u32, true),  // AVAudioPCMFormatFloat64
+        3 => (16u32, false), // AVAudioPCMFormatInt16
+        4 => (32u32, false), // AVAudioPCMFormatInt32
+        _ => (32u32, true),
+    };
+    let bytes_per_sample = bits / 8;
+    let bytes_per_frame = if interleaved {
+        bytes_per_sample * channels.max(1)
+    } else {
+        bytes_per_sample
+    };
+    let mut flags = AUDIO_FORMAT_FLAG_IS_PACKED
+        | if is_float {
+            AUDIO_FORMAT_FLAG_IS_FLOAT
+        } else {
+            AUDIO_FORMAT_FLAG_IS_SIGNED_INTEGER
+        };
+    if !interleaved {
+        flags |= AUDIO_FORMAT_FLAG_IS_NON_INTERLEAVED;
+    }
+    AudioStreamBasicDescription {
+        sample_rate,
+        format_id: AUDIO_FORMAT_LINEAR_PCM,
+        format_flags: flags,
+        bytes_per_packet: bytes_per_frame,
+        frames_per_packet: 1,
+        bytes_per_frame,
+        channels_per_frame: channels,
+        bits_per_channel: bits,
+        reserved: 0,
+    }
+}
+
+unsafe extern "C" fn af_init_common(
+    receiver: Id,
+    _sel: Sel,
+    common_format: usize,
+    sample_rate: f64,
+    channels: u32,
+    interleaved: u8,
+) -> Id {
+    if receiver.is_null() {
+        return std::ptr::null_mut();
+    }
+    let body = unsafe { &mut *(receiver as *mut AudioFormatBody) };
+    body.asbd = make_common_asbd(common_format, sample_rate, channels, interleaved != 0);
+    body.common_format = common_format;
+    body.interleaved = u8::from(interleaved != 0);
+    receiver
+}
+
+unsafe extern "C" fn af_init_standard(
+    receiver: Id,
+    sel: Sel,
+    sample_rate: f64,
+    channels: u32,
+) -> Id {
+    unsafe { af_init_common(receiver, sel, 1, sample_rate, channels, 0) }
+}
+
+unsafe extern "C" fn af_init_stream_desc(
+    receiver: Id,
+    _sel: Sel,
+    asbd: *const AudioStreamBasicDescription,
+) -> Id {
+    if receiver.is_null() || asbd.is_null() {
+        return std::ptr::null_mut();
+    }
+    let desc = unsafe { *asbd };
+    let body = unsafe { &mut *(receiver as *mut AudioFormatBody) };
+    body.asbd = desc;
+    body.interleaved = u8::from((desc.format_flags & AUDIO_FORMAT_FLAG_IS_NON_INTERLEAVED) == 0);
+    body.common_format = if (desc.format_flags & AUDIO_FORMAT_FLAG_IS_FLOAT) != 0 {
+        if desc.bits_per_channel == 64 { 2 } else { 1 }
+    } else if desc.bits_per_channel == 16 {
+        3
+    } else if desc.bits_per_channel == 32 {
+        4
+    } else {
+        0
+    };
