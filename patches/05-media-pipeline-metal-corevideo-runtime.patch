+pub unsafe extern "C" fn vImageBuffer_InitWithCGImage(
+    buf: *mut vImage_Buffer,
+    format: *mut vImage_CGImageFormat,
+    _backgroundColor: *const f64,
+    image: CFTypeRef,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if buf.is_null() || format.is_null() || image.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    let w = unsafe { appkit::graphics::CGImageGetWidth(image) };
+    let h = unsafe { appkit::graphics::CGImageGetHeight(image) };
+    let src_bpc = unsafe { appkit::graphics::CGImageGetBitsPerComponent(image) } as u32;
+    let src_bpp = unsafe { appkit::graphics::CGImageGetBitsPerPixel(image) } as u32;
+    let src_bpr = unsafe { appkit::graphics::CGImageGetBytesPerRow(image) };
+    let src_info = unsafe { appkit::graphics::CGImageGetBitmapInfo(image) };
+    let provider = unsafe { appkit::graphics::CGImageGetDataProvider(image) };
+
+    let fmt = unsafe { &mut *format };
+    if fmt.bitsPerComponent == 0 {
+        fmt.bitsPerComponent = src_bpc.max(8);
+    }
+    if fmt.bitsPerPixel == 0 {
+        fmt.bitsPerPixel = src_bpp.max(32);
+    }
+    let dst_layout = layout_from_cg_format(fmt.bitsPerComponent, fmt.bitsPerPixel, fmt.bitmapInfo);
+    let src_layout = layout_from_cg_format(src_bpc, src_bpp, src_info);
+
+    let err = unsafe { vImageBuffer_Init(buf, h, w, fmt.bitsPerPixel, flags) };
+    if err != kvImageNoError || (flags & kvImageNoAllocate) != 0 {
+        return err;
+    }
+    let Some(src_bytes) = appkit::graphics::provider_bytes(provider) else {
+        return kvImageNoError;
+    };
+    let d = unsafe { *buf };
+    for y in 0..h {
+        let s_off = y * src_bpr;
+        if s_off + w * src_layout.bpp > src_bytes.len() {
+            break;
+        }
+        let sr = unsafe { src_bytes.as_ptr().add(s_off) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..w {
+            let rgba = unsafe { read_rgba(sr, x, src_layout) };
+            unsafe { write_rgba(dr, x, rgba, dst_layout) };
+        }
+    }
+    kvImageNoError
+}
+
+pub unsafe extern "C" fn vImageCreateCGImageFromBuffer(
+    buf: *const vImage_Buffer,
+    format: *const vImage_CGImageFormat,
+    callback: Option<unsafe extern "C" fn(*mut c_void, *mut c_void)>,
+    userData: *mut c_void,
+    flags: vImage_Flags,
+    error: *mut vImage_Error,
+) -> CFTypeRef {
+    let set_err = |e: vImage_Error| {
+        if !error.is_null() {
+            unsafe { *error = e };
+        }
+    };
+    let Some(b) = valid_buf(buf) else {
+        set_err(kvImageNullPointerArgument);
+        return ptr::null();
+    };
+    if format.is_null() {
+        set_err(kvImageNullPointerArgument);
+        return ptr::null();
+    }
+    let fmt = unsafe { *format };
+    let total = b.height.saturating_mul(b.rowBytes);
+    let provider = if (flags & kvImageNoAllocate) != 0 {
+        // Wrap caller's buffer directly. If caller supplied a callback, invoke it
+        // via a small trampoline wrapper.
+        if let Some(cb) = callback {
+            struct UserRelease {
+                cb: unsafe extern "C" fn(*mut c_void, *mut c_void),
+                user_data: *mut c_void,
+            }
+            unsafe extern "C" fn call_user(info: *mut c_void, data: *const c_void, _size: usize) {
+                if !info.is_null() {
+                    let boxed = unsafe { Box::from_raw(info.cast::<UserRelease>()) };
+                    unsafe { (boxed.cb)(boxed.user_data, data.cast_mut()) };
+                }
+            }
+            let info = Box::into_raw(Box::new(UserRelease {
+                cb,
+                user_data: userData,
+            }))
+            .cast();
+            unsafe {
+                appkit::graphics::CGDataProviderCreateWithData(info, b.data, total, Some(call_user))
+            }
+        } else {
+            unsafe {
+                appkit::graphics::CGDataProviderCreateWithData(
+                    ptr::null_mut(),
+                    b.data,
+                    total,
+                    None,
+                )
+            }
+        }
+    } else {
+        let copy = unsafe { libc::malloc(total.max(1)) };
+        if copy.is_null() {
+            set_err(kvImageMemoryAllocationError);
+            return ptr::null();
+        }
+        if total > 0 && !b.data.is_null() {
+            unsafe { ptr::copy_nonoverlapping(b.data.cast::<u8>(), copy.cast::<u8>(), total) };
+        }
+        unsafe {
+            appkit::graphics::CGDataProviderCreateWithData(
+                ptr::null_mut(),
+                copy,
+                total,
+                Some(free_libc_buffer),
+            )
+        }
+    };
+
+    let own_cs = fmt.colorSpace.is_null();
+    let cs = if own_cs {
+        unsafe { appkit::graphics::CGColorSpaceCreateDeviceRGB() }
+    } else {
+        fmt.colorSpace
+    };
+    let image = unsafe {
+        appkit::graphics::CGImageCreate(
+            b.width,
+            b.height,
+            fmt.bitsPerComponent as usize,
+            fmt.bitsPerPixel as usize,
+            b.rowBytes,
+            cs,
+            fmt.bitmapInfo,
+            provider,
+            fmt.decode,
+            1,
+            fmt.renderingIntent,
+        )
+    };
+    unsafe { appkit::graphics::CGDataProviderRelease(provider) };
+    if own_cs && !cs.is_null() {
+        unsafe { corefoundation::api::CFRelease(cs) };
+    }
+    set_err(if image.is_null() {
+        kvImageInvalidParameter
+    } else {
+        kvImageNoError
+    });
+    image
+}
