+}
+
+unsafe extern "C" fn af_stream_description(
+    receiver: Id,
+    _sel: Sel,
+) -> *const AudioStreamBasicDescription {
+    if receiver.is_null() {
+        return std::ptr::null();
+    }
+    unsafe { &(*(receiver as *const AudioFormatBody)).asbd }
+}
+
+unsafe extern "C" fn af_sample_rate(receiver: Id, _sel: Sel) -> f64 {
+    if receiver.is_null() {
+        return 0.0;
+    }
+    unsafe { (*(receiver as *const AudioFormatBody)).asbd.sample_rate }
+}
+
+unsafe extern "C" fn af_channel_count(receiver: Id, _sel: Sel) -> u32 {
+    if receiver.is_null() {
+        return 0;
+    }
+    unsafe { (*(receiver as *const AudioFormatBody)).asbd.channels_per_frame }
+}
+
+unsafe extern "C" fn af_is_interleaved(receiver: Id, _sel: Sel) -> u8 {
+    if receiver.is_null() {
+        return 0;
+    }
+    unsafe { (*(receiver as *const AudioFormatBody)).interleaved }
+}
+
+unsafe extern "C" fn af_common_format(receiver: Id, _sel: Sel) -> usize {
+    if receiver.is_null() {
+        return 0;
+    }
+    unsafe { (*(receiver as *const AudioFormatBody)).common_format }
+}
+
+unsafe extern "C" fn af_is_standard(receiver: Id, _sel: Sel) -> u8 {
+    if receiver.is_null() {
+        return 0;
+    }
+    let body = unsafe { &*(receiver as *const AudioFormatBody) };
+    u8::from(body.common_format == 1 && body.interleaved == 0)
+}
+
+fn install_audio_format() {
+    let class = corefoundation::base::register(
