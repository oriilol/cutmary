+// --- OpenGL ------------------------------------------------------------------
+
+/// The GL entry points texture upload needs, from the current driver.
+struct Gl {
+    gen_textures: unsafe extern "C" fn(i32, *mut u32),
+    delete_textures: unsafe extern "C" fn(i32, *const u32),
+    bind_texture: unsafe extern "C" fn(u32, u32),
+    tex_image_2d: unsafe extern "C" fn(u32, i32, i32, i32, i32, i32, u32, u32, *const c_void),
+    tex_parameteri: unsafe extern "C" fn(u32, u32, i32),
+    pixel_storei: unsafe extern "C" fn(u32, i32),
+    get_integerv: unsafe extern "C" fn(u32, *mut i32),
+    bind_buffer: unsafe extern "C" fn(u32, u32),
+}
+
+impl Gl {
+    fn get() -> Option<&'static Gl> {
+        static GL: OnceLock<Option<Gl>> = OnceLock::new();
+        GL.get_or_init(|| {
+            let f = |name: &std::ffi::CStr| sdl3::video::gl_proc_address(name);
+            // SAFETY: each pointer is the driver's entry point of that name,
+            // whose C signature is fixed by the GL specification.
+            unsafe {
+                Some(Gl {
+                    gen_textures: std::mem::transmute(f(c"glGenTextures")?),
+                    delete_textures: std::mem::transmute(f(c"glDeleteTextures")?),
+                    bind_texture: std::mem::transmute(f(c"glBindTexture")?),
+                    tex_image_2d: std::mem::transmute(f(c"glTexImage2D")?),
+                    tex_parameteri: std::mem::transmute(f(c"glTexParameteri")?),
+                    pixel_storei: std::mem::transmute(f(c"glPixelStorei")?),
+                    get_integerv: std::mem::transmute(f(c"glGetIntegerv")?),
+                    bind_buffer: std::mem::transmute(f(c"glBindBuffer")?),
+                })
+            }
+        })
+        .as_ref()
+    }
+}
+
+/// The GL upload format and type for a packed 32-bit pixel format, or `None`
+/// for a format a single GL texture cannot hold as macOS would.
+pub(crate) fn gl_upload_format(pixel_format: u32) -> Option<(u32, u32)> {
+    match pixel_format {
+        BGRA => Some((GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV)),
+        ARGB => Some((GL_BGRA, GL_UNSIGNED_INT_8_8_8_8)),
+        RGBA => Some((GL_RGBA, GL_UNSIGNED_BYTE)),
+        _ => None,
+    }
+}
+
+/// CVReturn CVOpenGLTextureCacheCreate(CFAllocatorRef, CFDictionaryRef
+/// cacheAttributes, CGLContextObj, CGLPixelFormatObj, CFDictionaryRef
+/// textureAttributes, CVOpenGLTextureCacheRef *).
+///
+/// FIXME (ACCURACY): textures are made in whichever GL context is current when
+/// one is asked for, not necessarily `context`; contexts here share objects.
+///
+/// # Safety
+/// `out` must be writable.
+pub unsafe extern "C" fn CVOpenGLTextureCacheCreate(
+    _allocator: CFTypeRef,
+    _cache_attributes: CFTypeRef,
+    context: *mut c_void,
+    _pixel_format: *mut c_void,
+    _texture_attributes: CFTypeRef,
+    out: *mut CFTypeRef,
+) -> i32 {
+    if out.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: the caller's out-parameter.
+    unsafe { *out = std::ptr::null() };
+    if context.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    let made = corefoundation::boxed::make(gl_cache_class(), GlCache);
+    if made.is_null() {
+        return super::ALLOCATION_FAILED;
+    }
+    // SAFETY: as above.
+    unsafe { *out = made };
+    SUCCESS
+}
+
+/// CVReturn CVOpenGLTextureCacheCreateTextureFromImage(CFAllocatorRef,
+/// CVOpenGLTextureCacheRef, CVImageBufferRef, CFDictionaryRef attributes,
+/// CVOpenGLTextureRef *).
+///
+/// # Safety
+/// The references must be live CF objects or null; `out` must be writable.
+pub unsafe extern "C" fn CVOpenGLTextureCacheCreateTextureFromImage(
+    _allocator: CFTypeRef,
+    cache: CFTypeRef,
+    image: CFTypeRef,
+    _attributes: CFTypeRef,
+    out: *mut CFTypeRef,
+) -> i32 {
+    if out.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: the caller's out-parameter.
+    unsafe { *out = std::ptr::null() };
+    if contents::<GlCache>(cache, gl_cache_class()).is_none() || state(image).is_none() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: a pixel buffer of this crate's, checked above.
+    let Some((format, kind)) = gl_upload_format(unsafe { CVPixelBufferGetPixelFormatType(image) })
+    else {
+        return NOT_OPENGL_COMPATIBLE;
+    };
+    let (Some(gl), false) = (Gl::get(), sdl3::video::gl_current_context().is_null()) else {
+        return ERROR;
+    };
+    let Some(view) = lock_plane(image, 0) else {
+        return INVALID_ARGUMENT;
+    };
+    let name = upload_gl_texture(gl, format, kind, &view);
+    unlock(image);
+    // SAFETY: a live pixel buffer, retained for the texture's lifetime.
+    let buffer = unsafe { corefoundation::api::CFRetain(image) };
+    let made = corefoundation::boxed::make(gl_texture_class(), GlTexture { name, buffer });
+    if made.is_null() {
+        return super::ALLOCATION_FAILED;
+    }
+    // SAFETY: as above.
+    unsafe { *out = made };
+    SUCCESS
+}
+
+/// A new rectangle texture holding `view`, leaving the caller's unpack state
+/// and texture binding as they were.
+fn upload_gl_texture(gl: &Gl, format: u32, kind: u32, view: &PlaneView) -> u32 {
+    const BYTES_PER_PIXEL: usize = 4;
+    // SAFETY: a context is current, checked by the caller; every piece of
+    // state changed here is read first and put back.
+    unsafe {
+        let mut saved = [0i32; 4];
+        (gl.get_integerv)(GL_TEXTURE_BINDING_RECTANGLE, &mut saved[0]);
+        (gl.get_integerv)(GL_UNPACK_ROW_LENGTH, &mut saved[1]);
+        (gl.get_integerv)(GL_UNPACK_ALIGNMENT, &mut saved[2]);
+        (gl.get_integerv)(GL_PIXEL_UNPACK_BUFFER_BINDING, &mut saved[3]);
+        let mut name = 0;
+        (gl.gen_textures)(1, &mut name);
+        (gl.bind_texture)(GL_TEXTURE_RECTANGLE, name);
+        (gl.bind_buffer)(GL_PIXEL_UNPACK_BUFFER, 0);
+        (gl.pixel_storei)(
+            GL_UNPACK_ROW_LENGTH,
+            (view.bytes_per_row / BYTES_PER_PIXEL) as i32,
+        );
+        (gl.pixel_storei)(GL_UNPACK_ALIGNMENT, 1);
+        (gl.tex_image_2d)(
+            GL_TEXTURE_RECTANGLE,
+            0,
+            GL_RGBA8,
+            view.width as i32,
+            view.height as i32,
+            0,
+            format,
+            kind,
+            view.base.cast(),
+        );
+        for (parameter, value) in [
+            (GL_TEXTURE_MIN_FILTER, GL_LINEAR),
+            (GL_TEXTURE_MAG_FILTER, GL_LINEAR),
+            (GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE),
+            (GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE),
+        ] {
+            (gl.tex_parameteri)(GL_TEXTURE_RECTANGLE, parameter, value);
+        }
+        (gl.pixel_storei)(GL_UNPACK_ROW_LENGTH, saved[1]);
+        (gl.pixel_storei)(GL_UNPACK_ALIGNMENT, saved[2]);
+        (gl.bind_buffer)(GL_PIXEL_UNPACK_BUFFER, saved[3] as u32);
+        (gl.bind_texture)(GL_TEXTURE_RECTANGLE, saved[0] as u32);
+        name
+    }
+}
+
+/// GLuint CVOpenGLTextureGetName(CVOpenGLTextureRef).
+pub unsafe extern "C" fn CVOpenGLTextureGetName(texture: CFTypeRef) -> u32 {
+    contents::<GlTexture>(texture, gl_texture_class()).map_or(0, |t| t.name)
+}
+
+/// GLenum CVOpenGLTextureGetTarget(CVOpenGLTextureRef): always a rectangle
+/// texture, as on macOS.
+pub unsafe extern "C" fn CVOpenGLTextureGetTarget(texture: CFTypeRef) -> u32 {
+    contents::<GlTexture>(texture, gl_texture_class()).map_or(0, |_| GL_TEXTURE_RECTANGLE)
+}
+
+/// void CVOpenGLTextureCacheFlush(CVOpenGLTextureCacheRef, CVOptionFlags).
+pub unsafe extern "C" fn CVOpenGLTextureCacheFlush(_cache: CFTypeRef, _options: u64) {}
+
+pub unsafe extern "C" fn CVOpenGLTextureCacheRelease(cache: CFTypeRef) {
+    if !cache.is_null() {
+        // SAFETY: a live cache the caller passed.
+        unsafe { corefoundation::api::CFRelease(cache) };
+    }
+}
+
+pub unsafe extern "C" fn CVOpenGLTextureRelease(texture: CFTypeRef) {
+    if !texture.is_null() {
+        // SAFETY: a live texture the caller passed.
+        unsafe { corefoundation::api::CFRelease(texture) };
+    }
+}
