+            width: 1,
+            height: 1,
+            rowBytes: 2,
+        };
+        let range = vImage_YpCbCrPixelRange {
+            Yp_bias: 16,
+            CbCr_bias: 128,
+            YpRangeMax: 235,
+            CbCrRangeMax: 240,
+            YpMax: 235,
+            YpMin: 16,
+            CbCrMax: 240,
+            CbCrMin: 16,
+        };
+        let mut to_yuv = [0u8; 128];
+        let mut to_rgb = [0u8; 128];
+        assert_eq!(
