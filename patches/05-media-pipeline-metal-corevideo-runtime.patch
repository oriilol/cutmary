+#include <metal_stdlib>
+using namespace metal;
+struct main0_out { float4 color [[color(0)]]; };
+struct main0_in { float2 uv [[user(locn0)]]; };
+fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> texSampler [[texture(0)]], sampler texSamplerSmplr [[sampler(0)]], constant float& alpha [[buffer(0)]], constant float4& u_is_texture_0_flip_, texture2d<float> second, sampler secondSmplr)
+{
+    main0_out out = {};
+    out.color = texSampler.sample(texSamplerSmplr, in.uv) * alpha * u_is_texture_0_flip_.x
+        + second.sample(secondSmplr, in.uv);
+    return out;
+}
+"#;
+    let module = parse_msl(source).unwrap();
+    let mut located: Vec<_> = module.entries[0].resources.iter().map(|r| (r.kind, r.index)).collect();
+    located.sort_by_key(|(kind, index)| (format!("{kind:?}"), *index));
+    use metal_translate::ir::ResourceKind::{Buffer, Sampler, Texture};
+    assert_eq!(located, [(Buffer, 0), (Buffer, 1), (Sampler, 0), (Sampler, 1), (Texture, 0), (Texture, 1)]);
