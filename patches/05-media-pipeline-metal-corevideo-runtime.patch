+                    record(8, &[2, 0]),                                     // 1: output
+                    record(1, string("air.vertex_input")),                  // 2
+                    record(1, string("air.location_index")),                // 3
+                    record(1, string("generated(__air_placeholder__)")),    // 4
+                    record(1, string("air.arg_name")),                      // 5
+                    record(1, string("aPosition")),                         // 6
+                    record(8, &[1, 1, 2, 2, 2, 3, 1, 1, 1, 2, 2, 4, 2, 5, 2, 6]), // 7: input 0
+                    record(8, &[2, 1]),                                     // 8: output list
+                    record(8, &[2, 7]),                                     // 9: input list
+                    record(8, &[3, 0, 2, 8, 2, 9]),                         // 10: entry
