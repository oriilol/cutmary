+/// `isunordered` and `isordered` (MSL 6.5): CapCut's media shaders use them,
+/// and a library that fails to translate is asked for again on every frame.
+#[test]
+fn source_msl_lowers_ordered_comparisons() {
+    let source = r#"
+#include <metal_stdlib>
+using namespace metal;
+kernel void k(device float4* out [[buffer(0)]], constant float4& a [[buffer(1)]]) {
+    half h = half(a.w);
+    bool s = isunordered(a.x, a.y);
+    bool4 v = isordered(a, a.yxwz);
+    bool m = isunordered(a.z, h);
+    out[0] = float4(float(s), float(all(v)), float(m), 0.0);
+}
+"#;
+    let library = translate_msl(source, &TargetProfile::vulkan_1_3()).unwrap();
+    let module = rspirv::dr::load_words(&library.entries[0].words).unwrap();
+    let ops: Vec<Op> = module.functions.iter().flat_map(|f| &f.blocks).flat_map(|b| &b.instructions).map(|i| i.class.opcode).collect();
+    // Vulkan has no `OpOrdered`/`OpUnordered` (they need `Kernel`): each
+    // operand is tested with `OpIsNan`.
+    assert!(!ops.contains(&Op::Unordered) && !ops.contains(&Op::Ordered));
+    assert_eq!(ops.iter().filter(|op| **op == Op::IsNan).count(), 6);
+    assert_eq!(ops.iter().filter(|op| **op == Op::LogicalNot).count(), 1);
+}
+
+/// MSL's `fabs` is `abs` restricted to floating point; CapCut's render
+/// pipelines use it on scalars and vectors.
+#[test]
+fn source_msl_lowers_fabs() {
+    let source = r#"
+#include <metal_stdlib>
+using namespace metal;
+kernel void k(device float4* out [[buffer(0)]], constant float4& a [[buffer(1)]]) {
+    out[0] = fabs(a) + float4(fabs(a.x));
+}
+"#;
+    let library = translate_msl(source, &TargetProfile::vulkan_1_3()).unwrap();
+    let module = rspirv::dr::load_words(&library.entries[0].words).unwrap();
+    let abs = module
+        .functions
+        .iter()
+        .flat_map(|f| &f.blocks)
+        .flat_map(|b| &b.instructions)
+        .filter(|i| i.class.opcode == Op::ExtInst)
+        .filter(|i| matches!(i.operands.get(1), Some(rspirv::dr::Operand::LiteralExtInstInteger(4))))
+        .count();
+    assert_eq!(abs, 2, "two GLSL.std.450 FAbs");
+}
+
+/// MSL 5.2.1: an argument given no location takes the first free index of
+/// its kind. SPIRV-Cross emits such arguments; this is CapCut's flip shader.
+#[test]
+fn source_msl_places_an_unlocated_argument_at_the_first_free_index() {
+    let source = r#"
+#include <metal_stdlib>
+using namespace metal;
+struct main0_out { float4 color [[color(0)]]; };
+struct main0_in { float2 uv [[user(locn0)]]; };
+fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> texSampler [[texture(0)]], sampler texSamplerSmplr [[sampler(0)]], constant float& alpha [[buffer(0)]], constant float4& u_is_texture_0_flip_, texture2d<float> second, sampler secondSmplr)
+{
+    main0_out out = {};
+    out.color = texSampler.sample(texSamplerSmplr, in.uv) * alpha * u_is_texture_0_flip_.x
+        + second.sample(secondSmplr, in.uv);
+    return out;
+}
+"#;
+    let module = parse_msl(source).unwrap();
+    let mut located: Vec<_> = module.entries[0].resources.iter().map(|r| (r.kind, r.index)).collect();
+    located.sort_by_key(|(kind, index)| (format!("{kind:?}"), *index));
+    use metal_translate::ir::ResourceKind::{Buffer, Sampler, Texture};
+    assert_eq!(located, [(Buffer, 0), (Buffer, 1), (Sampler, 0), (Sampler, 1), (Texture, 0), (Texture, 1)]);
+    translate_msl(source, &TargetProfile::vulkan_1_3()).unwrap();
+}
+
