+            "rosemary: shader cache: miss {key} frontend {} bytes {len} translated",
+            frontend.tag()
+        ),
+        Err(error) => eprintln!(
+            "rosemary: shader cache: miss {key} frontend {} bytes {len} failed: {}",
+            frontend.tag(),
+            error.to_string().lines().next().unwrap_or_default()
