+        "textureReferenceType" => crate::nil, c"@16@0:8";
+        "argumentIndex" => zero, c"Q16@0:8";
+        "dealloc" => member_dealloc, c"v16@0:8";
+    });
+    let class = object::register::<ArrayType>(c"RosemaryMTLArrayType");
+    methods!(class, {
+        "elementType" => array_element_type, c"Q16@0:8";
+        "arrayLength" => array_length, c"Q16@0:8";
+        "stride" => array_stride, c"Q16@0:8";
+        "argumentIndexStride" => zero, c"Q16@0:8";
+        "elementStructType" => array_struct, c"@16@0:8";
+        "elementArrayType" => array_array, c"@16@0:8";
+        "elementPointerType" => crate::nil, c"@16@0:8";
+        "elementTextureReferenceType" => crate::nil, c"@16@0:8";
+        "dataType" => array_data_type, c"Q16@0:8";
+        "dealloc" => array_dealloc, c"v16@0:8";
+    });
+    let class = object::register::<Reflection>(c"RosemaryMTLRenderPipelineReflection");
+    methods!(class, {
+        "vertexArguments" => reflection_first, c"@16@0:8";
+        "fragmentArguments" => reflection_second, c"@16@0:8";
+        "vertexBindings" => reflection_first, c"@16@0:8";
+        "fragmentBindings" => reflection_second, c"@16@0:8";
+        "tileArguments" => crate::nil, c"@16@0:8";
+        "tileBindings" => crate::nil, c"@16@0:8";
+        "dealloc" => reflection_dealloc, c"v16@0:8";
+    });
+    let class = object::register::<Reflection>(c"RosemaryMTLComputePipelineReflection");
+    methods!(class, {
+        "arguments" => reflection_first, c"@16@0:8";
+        "bindings" => reflection_first, c"@16@0:8";
+        "dealloc" => reflection_dealloc, c"v16@0:8";
+    });
+}
