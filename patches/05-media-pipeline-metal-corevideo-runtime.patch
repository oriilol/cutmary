+pub unsafe extern "C" fn vImageConvert_ARGB8888To420Yp8_Cb8_Cr8(
+    src: *const vImage_Buffer,
+    destYp: *const vImage_Buffer,
+    destCb: *const vImage_Buffer,
+    destCr: *const vImage_Buffer,
+    info: *const c_void,
+    permuteMap: *const u8,
+    _flags: vImage_Flags,
+) -> vImage_Error {
+    let (Some(s), Some(yp), Some(cb), Some(cr)) = (
+        valid_buf(src),
+        valid_buf(destYp),
+        valid_buf(destCb),
+        valid_buf(destCr),
+    ) else {
+        return kvImageNullPointerArgument;
+    };
+    let conv = read_argb_to_yuv_info(info);
+    let map = read_permute_map(permuteMap);
+    let w = s.width.min(yp.width);
+    let h = s.height.min(yp.height);
+    for y in 0..h {
+        let sr = unsafe { row_ptr(&s, y) };
+        let yr = unsafe { row_ptr_mut(&yp, y) };
+        let cbr = if y / 2 < cb.height {
+            Some(unsafe { row_ptr_mut(&cb, y / 2) })
+        } else {
+            None
+        };
+        let crr = if y / 2 < cr.height {
+            Some(unsafe { row_ptr_mut(&cr, y / 2) })
+        } else {
+            None
+        };
+        for x in 0..w {
+            let raw = unsafe {
+                [
+                    *sr.add(x * 4),
+                    *sr.add(x * 4 + 1),
+                    *sr.add(x * 4 + 2),
+                    *sr.add(x * 4 + 3),
+                ]
+            };
+            let r = raw[map[1]];
+            let g = raw[map[2]];
+            let b = raw[map[3]];
+            let [yv, cbv, crv] = rgb_to_yuv_px(r, g, b, &conv);
+            unsafe { *yr.add(x) = yv };
+            if (y & 1) == 0 && (x & 1) == 0 {
+                if let Some(p) = cbr
+                    && x / 2 < cb.width
+                {
+                    unsafe { *p.add(x / 2) = cbv };
+                }
+                if let Some(p) = crr
+                    && x / 2 < cr.width
+                {
+                    unsafe { *p.add(x / 2) = crv };
+                }
+            }
+        }
+    }
+    kvImageNoError
+}
