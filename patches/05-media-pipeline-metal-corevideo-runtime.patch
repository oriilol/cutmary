+//! Pixel buffers sharing the storage and CPU access protocol of an IOSurface.
+
+use super::*;
+use std::sync::Mutex;
+
+pub(super) struct Backing {
+    pub(super) object: CFTypeRef,
+    // Serialize paired updates to the surface and the buffer's own lock count.
+    access: Mutex<()>,
+}
+
+impl Backing {
+    pub(super) fn base(&self) -> *mut u8 {
+        unsafe { iosurface::IOSurfaceGetBaseAddress(self.object).cast() }
+    }
+
+    pub(super) fn lock(&self, count: &AtomicUsize, flags: u64) -> i32 {
+        let _guard = self.access.lock().unwrap_or_else(|e| e.into_inner());
+        let Some(next) = count.load(Ordering::Relaxed).checked_add(1) else {
+            return ERROR;
+        };
+        if unsafe {
+            iosurface::IOSurfaceLock(
+                self.object,
+                (flags & READ_ONLY) as u32,
+                std::ptr::null_mut(),
+            )
+        } != SUCCESS
+        {
+            return ERROR;
+        }
+        count.store(next, Ordering::Release);
+        SUCCESS
+    }
+
+    pub(super) fn unlock(&self, count: &AtomicUsize, flags: u64) -> i32 {
+        let _guard = self.access.lock().unwrap_or_else(|e| e.into_inner());
+        let Some(next) = count.load(Ordering::Relaxed).checked_sub(1) else {
+            return ERROR;
+        };
+        if unsafe {
+            iosurface::IOSurfaceUnlock(
+                self.object,
+                (flags & READ_ONLY) as u32,
+                std::ptr::null_mut(),
+            )
+        } != SUCCESS
+        {
+            return ERROR;
+        }
+        count.store(next, Ordering::Release);
+        SUCCESS
+    }
+}
+
+impl Drop for Backing {
+    fn drop(&mut self) {
+        unsafe {
+            let id = iosurface::IOSurfaceGetID(self.object);
+            iosurface::IOSurfaceDecrementUseCount(self.object);
+            if iosurface::IOSurfaceIsInUse(self.object) == 0 {
+                super::texture_cache::evict_surface(id);
+            }
+            corefoundation::api::CFRelease(self.object);
+        }
+    }
+}
+
+pub unsafe extern "C" fn CVPixelBufferCreateWithIOSurface(
+    allocator: CFTypeRef,
+    surface: CFTypeRef,
+    attrs: CFTypeRef,
+    out: *mut CFTypeRef,
+) -> i32 {
+    let status = unsafe { check_create(allocator, attrs, out) };
+    if status != SUCCESS {
+        return status;
+    }
+    refuse_foreign(c"CVPixelBufferCreateWithIOSurface", surface);
+    if !iosurface::is_surface(surface) {
+        return INVALID_ARGUMENT;
+    }
+    let (width, height, format, row_bytes, address) = unsafe {
+        (
+            iosurface::IOSurfaceGetWidth(surface),
+            iosurface::IOSurfaceGetHeight(surface),
+            iosurface::IOSurfaceGetPixelFormat(surface),
+            iosurface::IOSurfaceGetBytesPerRow(surface),
+            iosurface::IOSurfaceGetBaseAddress(surface).cast::<u8>(),
+        )
+    };
+    // IOSurfaceCreate currently rejects planar descriptors. Only expose layouts
+    // for which the pixel format and the surface's element geometry agree.
+    const ARGB: u32 = 32;
+    const RGBA: u32 = u32::from_be_bytes(*b"RGBA");
+    if !matches!(format, BGRA | ARGB | RGBA) {
+        return INVALID_PIXEL_FORMAT;
+    }
+    if unsafe {
+        iosurface::IOSurfaceGetBytesPerElement(surface) != 4
+            || iosurface::IOSurfaceGetElementWidth(surface) != 1
+            || iosurface::IOSurfaceGetElementHeight(surface) != 1
+    } || width.checked_mul(4).is_none_or(|n| n > row_bytes)
+    {
+        return INVALID_ATTRIBUTES;
+    }
+    let Some(data_size) = row_bytes.checked_mul(height) else {
+        return INVALID_SIZE;
+    };
+    for (key, actual) in [
+        ("Width", width),
+        ("Height", height),
+        ("PixelFormatType", format as usize),
+    ] {
+        if !attribute(attrs, key).is_null() && numeric_attribute(attrs, key, false) != Ok(actual) {
+            return INVALID_ATTRIBUTES;
+        }
+    }
+    let Ok(alignment) = numeric_attribute(attrs, "BytesPerRowAlignment", true) else {
+        return INVALID_ATTRIBUTES;
+    };
+    if alignment != 0 && !row_bytes.is_multiple_of(alignment) {
+        return INVALID_ATTRIBUTES;
+    }
+    unsafe {
+        corefoundation::api::CFRetain(surface);
+        iosurface::IOSurfaceIncrementUseCount(surface);
+        publish(
+            State {
+                width,
+                height,
+                format,
+                row_bytes,
+                data_size,
+                planes: vec![Plane {
+                    offset: 0,
+                    address,
+                    width,
+                    height,
+                    row_bytes,
+                }],
+                memory: Memory::Surface(Backing {
+                    object: surface,
+                    access: Mutex::new(()),
+                }),
+                locks: AtomicUsize::new(0),
+                cpu_generation: std::sync::atomic::AtomicU64::new(1),
+                metal_textures: Default::default(),
+                attachments: Default::default(),
+            },
+            out,
+        )
+    }
+}
