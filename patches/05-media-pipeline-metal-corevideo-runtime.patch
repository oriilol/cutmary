+//! `CVMetalTextureCache` and `CVOpenGLTextureCache`: GPU textures made from
+//! pixel buffers.
+//!
+//! FIXME (ACCURACY): a texture is a copy of the buffer's pixels taken when it
+//! is made. On macOS it shares the buffer's IOSurface, so CPU writes made later
+//! show through without a new texture; a flush therefore has nothing to do.
+
+use std::ffi::c_void;
+use std::sync::OnceLock;
+
+use corefoundation::base::CFTypeRef;
+use objc::class::Class;
+use objc::object::Id;
+use objc::sel::Sel;
+
+use super::{
+    BGRA, CVPixelBufferGetBaseAddressOfPlane, CVPixelBufferGetBytesPerRowOfPlane,
+    CVPixelBufferGetHeightOfPlane, CVPixelBufferGetPixelFormatType, CVPixelBufferGetPlaneCount,
+    CVPixelBufferGetWidthOfPlane, CVPixelBufferLockBaseAddress, CVPixelBufferUnlockBaseAddress,
+    ERROR, INVALID_ARGUMENT, READ_ONLY, SUCCESS, attribute, state,
+};
+
+/// `kCVReturnPixelBufferNotOpenGLCompatible`.
+const NOT_OPENGL_COMPATIBLE: i32 = -6683;
+/// `kCVReturnPixelBufferNotMetalCompatible`.
+const NOT_METAL_COMPATIBLE: i32 = -6684;
+/// `MTLTextureUsageShaderRead`, what a cache texture is for unless the
+/// attributes say otherwise.
+const MTL_TEXTURE_USAGE_SHADER_READ: u64 = 1;
+/// `kCVPixelFormatType_32ARGB`.
+const ARGB: u32 = 0x20;
+const RGBA: u32 = u32::from_be_bytes(*b"RGBA");
+
+const GL_TEXTURE_RECTANGLE: u32 = 0x84F5;
+const GL_TEXTURE_BINDING_RECTANGLE: u32 = 0x84F6;
+const GL_RGBA8: i32 = 0x8058;
+const GL_RGBA: u32 = 0x1908;
+const GL_BGRA: u32 = 0x80E1;
+const GL_UNSIGNED_BYTE: u32 = 0x1401;
+const GL_UNSIGNED_INT_8_8_8_8: u32 = 0x8035;
+const GL_UNSIGNED_INT_8_8_8_8_REV: u32 = 0x8367;
+const GL_UNPACK_ROW_LENGTH: u32 = 0x0CF2;
+const GL_UNPACK_ALIGNMENT: u32 = 0x0CF5;
+const GL_PIXEL_UNPACK_BUFFER: u32 = 0x88EC;
+const GL_PIXEL_UNPACK_BUFFER_BINDING: u32 = 0x88EF;
+const GL_TEXTURE_MIN_FILTER: u32 = 0x2801;
+const GL_TEXTURE_MAG_FILTER: u32 = 0x2800;
+const GL_TEXTURE_WRAP_S: u32 = 0x2802;
+const GL_TEXTURE_WRAP_T: u32 = 0x2803;
+const GL_LINEAR: i32 = 0x2601;
+const GL_CLAMP_TO_EDGE: i32 = 0x812F;
+
+/// `MTLRegion`.
+#[repr(C)]
+struct Region {
+    origin: [u64; 3],
+    size: [u64; 3],
+}
+
+struct MetalCache {
+    /// The `id<MTLDevice>` textures are made on, retained.
+    device: Id,
+}
+
+impl Drop for MetalCache {
+    fn drop(&mut self) {
+        objc::arc::release(self.device);
+    }
+}
+
+struct MetalTexture {
+    /// The `id<MTLTexture>`, owned.
+    texture: Id,
+    /// The pixel buffer it was made from, retained as macOS does.
+    buffer: CFTypeRef,
+}
+
+impl Drop for MetalTexture {
+    fn drop(&mut self) {
+        objc::arc::release(self.texture);
+        // SAFETY: the retain this texture took.
+        unsafe { corefoundation::api::CFRelease(self.buffer) };
+    }
+}
+
+struct GlCache;
+
+struct GlTexture {
+    name: u32,
+    buffer: CFTypeRef,
+}
+
+impl Drop for GlTexture {
+    fn drop(&mut self) {
+        // FIXME (ACCURACY): the name is only deleted when some GL context is
+        // current on the releasing thread; contexts here share objects.
+        if !sdl3::video::gl_current_context().is_null()
+            && let Some(gl) = Gl::get()
+        {
+            // SAFETY: a texture name this cache made, with a context current.
+            unsafe { (gl.delete_textures)(1, &self.name) };
+        }
+        // SAFETY: the retain this texture took.
+        unsafe { corefoundation::api::CFRelease(self.buffer) };
+    }
+}
+
+fn register<T: 'static>(
+    slot: &'static OnceLock<usize>,
+    name: &'static std::ffi::CStr,
+) -> &'static Class {
+    let addr = *slot.get_or_init(|| {
+        corefoundation::bootstrap();
+        objc::class::ptr(corefoundation::boxed::register::<T>(name, None, true)) as usize
+    });
+    // SAFETY: the registered class lives for the process.
+    unsafe { &*(addr as *const Class) }
+}
+
+fn metal_cache_class() -> &'static Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    register::<MetalCache>(&CLASS, c"__CVMetalTextureCache")
+}
+
+fn metal_texture_class() -> &'static Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    register::<MetalTexture>(&CLASS, c"__CVMetalTexture")
+}
+
+fn gl_cache_class() -> &'static Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    register::<GlCache>(&CLASS, c"__CVOpenGLTextureCache")
+}
+
+fn gl_texture_class() -> &'static Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    register::<GlTexture>(&CLASS, c"__CVOpenGLTexture")
+}
+
+fn contents<'a, T>(object: CFTypeRef, class: &'static Class) -> Option<&'a T> {
+    if object.is_null() {
+        return None;
+    }
+    // SAFETY: a live CF object; its class is checked before the body is read.
+    unsafe { corefoundation::boxed::contents::<T>(object, class) }.map(|t| &*t)
+}
+
+/// One plane of a locked pixel buffer, or the whole of a packed one.
+struct PlaneView {
+    base: *const u8,
+    width: usize,
+    height: usize,
+    bytes_per_row: usize,
+}
+
+/// Locks `buffer` for reading and describes `plane`; `None` when the buffer is
+/// not one of this runtime's or has no such plane.
+fn lock_plane(buffer: CFTypeRef, plane: usize) -> Option<PlaneView> {
+    state(buffer)?;
+    // SAFETY: a pixel buffer of this crate's, checked above.
+    unsafe {
+        let planes = CVPixelBufferGetPlaneCount(buffer);
+        if plane >= planes.max(1) || CVPixelBufferLockBaseAddress(buffer, READ_ONLY) != SUCCESS {
+            return None;
+        }
+        // The plane accessors answer for the whole image of a packed buffer.
+        let view = PlaneView {
+            base: CVPixelBufferGetBaseAddressOfPlane(buffer, plane).cast(),
+            width: CVPixelBufferGetWidthOfPlane(buffer, plane),
+            height: CVPixelBufferGetHeightOfPlane(buffer, plane),
+            bytes_per_row: CVPixelBufferGetBytesPerRowOfPlane(buffer, plane),
+        };
+        if view.base.is_null() {
+            CVPixelBufferUnlockBaseAddress(buffer, READ_ONLY);
+            return None;
+        }
+        Some(view)
+    }
+}
+
+fn unlock(buffer: CFTypeRef) {
+    // SAFETY: a buffer `lock_plane` locked.
+    unsafe { CVPixelBufferUnlockBaseAddress(buffer, READ_ONLY) };
+}
+
+// --- Metal -------------------------------------------------------------------
+
+/// CVReturn CVMetalTextureCacheCreate(CFAllocatorRef, CFDictionaryRef
+/// cacheAttributes, id<MTLDevice>, CFDictionaryRef textureAttributes,
+/// CVMetalTextureCacheRef *).
+///
+/// # Safety
+/// `device` must be nil or an `MTLDevice`; `out` must be writable.
+pub unsafe extern "C" fn CVMetalTextureCacheCreate(
+    _allocator: CFTypeRef,
+    _cache_attributes: CFTypeRef,
+    device: Id,
+    _texture_attributes: CFTypeRef,
+    out: *mut CFTypeRef,
+) -> i32 {
+    if out.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: the caller's out-parameter.
+    unsafe { *out = std::ptr::null() };
+    if device.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    let made = corefoundation::boxed::make(
+        metal_cache_class(),
+        MetalCache {
+            device: objc::arc::retain(device),
+        },
+    );
+    if made.is_null() {
+        return super::ALLOCATION_FAILED;
+    }
+    // SAFETY: as above.
+    unsafe { *out = made };
+    SUCCESS
+}
+
+/// CVReturn CVMetalTextureCacheCreateTextureFromImage(CFAllocatorRef,
+/// CVMetalTextureCacheRef, CVImageBufferRef, CFDictionaryRef textureAttributes,
+/// MTLPixelFormat, size_t width, size_t height, size_t planeIndex,
+/// CVMetalTextureRef *).
+///
+/// # Safety
+/// The references must be live CF objects or null; `out` must be writable.
+#[allow(clippy::too_many_arguments)]
+pub unsafe extern "C" fn CVMetalTextureCacheCreateTextureFromImage(
+    _allocator: CFTypeRef,
+    cache: CFTypeRef,
+    image: CFTypeRef,
+    texture_attributes: CFTypeRef,
+    pixel_format: u64,
+    width: usize,
+    height: usize,
+    plane: usize,
+    out: *mut CFTypeRef,
+) -> i32 {
+    if out.is_null() {
+        return INVALID_ARGUMENT;
+    }
+    // SAFETY: the caller's out-parameter.
+    unsafe { *out = std::ptr::null() };
+    let Some(cache) = contents::<MetalCache>(cache, metal_cache_class()) else {
+        return INVALID_ARGUMENT;
+    };
+    if width == 0 || height == 0 {
+        return INVALID_ARGUMENT;
+    }
+    let Some(view) = lock_plane(image, plane) else {
+        return INVALID_ARGUMENT;
+    };
+    if width > view.width || height > view.height {
+        unlock(image);
+        return NOT_METAL_COMPATIBLE;
+    }
+    // SAFETY: null or a CF value from the caller's dictionary.
+    let usage = unsafe {
+        corefoundation::collections::number(attribute(texture_attributes, "MetalTextureUsage"))
+    }
+    .and_then(|n| u64::try_from(n.as_i64()).ok())
+    .unwrap_or(MTL_TEXTURE_USAGE_SHADER_READ);
+    let texture = make_metal_texture(cache.device, pixel_format, width, height, usage, &view);
+    unlock(image);
+    if texture.is_null() {
+        return NOT_METAL_COMPATIBLE;
+    }
+    // SAFETY: a live pixel buffer, retained for the texture's lifetime.
+    let buffer = unsafe { corefoundation::api::CFRetain(image) };
+    let made = corefoundation::boxed::make(metal_texture_class(), MetalTexture { texture, buffer });
+    if made.is_null() {
+        return super::ALLOCATION_FAILED;
+    }
+    // SAFETY: as above.
+    unsafe { *out = made };
+    SUCCESS
+}
+
+/// A new texture on `device` holding `view`'s pixels, owned by the caller.
+fn make_metal_texture(
+    device: Id,
+    pixel_format: u64,
+    width: usize,
+    height: usize,
+    usage: u64,
+    view: &PlaneView,
+) -> Id {
+    let Some(class) = objc::class::lookup(c"MTLTextureDescriptor") else {
+        return std::ptr::null_mut();
+    };
+    // SAFETY: Metal's own signatures for each selector, sent to a descriptor
+    // class, a descriptor, a device and the texture it made.
+    unsafe {
+        let make_descriptor: unsafe extern "C" fn(Id, Sel, u64, u64, u64, bool) -> Id =
+            std::mem::transmute(objc::msg::entry());
+        let descriptor = make_descriptor(
+            objc::class::ptr(class) as Id,
+            objc::sel::get("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"),
+            pixel_format,
+            width as u64,
+            height as u64,
+            false,
+        );
+        if descriptor.is_null() {
+            return std::ptr::null_mut();
+        }
+        let set_usage: unsafe extern "C" fn(Id, Sel, u64) = std::mem::transmute(objc::msg::entry());
+        set_usage(descriptor, objc::sel::get("setUsage:"), usage);
+        let new_texture: unsafe extern "C" fn(Id, Sel, Id) -> Id =
+            std::mem::transmute(objc::msg::entry());
+        let texture = new_texture(
+            device,
+            objc::sel::get("newTextureWithDescriptor:"),
+            descriptor,
+        );
+        if texture.is_null() {
+            return texture;
+        }
+        let replace: unsafe extern "C" fn(Id, Sel, Region, u64, *const c_void, u64) =
+            std::mem::transmute(objc::msg::entry());
+        replace(
+            texture,
+            objc::sel::get("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"),
+            Region {
+                origin: [0; 3],
+                size: [width as u64, height as u64, 1],
+            },
+            0,
+            view.base.cast(),
+            view.bytes_per_row as u64,
+        );
+        texture
+    }
+}
+
+/// id<MTLTexture> CVMetalTextureGetTexture(CVMetalTextureRef), under the get rule.
+pub unsafe extern "C" fn CVMetalTextureGetTexture(texture: CFTypeRef) -> Id {
+    contents::<MetalTexture>(texture, metal_texture_class())
+        .map_or(std::ptr::null_mut(), |t| t.texture)
+}
