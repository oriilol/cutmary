+// vImageCVImageFormat & vImageConverter & vImageConvert_AnyToAny
+// ---------------------------------------------------------------------------
+
+const FOURCC_BGRA: u32 = u32::from_be_bytes(*b"BGRA");
+const FOURCC_RGBA: u32 = u32::from_be_bytes(*b"RGBA");
+const FOURCC_ARGB: u32 = 32; // kCVPixelFormatType_32ARGB
+const FOURCC_420V: u32 = u32::from_be_bytes(*b"420v");
+const FOURCC_420F: u32 = u32::from_be_bytes(*b"420f");
+const FOURCC_Y420: u32 = u32::from_be_bytes(*b"y420");
+const FOURCC_F420: u32 = u32::from_be_bytes(*b"f420");
+
+#[derive(Clone, Copy)]
+struct CvFormat {
+    pixel_format: u32,
+    color_space: CFTypeRef,
+}
+
+#[derive(Clone, Copy)]
+enum EndpointFormat {
+    Cg(PixelLayout),
+    Cv(u32),
+}
+
+struct Converter {
+    src: EndpointFormat,
+    dst: EndpointFormat,
+}
+
+fn cv_to_pixel_layout(fourcc: u32) -> Option<PixelLayout> {
+    match fourcc {
+        FOURCC_BGRA => Some(PixelLayout {
+            bpp: 4,
+            rgba_idx: [2, 1, 0, 3],
+            premultiplied: false,
+            has_alpha: true,
+        }),
+        FOURCC_RGBA => Some(PixelLayout {
+            bpp: 4,
+            rgba_idx: [0, 1, 2, 3],
+            premultiplied: false,
+            has_alpha: true,
+        }),
+        FOURCC_ARGB => Some(PixelLayout {
+            bpp: 4,
+            rgba_idx: [1, 2, 3, 0],
+            premultiplied: false,
+            has_alpha: true,
+        }),
+        _ => None,
+    }
+}
+
+pub unsafe extern "C" fn vImageCVImageFormat_Create(
+    formatType: u32,
+    _matrix: *const vImage_ARGBToYpCbCrMatrix,
+    _chromaSiting: CFTypeRef,
+    colorSpace: CFTypeRef,
+    _baseClass: *const c_void,
+) -> *mut c_void {
+    if !colorSpace.is_null() {
+        unsafe { corefoundation::api::CFRetain(colorSpace) };
+    }
+    Box::into_raw(Box::new(CvFormat {
+        pixel_format: formatType,
+        color_space: colorSpace,
+    }))
+    .cast()
+}
+
+pub unsafe extern "C" fn vImageCVImageFormat_CreateWithCVPixelBuffer(
+    buffer: CFTypeRef,
+) -> *mut c_void {
+    if buffer.is_null() {
+        return ptr::null_mut();
+    }
+    let fourcc = unsafe { corevideo::pixel_buffer::CVPixelBufferGetPixelFormatType(buffer) };
+    Box::into_raw(Box::new(CvFormat {
+        pixel_format: fourcc,
+        color_space: ptr::null(),
+    }))
+    .cast()
+}
+
+pub unsafe extern "C" fn vImageCVImageFormat_SetColorSpace(
+    format: *mut c_void,
+    colorSpace: CFTypeRef,
+) -> vImage_Error {
+    if format.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    let f = unsafe { &mut *format.cast::<CvFormat>() };
+    if !f.color_space.is_null() {
+        unsafe { corefoundation::api::CFRelease(f.color_space) };
+    }
+    if !colorSpace.is_null() {
+        unsafe { corefoundation::api::CFRetain(colorSpace) };
+    }
+    f.color_space = colorSpace;
+    kvImageNoError
+}
+
+pub unsafe extern "C" fn vImageCVImageFormat_Release(format: *mut c_void) {
+    if !format.is_null() {
+        let boxed = unsafe { Box::from_raw(format.cast::<CvFormat>()) };
+        if !boxed.color_space.is_null() {
+            unsafe { corefoundation::api::CFRelease(boxed.color_space) };
+        }
+    }
+}
