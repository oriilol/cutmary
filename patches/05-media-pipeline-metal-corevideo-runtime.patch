+
+unsafe fn rgb888_to_4ch(
+    src: *const vImage_Buffer,
+    alpha_src: *const vImage_Buffer,
+    alpha: u8,
+    dest: *const vImage_Buffer,
+    premultiply: u8,
+    order: [usize; 4], // indices in [R, G, B, A]
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    let a_buf = if alpha_src.is_null() {
+        None
+    } else {
+        valid_buf(alpha_src)
+    };
+    let premul = premultiply != 0;
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        let ar = a_buf.as_ref().map(|ab| unsafe { row_ptr(ab, y) });
+        for x in 0..s.width {
+            let mut r = unsafe { *sr.add(x * 3) };
+            let mut g = unsafe { *sr.add(x * 3 + 1) };
+            let mut b = unsafe { *sr.add(x * 3 + 2) };
+            let a = match ar {
+                Some(p) => unsafe { *p.add(x) },
+                None => alpha,
+            };
+            if premul {
+                r = premul_channel(r, a);
+                g = premul_channel(g, a);
+                b = premul_channel(b, a);
+            }
+            let rgba = [r, g, b, a];
+            unsafe {
+                *dr.add(x * 4) = rgba[order[0]];
+                *dr.add(x * 4 + 1) = rgba[order[1]];
+                *dr.add(x * 4 + 2) = rgba[order[2]];
+                *dr.add(x * 4 + 3) = rgba[order[3]];
+            }
+        }
+    }
+    kvImageNoError
+}
+
+unsafe fn ch4_to_rgb888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    rgb_idx: [usize; 3],
+) -> vImage_Error {
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if s.width != d.width || s.height != d.height {
+        return kvImageBufferSizeMismatch;
+    }
+    for y in 0..s.height {
+        let sr = unsafe { row_ptr(&s, y) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..s.width {
+            unsafe {
+                *dr.add(x * 3) = *sr.add(x * 4 + rgb_idx[0]);
+                *dr.add(x * 3 + 1) = *sr.add(x * 4 + rgb_idx[1]);
+                *dr.add(x * 3 + 2) = *sr.add(x * 4 + rgb_idx[2]);
+            }
+        }
+    }
+    kvImageNoError
+}
