+    R_Yp: 0.299,
+    G_Yp: 0.587,
+    B_Yp: 0.114,
+    R_Cb: -0.168736,
+    G_Cb: -0.331264,
+    B_Cb_R_Cr: 0.5,
+    G_Cr: -0.418688,
+    B_Cr: -0.081312,
+};
+
+static MATRIX_ARGB_TO_YCBCR_709: vImage_ARGBToYpCbCrMatrix = vImage_ARGBToYpCbCrMatrix {
+    R_Yp: 0.2126,
+    G_Yp: 0.7152,
+    B_Yp: 0.0722,
+    R_Cb: -0.114572,
+    G_Cb: -0.385428,
+    B_Cb_R_Cr: 0.5,
+    G_Cr: -0.454153,
+    B_Cr: -0.045847,
+};
+
+static MATRIX_YCBCR_TO_ARGB_601: vImage_YpCbCrToARGBMatrix = vImage_YpCbCrToARGBMatrix {
+    Yp: 1.0,
+    Cr_R: 1.402,
+    Cr_G: -0.714136,
+    Cb_G: -0.344136,
