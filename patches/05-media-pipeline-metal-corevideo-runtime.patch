+                    &MATRIX_YCBCR_TO_ARGB_709,
+                    &range,
+                    to_rgb.as_mut_ptr().cast(),
+                    0,
+                    0,
+                    0,
+                )
+            },
+            kvImageNoError
+        );
+        assert_eq!(
+            unsafe {
+                vImageConvert_ARGB8888To420Yp8_CbCr8(
+                    &d_argb,
+                    &y_buf,
+                    &uv_buf,
+                    to_yuv.as_ptr().cast(),
+                    ptr::null(),
+                    0,
+                )
+            },
+            kvImageNoError
+        );
+        let mut out_argb = [0u8; 16];
+        let out_buf = vImage_Buffer {
+            data: out_argb.as_mut_ptr().cast(),
+            width: 2,
+            height: 2,
+            rowBytes: 8,
+        };
+        assert_eq!(
