+/// Decodes a `CGImage` bitmap_info into (channel order for R,G,B,A in memory,
+/// premultiplied, has_alpha, bpp_bytes).
+#[derive(Clone, Copy, Debug)]
+struct PixelLayout {
+    bpp: usize, // bytes per pixel: 1, 3, or 4
+    /// Memory byte index for [R, G, B, A] (when bpp == 4 or 3).
+    rgba_idx: [usize; 4],
+    premultiplied: bool,
+    has_alpha: bool,
+}
+
+fn layout_from_cg_format(bpc: u32, bpp: u32, bitmap_info: u32) -> PixelLayout {
+    let bytes = ((bpp as usize).max(bpc as usize)).div_ceil(8).clamp(1, 4);
+    let alpha_info = bitmap_info & 0x1F;
+    let byte_order = bitmap_info & 0x7000;
+    let little_32 = byte_order == 0x2000; // kCGBitmapByteOrder32Little
+    // kCGImageAlphaNone=0, PremultipliedLast=1, PremultipliedFirst=2,
+    // Last=3, First=4, NoneSkipLast=5, NoneSkipFirst=6, Only=7
+    let premultiplied = matches!(alpha_info, 1 | 2);
+    let has_alpha = matches!(alpha_info, 1 | 2 | 3 | 4 | 7);
+    let alpha_first = matches!(alpha_info, 2 | 4 | 6);
+    let rgba_idx = match (bytes, alpha_first, little_32) {
+        (4, false, false) => [0, 1, 2, 3], // RGBA (big/default)
+        (4, true, false) => [1, 2, 3, 0],  // ARGB (big/default)
+        (4, true, true) => [2, 1, 0, 3],   // BGRA (32Little + First = memory B,G,R,A)
+        (4, false, true) => [3, 2, 1, 0],  // ABGR (32Little + Last  = memory A,B,G,R)
+        (3, _, true) => [2, 1, 0, 3],      // BGR
+        (3, _, false) => [0, 1, 2, 3],     // RGB
+        _ => [0, 0, 0, 0],                 // Planar8 / Gray
+    };
+    PixelLayout {
+        bpp: bytes,
+        rgba_idx,
+        premultiplied,
+        has_alpha,
+    }
+}
+
+#[inline]
+unsafe fn read_rgba(row: *const u8, x: usize, layout: PixelLayout) -> [u8; 4] {
+    match layout.bpp {
+        4 => {
+            let off = x * 4;
+            let raw = unsafe {
+                [
+                    *row.add(off),
+                    *row.add(off + 1),
+                    *row.add(off + 2),
+                    *row.add(off + 3),
+                ]
+            };
+            let a = if layout.has_alpha {
+                raw[layout.rgba_idx[3]]
+            } else {
+                255
+            };
+            let mut r = raw[layout.rgba_idx[0]];
+            let mut g = raw[layout.rgba_idx[1]];
+            let mut b = raw[layout.rgba_idx[2]];
+            if layout.premultiplied {
+                r = unpremul_channel(r, a);
+                g = unpremul_channel(g, a);
+                b = unpremul_channel(b, a);
+            }
+            [r, g, b, a]
+        }
+        3 => {
+            let off = x * 3;
+            let raw = unsafe { [*row.add(off), *row.add(off + 1), *row.add(off + 2)] };
+            [
+                raw[layout.rgba_idx[0]],
+                raw[layout.rgba_idx[1]],
+                raw[layout.rgba_idx[2]],
+                255,
+            ]
+        }
+        _ => {
+            let v = unsafe { *row.add(x) };
+            [v, v, v, 255]
+        }
+    }
+}
+
+#[inline]
+unsafe fn write_rgba(row: *mut u8, x: usize, rgba: [u8; 4], layout: PixelLayout) {
+    let [mut r, mut g, mut b, mut a] = rgba;
+    if !layout.has_alpha {
+        a = 255;
+    } else if layout.premultiplied {
+        r = premul_channel(r, a);
+        g = premul_channel(g, a);
+        b = premul_channel(b, a);
+    }
+    match layout.bpp {
+        4 => {
+            let off = x * 4;
+            unsafe {
+                *row.add(off + layout.rgba_idx[0]) = r;
+                *row.add(off + layout.rgba_idx[1]) = g;
+                *row.add(off + layout.rgba_idx[2]) = b;
+                *row.add(off + layout.rgba_idx[3]) = a;
+            }
+        }
+        3 => {
+            let off = x * 3;
+            unsafe {
+                *row.add(off + layout.rgba_idx[0]) = r;
+                *row.add(off + layout.rgba_idx[1]) = g;
+                *row.add(off + layout.rgba_idx[2]) = b;
+            }
+        }
+        _ => {
+            let luma = ((u32::from(r) * 77 + u32::from(g) * 150 + u32::from(b) * 29) >> 8) as u8;
+            unsafe { *row.add(x) = luma };
+        }
+    }
+}
+
+unsafe extern "C" fn free_libc_buffer(_info: *mut c_void, data: *const c_void, _size: usize) {
+    if !data.is_null() {
+        unsafe { libc::free(data.cast_mut()) };
+    }
+}
+
+pub unsafe extern "C" fn vImageBuffer_InitWithCGImage(
+    buf: *mut vImage_Buffer,
+    format: *mut vImage_CGImageFormat,
+    _backgroundColor: *const f64,
+    image: CFTypeRef,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if buf.is_null() || format.is_null() || image.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    let w = unsafe { appkit::graphics::CGImageGetWidth(image) };
+    let h = unsafe { appkit::graphics::CGImageGetHeight(image) };
+    let src_bpc = unsafe { appkit::graphics::CGImageGetBitsPerComponent(image) } as u32;
+    let src_bpp = unsafe { appkit::graphics::CGImageGetBitsPerPixel(image) } as u32;
+    let src_bpr = unsafe { appkit::graphics::CGImageGetBytesPerRow(image) };
+    let src_info = unsafe { appkit::graphics::CGImageGetBitmapInfo(image) };
+    let provider = unsafe { appkit::graphics::CGImageGetDataProvider(image) };
+
+    let fmt = unsafe { &mut *format };
+    if fmt.bitsPerComponent == 0 {
+        fmt.bitsPerComponent = src_bpc.max(8);
+    }
+    if fmt.bitsPerPixel == 0 {
+        fmt.bitsPerPixel = src_bpp.max(32);
+    }
+    let dst_layout = layout_from_cg_format(fmt.bitsPerComponent, fmt.bitsPerPixel, fmt.bitmapInfo);
+    let src_layout = layout_from_cg_format(src_bpc, src_bpp, src_info);
+
+    let err = unsafe { vImageBuffer_Init(buf, h, w, fmt.bitsPerPixel, flags) };
+    if err != kvImageNoError || (flags & kvImageNoAllocate) != 0 {
+        return err;
+    }
+    let Some(src_bytes) = appkit::graphics::provider_bytes(provider) else {
+        return kvImageNoError;
+    };
+    let d = unsafe { *buf };
+    for y in 0..h {
+        let s_off = y * src_bpr;
+        if s_off + w * src_layout.bpp > src_bytes.len() {
+            break;
+        }
+        let sr = unsafe { src_bytes.as_ptr().add(s_off) };
+        let dr = unsafe { row_ptr_mut(&d, y) };
+        for x in 0..w {
+            let rgba = unsafe { read_rgba(sr, x, src_layout) };
+            unsafe { write_rgba(dr, x, rgba, dst_layout) };
+        }
+    }
+    kvImageNoError
+}
+
+pub unsafe extern "C" fn vImageCreateCGImageFromBuffer(
+    buf: *const vImage_Buffer,
+    format: *const vImage_CGImageFormat,
+    callback: Option<unsafe extern "C" fn(*mut c_void, *mut c_void)>,
+    userData: *mut c_void,
+    flags: vImage_Flags,
+    error: *mut vImage_Error,
+) -> CFTypeRef {
+    let set_err = |e: vImage_Error| {
+        if !error.is_null() {
+            unsafe { *error = e };
+        }
+    };
+    let Some(b) = valid_buf(buf) else {
+        set_err(kvImageNullPointerArgument);
+        return ptr::null();
+    };
+    if format.is_null() {
+        set_err(kvImageNullPointerArgument);
+        return ptr::null();
+    }
+    let fmt = unsafe { *format };
+    let total = b.height.saturating_mul(b.rowBytes);
+    let provider = if (flags & kvImageNoAllocate) != 0 {
+        // Wrap caller's buffer directly. If caller supplied a callback, invoke it
+        // via a small trampoline wrapper.
+        if let Some(cb) = callback {
+            struct UserRelease {
+                cb: unsafe extern "C" fn(*mut c_void, *mut c_void),
+                user_data: *mut c_void,
+            }
+            unsafe extern "C" fn call_user(info: *mut c_void, data: *const c_void, _size: usize) {
+                if !info.is_null() {
+                    let boxed = unsafe { Box::from_raw(info.cast::<UserRelease>()) };
+                    unsafe { (boxed.cb)(boxed.user_data, data.cast_mut()) };
+                }
+            }
+            let info = Box::into_raw(Box::new(UserRelease {
+                cb,
+                user_data: userData,
+            }))
+            .cast();
+            unsafe {
+                appkit::graphics::CGDataProviderCreateWithData(info, b.data, total, Some(call_user))
+            }
+        } else {
+            unsafe {
+                appkit::graphics::CGDataProviderCreateWithData(
+                    ptr::null_mut(),
+                    b.data,
+                    total,
+                    None,
+                )
+            }
+        }
+    } else {
+        let copy = unsafe { libc::malloc(total.max(1)) };
+        if copy.is_null() {
+            set_err(kvImageMemoryAllocationError);
+            return ptr::null();
+        }
+        if total > 0 && !b.data.is_null() {
+            unsafe { ptr::copy_nonoverlapping(b.data.cast::<u8>(), copy.cast::<u8>(), total) };
+        }
+        unsafe {
+            appkit::graphics::CGDataProviderCreateWithData(
+                ptr::null_mut(),
+                copy,
+                total,
+                Some(free_libc_buffer),
+            )
+        }
+    };
+
+    let own_cs = fmt.colorSpace.is_null();
+    let cs = if own_cs {
+        unsafe { appkit::graphics::CGColorSpaceCreateDeviceRGB() }
+    } else {
+        fmt.colorSpace
+    };
+    let image = unsafe {
+        appkit::graphics::CGImageCreate(
+            b.width,
+            b.height,
+            fmt.bitsPerComponent as usize,
+            fmt.bitsPerPixel as usize,
+            b.rowBytes,
+            cs,
+            fmt.bitmapInfo,
+            provider,
+            fmt.decode,
+            1,
+            fmt.renderingIntent,
+        )
+    };
+    unsafe { appkit::graphics::CGDataProviderRelease(provider) };
+    if own_cs && !cs.is_null() {
+        unsafe { corefoundation::api::CFRelease(cs) };
+    }
+    set_err(if image.is_null() {
+        kvImageInvalidParameter
+    } else {
+        kvImageNoError
+    });
+    image
+}
