+
+fn read_yuv_to_argb_info(info: *const c_void) -> YuvToArgbInfo {
+    if !info.is_null() {
+        let loaded = unsafe { ptr::read_unaligned(info.cast::<YuvToArgbInfo>()) };
+        if loaded.magic == MAGIC_YUV_TO_ARGB {
+            return loaded;
+        }
+    }
+    YuvToArgbInfo {
+        yp: MATRIX_YCBCR_TO_ARGB_709.Yp,
+        cr_r: MATRIX_YCBCR_TO_ARGB_709.Cr_R,
+        cr_g: MATRIX_YCBCR_TO_ARGB_709.Cr_G,
+        cb_g: MATRIX_YCBCR_TO_ARGB_709.Cb_G,
+        cb_b: MATRIX_YCBCR_TO_ARGB_709.Cb_B,
+        yp_bias: 16,
+        cbcr_bias: 128,
+        yp_range: 219,
+        cbcr_range: 224,
+        magic: MAGIC_YUV_TO_ARGB,
+    }
+}
+
+fn read_argb_to_yuv_info(info: *const c_void) -> ArgbToYuvInfo {
+    if !info.is_null() {
+        let loaded = unsafe { ptr::read_unaligned(info.cast::<ArgbToYuvInfo>()) };
+        if loaded.magic == MAGIC_ARGB_TO_YUV {
+            return loaded;
+        }
+    }
+    let m = MATRIX_ARGB_TO_YCBCR_709;
+    let q = |f: f32| (f * 4096.0).round() as i16;
+    ArgbToYuvInfo {
+        r_yp: q(m.R_Yp),
+        g_yp: q(m.G_Yp),
+        b_yp: q(m.B_Yp),
+        r_cb: q(m.R_Cb),
+        g_cb: q(m.G_Cb),
+        b_cb_r_cr: q(m.B_Cb_R_Cr),
+        g_cr: q(m.G_Cr),
+        b_cr: q(m.B_Cr),
+        yp_bias: 16,
+        cbcr_bias: 128,
+        yp_scale: 219,
+        cbcr_scale: 224,
+        yp_min: 16,
+        yp_max: 235,
+        cbcr_min: 16,
+        cbcr_max: 240,
+        magic: MAGIC_ARGB_TO_YUV,
+    }
+}
+
+#[inline]
+fn yuv_to_rgb_px(y: u8, cb: u8, cr: u8, info: &YuvToArgbInfo) -> [u8; 3] {
+    let yf = ((f32::from(y) - f32::from(info.yp_bias)) / f32::from(info.yp_range.max(1))) * info.yp;
+    let cbf = (f32::from(cb) - f32::from(info.cbcr_bias)) / f32::from(info.cbcr_range.max(1));
+    let crf = (f32::from(cr) - f32::from(info.cbcr_bias)) / f32::from(info.cbcr_range.max(1));
+    let r = (yf + info.cr_r * crf) * 255.0;
+    let g = (yf + info.cr_g * crf + info.cb_g * cbf) * 255.0;
+    let b = (yf + info.cb_b * cbf) * 255.0;
+    [clamp_u8(r), clamp_u8(g), clamp_u8(b)]
+}
+
+#[inline]
+fn rgb_to_yuv_px(r: u8, g: u8, b: u8, info: &ArgbToYuvInfo) -> [u8; 3] {
+    let rf = f32::from(r) / 255.0;
+    let gf = f32::from(g) / 255.0;
+    let bf = f32::from(b) / 255.0;
+    let inv = 1.0 / 4096.0;
+    let yp = (rf * f32::from(info.r_yp) + gf * f32::from(info.g_yp) + bf * f32::from(info.b_yp))
+        * inv
+        * f32::from(info.yp_scale)
+        + f32::from(info.yp_bias);
+    let cb = (rf * f32::from(info.r_cb)
+        + gf * f32::from(info.g_cb)
+        + bf * f32::from(info.b_cb_r_cr))
+        * inv
+        * f32::from(info.cbcr_scale)
+        + f32::from(info.cbcr_bias);
+    let cr = (rf * f32::from(info.b_cb_r_cr)
+        + gf * f32::from(info.g_cr)
+        + bf * f32::from(info.b_cr))
+        * inv
+        * f32::from(info.cbcr_scale)
+        + f32::from(info.cbcr_bias);
+    [
+        yp.round()
+            .clamp(f32::from(info.yp_min), f32::from(info.yp_max)) as u8,
+        cb.round()
+            .clamp(f32::from(info.cbcr_min), f32::from(info.cbcr_max)) as u8,
+        cr.round()
+            .clamp(f32::from(info.cbcr_min), f32::from(info.cbcr_max)) as u8,
+    ]
+}
+
+#[inline]
+fn read_permute_map(map: *const u8) -> [usize; 4] {
+    if map.is_null() {
+        [0, 1, 2, 3]
+    } else {
+        unsafe {
+            [
+                (*map.add(0) & 3) as usize,
+                (*map.add(1) & 3) as usize,
+                (*map.add(2) & 3) as usize,
+                (*map.add(3) & 3) as usize,
+            ]
+        }
+    }
+}
