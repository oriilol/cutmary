+    _flags: vImage_Flags,
+    error: *mut vImage_Error,
+) -> *mut c_void {
+    if srcFormat.is_null() || destFormat.is_null() {
+        if !error.is_null() {
+            unsafe { *error = kvImageNullPointerArgument };
+        }
+        return ptr::null_mut();
+    }
+    let sf = unsafe { *srcFormat };
+    let df = unsafe { *destFormat };
+    finish_converter(
+        Converter {
+            src: EndpointFormat::Cg(layout_from_cg_format(
+                sf.bitsPerComponent,
+                sf.bitsPerPixel,
+                sf.bitmapInfo,
+            )),
+            dst: EndpointFormat::Cg(layout_from_cg_format(
+                df.bitsPerComponent,
+                df.bitsPerPixel,
+                df.bitmapInfo,
+            )),
+        },
+        error,
