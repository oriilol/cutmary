+
+unsafe fn sample_bilinear<const CH: usize>(
+    s: &vImage_Buffer,
+    fx: f64,
+    fy: f64,
+    bg: &[u8; CH],
+    edge_extend: bool,
+) -> [u8; CH] {
+    let sw = s.width as isize;
+    let sh = s.height as isize;
+    if sw <= 0 || sh <= 0 {
+        return *bg;
+    }
+    if !edge_extend && (fx < -0.5 || fy < -0.5 || fx > (sw as f64 - 0.5) || fy > (sh as f64 - 0.5)) {
+        return *bg;
+    }
+    let fx = fx.clamp(0.0, (sw - 1) as f64);
+    let fy = fy.clamp(0.0, (sh - 1) as f64);
+    let x0 = fx.floor() as usize;
+    let y0 = fy.floor() as usize;
+    let x1 = (x0 + 1).min(s.width - 1);
+    let y1 = (y0 + 1).min(s.height - 1);
+    let wx = fx - x0 as f64;
+    let wy = fy - y0 as f64;
+    let r0 = unsafe { row_ptr(s, y0) };
+    let r1 = unsafe { row_ptr(s, y1) };
+    let mut out = [0u8; CH];
+    for c in 0..CH {
+        let p00 = unsafe { *r0.add(x0 * CH + c) } as f64;
+        let p10 = unsafe { *r0.add(x1 * CH + c) } as f64;
+        let p01 = unsafe { *r1.add(x0 * CH + c) } as f64;
+        let p11 = unsafe { *r1.add(x1 * CH + c) } as f64;
+        out[c] = (p00 * (1.0 - wx) * (1.0 - wy)
+            + p10 * wx * (1.0 - wy)
+            + p01 * (1.0 - wx) * wy
+            + p11 * wx * wy)
+            .round()
+            .clamp(0.0, 255.0) as u8;
+    }
+    out
+}
+
+pub unsafe extern "C" fn vImageRotate_ARGB8888(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _tempBuffer: *mut c_void,
+    angleInRadians: f32,
+    backColor: *const u8,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    let bg = if backColor.is_null() {
+        [0u8; 4]
+    } else {
+        unsafe {
+            [
+                *backColor.add(0),
+                *backColor.add(1),
+                *backColor.add(2),
+                *backColor.add(3),
+            ]
+        }
+    };
+    let edge = (flags & kvImageEdgeExtend) != 0;
+    let (sin_a, cos_a) = (f64::from(angleInRadians).sin(), f64::from(angleInRadians).cos());
+    let scx = (s.width as f64 - 1.0) * 0.5;
+    let scy = (s.height as f64 - 1.0) * 0.5;
+    let dcx = (d.width as f64 - 1.0) * 0.5;
+    let dcy = (d.height as f64 - 1.0) * 0.5;
+    for dy in 0..d.height {
+        let dr = unsafe { row_ptr_mut(&d, dy) };
+        let ry = dy as f64 - dcy;
+        for dx in 0..d.width {
+            let rx = dx as f64 - dcx;
+            let sx = rx * cos_a - ry * sin_a + scx;
+            let sy = rx * sin_a + ry * cos_a + scy;
+            let px = unsafe { sample_bilinear::<4>(&s, sx, sy, &bg, edge) };
+            unsafe { ptr::copy_nonoverlapping(px.as_ptr(), dr.add(dx * 4), 4) };
+        }
+    }
+    kvImageNoError
+}
+
+pub unsafe extern "C" fn vImageRotate_Planar8(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    _tempBuffer: *mut c_void,
+    angleInRadians: f32,
+    backColor: u8,
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    let bg = [backColor];
+    let edge = (flags & kvImageEdgeExtend) != 0;
+    let (sin_a, cos_a) = (f64::from(angleInRadians).sin(), f64::from(angleInRadians).cos());
+    let scx = (s.width as f64 - 1.0) * 0.5;
+    let scy = (s.height as f64 - 1.0) * 0.5;
+    let dcx = (d.width as f64 - 1.0) * 0.5;
+    let dcy = (d.height as f64 - 1.0) * 0.5;
+    for dy in 0..d.height {
+        let dr = unsafe { row_ptr_mut(&d, dy) };
+        let ry = dy as f64 - dcy;
+        for dx in 0..d.width {
+            let rx = dx as f64 - dcx;
+            let sx = rx * cos_a - ry * sin_a + scx;
+            let sy = rx * sin_a + ry * cos_a + scy;
+            let px = unsafe { sample_bilinear::<1>(&s, sx, sy, &bg, edge) };
+            unsafe { *dr.add(dx) = px[0] };
+        }
+    }
+    kvImageNoError
+}
+
+unsafe fn affine_warp_impl<const CH: usize>(
+    src: *const vImage_Buffer,
+    dest: *const vImage_Buffer,
+    transform: *const vImage_CGAffineTransform,
+    bg: [u8; CH],
+    flags: vImage_Flags,
+) -> vImage_Error {
+    if (flags & kvImageGetTempBufferSize) != 0 {
+        return 0;
+    }
+    let (Some(s), Some(d)) = (valid_buf(src), valid_buf(dest)) else {
+        return kvImageNullPointerArgument;
+    };
+    if transform.is_null() {
+        return kvImageNullPointerArgument;
+    }
+    let t = unsafe { *transform };
+    let det = t.a * t.d - t.b * t.c;
+    if det.abs() < 1e-12 {
+        return kvImageInvalidParameter;
+    }
+    let inv_a = t.d / det;
+    let inv_b = -t.b / det;
+    let inv_c = -t.c / det;
+    let inv_d = t.a / det;
+    let edge = (flags & kvImageEdgeExtend) != 0;
+
+    // CG/vImage affine transform uses bottom-left Y-up coordinates:
+    // x' = a*x + c*y + tx, y' = b*x + d*y + ty
+    let sh = s.height as f64;
+    let dh = d.height as f64;
+    for dy in 0..d.height {
+        let dr = unsafe { row_ptr_mut(&d, dy) };
+        let y_prime = (dh - 1.0) - dy as f64 - t.ty;
+        for dx in 0..d.width {
+            let x_prime = dx as f64 - t.tx;
+            let sx = inv_a * x_prime + inv_c * y_prime;
+            let sy_cg = inv_b * x_prime + inv_d * y_prime;
+            let sy = (sh - 1.0) - sy_cg;
+            let px = unsafe { sample_bilinear::<CH>(&s, sx, sy, &bg, edge) };
+            unsafe { ptr::copy_nonoverlapping(px.as_ptr(), dr.add(dx * CH), CH) };
+        }
+    }
+    kvImageNoError
+}
+
+pub unsafe extern "C" fn vImageAffineWarpCG_ARGB8888(
