+fn is_exact_immutable_nsstring_class(class: Id) -> bool {
+    if class.is_null() {
+        return false;
+    }
+    // SAFETY: `class` is the `Class` receiver of an `NSString` class method.
+    unsafe { objc::class::from_ptr(class.cast()) }.is_some_and(|c| c.name_str() == "NSString")
+}
+
+unsafe fn mutable_copy_and_release(immutable: CFTypeRef) -> Id {
+    if immutable.is_null() {
+        return std::ptr::null_mut();
+    }
+    // SAFETY: `immutable` is a live `CFString` just created by the caller.
+    let mutable = unsafe {
+        corefoundation::string::as_string(immutable)
+            .map(corefoundation::string::new_mutable_copy)
+            .unwrap_or(std::ptr::null())
+    };
+    unsafe { api::CFRelease(immutable) };
+    if mutable.is_null() {
+        return std::ptr::null_mut();
+    }
+    unsafe { api::CFAutorelease(mutable) as Id }
+}
+
+unsafe extern "C" fn string_with_utf8(class: Id, _sel: Sel, cstr: *const c_char) -> Id {
     // SAFETY: a NUL-terminated string or null.
     unsafe {
+        if is_mutable_receiver(class) {
+            let s = api::CFStringCreateWithCString(std::ptr::null(), cstr, encoding::UTF8);
+            return mutable_copy_and_release(s);
+        }
+        if is_exact_immutable_nsstring_class(class)
+            && let Some(bytes) = corefoundation::string::cstr_bytes(cstr)
+            && let Some(interned) = corefoundation::string::intern_short_ascii(bytes)
+        {
+            return interned as Id;
+        }
         let s = api::CFStringCreateWithCString(std::ptr::null(), cstr, encoding::UTF8);
