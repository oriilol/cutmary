+    /// `-pathForResource:ofType:inDirectory:forLocalization:`.
+    pub fn resource_in_localization(
+        &self,
+        name: &str,
+        extension: &str,
+        directory: &str,
+        localization: &str,
+    ) -> Option<PathBuf> {
+        let leaf = match extension.is_empty() {
+            true => name.to_string(),
+            false => format!("{name}.{extension}"),
+        };
+        if !localization.is_empty() {
+            let loc_dir = self.resources.join(format!("{localization}.lproj"));
+            let candidate = loc_dir.join(directory).join(&leaf);
+            if candidate.exists() {
+                return Some(candidate);
+            }
+        }
+        self.resource_in(name, extension, directory)
+    }
