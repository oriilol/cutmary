+/// `-[NSData writeToFile:options:error:]`.
+unsafe extern "C" fn write_to_file_options_error(
+    receiver: Id,
+    _sel: Sel,
+    path: Id,
+    options: u64,
+    error: *mut Id,
+) -> u8 {
+    const NS_DATA_WRITING_ATOMIC: u64 = 1 << 0;
+    const NS_DATA_WRITING_WITHOUT_OVERWRITING: u64 = 1 << 1;
+
+    let set_error = |code: i64, msg: &str| {
+        if !error.is_null() {
+            unsafe {
+                *error = crate::error::make("NSCocoaErrorDomain", code, msg);
+            }
+        }
+    };
+
+    let path_bytes = unsafe { crate::string::bytes(path) };
+    let Ok(path_str) = String::from_utf8(path_bytes) else {
+        set_error(512, "Invalid file path.");
+        return 0;
+    };
+    let Some(bytes) = (unsafe { collections::data(receiver as CFTypeRef) }) else {
+        set_error(512, "Invalid NSData receiver.");
+        return 0;
+    };
+    if (options & NS_DATA_WRITING_WITHOUT_OVERWRITING) != 0
+        && prefix::ns::host_path(&path_str).exists()
+    {
+        set_error(516, "The file already exists.");
+        return 0;
+    }
+    let atomically = (options & NS_DATA_WRITING_ATOMIC) != 0;
+    match write_bytes_to_file(&path_str, bytes, atomically) {
+        Ok(()) => {
+            if !error.is_null() {
+                unsafe { *error = std::ptr::null_mut() };
+            }
+            1
+        }
+        Err(e) => {
+            set_error(512, &e.to_string());
+            0
+        }
+    }
