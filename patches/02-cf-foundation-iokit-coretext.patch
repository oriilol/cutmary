+    _scope: u32,
+    error: *mut CFTypeRef,
+) -> u8 {
+    if !error.is_null() {
+        unsafe { error.write(std::ptr::null()) };
+    }
+    let Some(path) = (unsafe { corefoundation::url::as_url(font_url) }).and_then(|u| u.file_path())
