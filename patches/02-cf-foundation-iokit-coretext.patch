+/// `NSStringEncoding CFStringConvertEncodingToNSStringEncoding(CFStringEncoding)`.
+pub unsafe extern "C" fn CFStringConvertEncodingToNSStringEncoding(encoding: u32) -> usize {
+    match encoding {
+        0x0600 => 1,          // kCFStringEncodingASCII -> NSASCIIStringEncoding
+        0x0B01 => 2,          // kCFStringEncodingNextStepLatin -> NSNEXTSTEPStringEncoding
+        0x0920 => 3,          // kCFStringEncodingEUC_JP -> NSJapaneseEUCStringEncoding
+        0x0800_0100 => 4,     // kCFStringEncodingUTF8 -> NSUTF8StringEncoding
+        0x0201 => 5,          // kCFStringEncodingISOLatin1 -> NSISOLatin1StringEncoding
+        0x0006 => 6,          // kCFStringEncodingMacSymbol -> NSSymbolStringEncoding
+        0x0BFF => 7,          // kCFStringEncodingNonLossyASCII -> NSNonLossyASCIIStringEncoding
+        0x0A01 => 8,          // kCFStringEncodingShiftJIS -> NSShiftJISStringEncoding
+        0x0202 => 9,          // kCFStringEncodingISOLatin2 -> NSISOLatin2StringEncoding
+        0x0100 => 10,         // kCFStringEncodingUTF16 -> NSUnicodeStringEncoding
+        0x0502 => 11,         // kCFStringEncodingWindowsCyrillic -> NSWindowsCP1251StringEncoding
+        0x0500 => 12,         // kCFStringEncodingWindowsLatin1 -> NSWindowsCP1252StringEncoding
+        0x0503 => 13,         // kCFStringEncodingWindowsGreek -> NSWindowsCP1253StringEncoding
+        0x0504 => 14,         // kCFStringEncodingWindowsLatin5 -> NSWindowsCP1254StringEncoding
+        0x0501 => 15,         // kCFStringEncodingWindowsLatin2 -> NSWindowsCP1250StringEncoding
+        0x0820 => 21,         // kCFStringEncodingISO_2022_JP -> NSISO2022JPStringEncoding
+        0x0000 => 30,         // kCFStringEncodingMacRoman -> NSMacOSRomanStringEncoding
+        0xFFFF_FFFF => 0,     // kCFStringEncodingInvalidId -> 0
+        other => 0x8000_0000 | (other as usize),
+    }
+}
+
+/// `CFStringEncoding CFStringConvertNSStringEncodingToEncoding(NSStringEncoding)`.
+pub unsafe extern "C" fn CFStringConvertNSStringEncodingToEncoding(encoding: usize) -> u32 {
+    match encoding {
+        1 => 0x0600,
+        2 => 0x0B01,
+        3 => 0x0920,
+        4 => 0x0800_0100,
+        5 => 0x0201,
+        6 => 0x0006,
+        7 => 0x0BFF,
+        8 => 0x0A01,
+        9 => 0x0202,
+        10 => 0x0100,
+        11 => 0x0502,
+        12 => 0x0500,
+        13 => 0x0503,
+        14 => 0x0504,
+        15 => 0x0501,
+        21 => 0x0820,
+        30 => 0x0000,
+        other if (other & 0x8000_0000) != 0 => (other & !0x8000_0000) as u32,
+        _ => INVALID_ENCODING,
+    }
+}
