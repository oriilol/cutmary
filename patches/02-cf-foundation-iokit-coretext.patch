+/// `CFMutableArrayRef CFArrayCreateMutableCopy(CFAllocatorRef, CFIndex, CFArrayRef)`.
+pub unsafe extern "C" fn CFArrayCreateMutableCopy(
+    _allocator: CFAllocatorRef,
+    _capacity: CFIndex,
+    array: CFTypeRef,
+) -> CFTypeRef {
+    let Some(a) = (unsafe { collections::array(array) }) else {
+        return std::ptr::null();
+    };
+    let values = a.values.clone();
+    collections::new_array(&values, a.policy, true)
+}
+
+/// `void CFArrayReplaceValues(CFMutableArrayRef, CFRange, const void **, CFIndex)`.
+pub unsafe extern "C" fn CFArrayReplaceValues(
+    array: CFTypeRef,
+    range_location: CFIndex,
+    range_length: CFIndex,
+    new_values: *const CFTypeRef,
+    new_count: CFIndex,
+) {
+    let Some(a) = (unsafe { collections::array(array) }) else {
+        return;
+    };
+    if !a.mutable || range_location < 0 || range_length < 0 || new_count < 0 {
+        return;
+    }
+    let start = (range_location as usize).min(a.values.len());
+    let end = start.saturating_add(range_length as usize).min(a.values.len());
+    let mut retained = Vec::with_capacity(new_count as usize);
+    if new_count > 0 && !new_values.is_null() {
+        let slice = unsafe { std::slice::from_raw_parts(new_values, new_count as usize) };
+        for &v in slice {
+            retained.push(a.policy.retain(v));
+        }
+    }
+    let removed: Vec<CFTypeRef> = a.values.splice(start..end, retained).collect();
+    for v in removed {
+        a.policy.release(v);
+    }
+}
