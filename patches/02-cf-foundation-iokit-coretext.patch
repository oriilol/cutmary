+/// Intern a short immutable ASCII string as an immortal `__NSCFConstantString`.
+///
+/// On 64-bit macOS, Foundation represents short immutable ASCII `NSString`s
+/// (up to 9 ASCII characters in 6-bit/7-bit packing, e.g. shader entry points
+/// like `"main0"`) as tagged pointers (`NSTaggedPointerString`), for which
+/// `retain`, `release`, and `autorelease` are no-ops. Some macOS MRC callers
+/// (notably Qt 6.2's `QRhiMetal`) over-release the result of
+/// `+[NSString stringWithUTF8String:]` and only survive on macOS because short
+/// ASCII strings are tagged pointers.
+///
+/// No artificial entry cap is imposed here because falling back to a normal
+/// heap `__NSCFString` after hitting a cap would re-introduce the double-free
+/// in long-running sessions; memory usage is bounded by the number of distinct
+/// short ASCII strings created through exact `NSString` class constructors.
+/// Medium-term, native tagged-pointer support across `objc`/`corefoundation`
+/// can supersede this table entirely.
+pub fn intern_short_ascii(bytes: &[u8]) -> Option<CFTypeRef> {
+    const MAX_LEN: usize = 9;
+    if bytes.len() > MAX_LEN || !bytes.is_ascii() {
+        return None;
+    }
+    static INTERNED: LazyLock<Mutex<HashMap<Vec<u8>, usize>>> =
+        LazyLock::new(|| Mutex::new(HashMap::new()));
+    let mut table = INTERNED.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(&ptr) = table.get(bytes) {
+        return Some(ptr as CFTypeRef);
+    }
+    let text = std::str::from_utf8(bytes).ok()?;
+    let ptr = immortal(text);
+    objc::arc::make_immortal(ptr as objc::object::Id);
+    table.insert(bytes.to_vec(), ptr as usize);
+    Some(ptr)
+}
+
