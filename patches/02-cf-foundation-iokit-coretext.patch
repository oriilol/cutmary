+/// `CFStringRef __CFStringMakeConstantString(const char *cStr)`.
+pub unsafe extern "C" fn __CFStringMakeConstantString(cstr: *const c_char) -> CFTypeRef {
+    if cstr.is_null() {
+        return string::from_bytes(&[], false);
+    }
+    let bytes = unsafe { std::ffi::CStr::from_ptr(cstr) }.to_bytes();
+    string::from_bytes(bytes, false)
+}
