+++ b/crates/foundation/tests/string_init.rs
@@ -79,3 +79,57 @@ fn init_with_characters_returns_an_owned_string() {
     });
     assert_eq!(owned, 1);
 }
+
+fn call_string_with_utf8(class_name: &std::ffi::CStr, text: &std::ffi::CStr) -> Id {
+    let class = objc::class::lookup(class_name).expect("class registered");
+    let sel = objc::sel::get("stringWithUTF8String:");
+    let imp = class.metaclass().method(sel).unwrap().implementation();
+    unsafe {
+        let f: unsafe extern "C" fn(Id, Sel, *const std::ffi::c_char) -> Id =
+            std::mem::transmute_copy(&imp);
+        f(objc::class::ptr(class).cast(), sel, text.as_ptr())
+    }
+}
+
+#[test]
+fn string_with_utf8_interns_short_ascii_only_for_exact_nsstring() {
+    foundation::bootstrap();
+    let pool = objc::arc::pool_push();
+
+    let s1 = call_string_with_utf8(c"NSString", c"main0");
+    let s2 = call_string_with_utf8(c"NSString", c"main0");
+    assert_eq!(s1, s2);
+    // Over-releasing an interned short ASCII NSString must be safe (no-op).
+    objc::arc::release(s1);
+    objc::arc::release(s1);
+    assert_eq!(unsafe { foundation::string::bytes(s1) }, b"main0");
+
+    // +[NSMutableString stringWithUTF8String:] must return a fresh mutable object.
+    let m1 = call_string_with_utf8(c"NSMutableString", c"main0");
+    let m2 = call_string_with_utf8(c"NSMutableString", c"main0");
+    assert_ne!(m1, s1);
+    assert_ne!(m1, m2);
+    let suffix = foundation::string::from_str("_edit");
+    let (append_sel, append_imp) = implementation(m1, "appendString:");
+    unsafe {
+        let f: unsafe extern "C" fn(Id, Sel, Id) = std::mem::transmute(append_imp);
+        f(m1, append_sel, suffix);
+        assert_eq!(foundation::string::bytes(m1), b"main0_edit");
+        assert_eq!(foundation::string::bytes(m2), b"main0");
+        assert_eq!(foundation::string::bytes(s1), b"main0");
+    }
+    objc::arc::release(suffix);
+
+    // Custom NSString subclass must not receive the interned constant string.
+    let ns_string = objc::class::lookup(c"NSString").unwrap();
+    if objc::class::lookup(c"TestCustomNSStringSub").is_none() {
+        let sub = objc::class::allocate_pair(Some(ns_string), c"TestCustomNSStringSub", 0)
+            .expect("subclass allocated");
+        objc::class::register_pair(sub);
+    }
+    let sub_str = call_string_with_utf8(c"TestCustomNSStringSub", c"main0");
+    assert_ne!(sub_str, s1);
+    assert_eq!(unsafe { foundation::string::bytes(sub_str) }, b"main0");
+
+    objc::arc::pool_pop(pool);
+}
