+/// `void CFDictionaryRemoveValue(CFMutableDictionaryRef, const void *key)`.
+pub unsafe extern "C" fn CFDictionaryRemoveValue(dictionary: CFTypeRef, key: CFTypeRef) {
+    let Some(d) = (unsafe { collections::dictionary(dictionary) }) else {
+        return;
+    };
+    if !d.mutable {
+        return;
+    }
+    d.discard(key);
+}
+
+/// `void CFDictionaryReplaceValue(CFMutableDictionaryRef, const void *key, const void *value)`.
+pub unsafe extern "C" fn CFDictionaryReplaceValue(
+    dictionary: CFTypeRef,
+    key: CFTypeRef,
+    value: CFTypeRef,
+) {
+    let Some(d) = (unsafe { collections::dictionary(dictionary) }) else {
+        return;
+    };
+    if !d.mutable || d.get(key).is_none() {
+        return;
+    }
+    d.set(key, value);
+}
