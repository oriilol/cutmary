+fn base64_encode(input: &[u8], options: usize) -> Vec<u8> {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let line_len = if options & (1 << 0) != 0 {
+        64
+    } else if options & (1 << 1) != 0 {
+        76
+    } else {
+        0
+    };
+    let line_end: &[u8] = if (options & (1 << 4)) != 0 && (options & (1 << 5)) != 0 {
+        b"\r\n"
+    } else if (options & (1 << 4)) != 0 {
+        b"\r"
+    } else if (options & (1 << 5)) != 0 {
+        b"\n"
+    } else {
+        b"\r\n"
+    };
+    let mut raw = Vec::with_capacity(input.len().div_ceil(3) * 4);
+    for chunk in input.chunks(3) {
+        let b0 = chunk[0] as u32;
+        let b1 = *chunk.get(1).unwrap_or(&0) as u32;
+        let b2 = *chunk.get(2).unwrap_or(&0) as u32;
+        let n = (b0 << 16) | (b1 << 8) | b2;
+        raw.push(TABLE[((n >> 18) & 0x3f) as usize]);
+        raw.push(TABLE[((n >> 12) & 0x3f) as usize]);
+        if chunk.len() > 1 {
+            raw.push(TABLE[((n >> 6) & 0x3f) as usize]);
+        } else {
+            raw.push(b'=');
+        }
+        if chunk.len() > 2 {
+            raw.push(TABLE[(n & 0x3f) as usize]);
+        } else {
+            raw.push(b'=');
+        }
+    }
+    if line_len == 0 || raw.len() <= line_len {
+        return raw;
+    }
+    let mut out = Vec::with_capacity(raw.len() + (raw.len() / line_len) * line_end.len());
+    for (i, chunk) in raw.chunks(line_len).enumerate() {
+        if i > 0 {
+            out.extend_from_slice(line_end);
+        }
+        out.extend_from_slice(chunk);
+    }
+    out
+}
