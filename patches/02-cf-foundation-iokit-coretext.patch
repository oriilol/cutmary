+) -> CFTypeRef {
+    if port.is_null() {
+        return std::ptr::null();
+    }
+    // STUB: Mach port messages are not delivered to this run-loop source yet.
+    let context = CFRunLoopSourceContext {
+        version: 0,
+        info: std::ptr::null_mut(),
+        retain: std::ptr::null(),
+        release: std::ptr::null(),
+        copy_description: std::ptr::null(),
+        equal: std::ptr::null(),
+        hash: std::ptr::null(),
+        schedule: std::ptr::null(),
+        cancel: std::ptr::null(),
+        perform: None,
+    };
+    unsafe { CFRunLoopSourceCreate(allocator, order, &context) }
+}
