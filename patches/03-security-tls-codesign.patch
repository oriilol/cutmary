+pub unsafe extern "C" fn SecTrustGetResult(
+    trust: CFTypeRef,
+    out_result: *mut u32,
+    out_cert_chain: *mut CFTypeRef,
+    out_status_chain: *mut *mut c_void,
+) -> OSStatus {
+    let Some(Payload::Trust {
+        chain, last_result, ..
+    }) = (unsafe { payload(trust) })
+    else {
+        return PARAM;
+    };
+    if !out_result.is_null() {
+        unsafe { out_result.write(*last_result) };
+    }
+    if !out_cert_chain.is_null() {
+        let certs: Vec<CFTypeRef> = chain
+            .iter()
+            .map(|der| new(Payload::Certificate(der.clone())))
+            .collect();
+        let arr = corefoundation::collections::new_array(
+            &certs,
+            corefoundation::callbacks::Policy::from_type_callbacks(),
+            false,
+        );
+        for c in certs {
+            unsafe { corefoundation::api::CFRelease(c) };
+        }
+        unsafe { out_cert_chain.write(arr) };
+    }
+    if !out_status_chain.is_null() {
+        let info: Vec<AppleEvidenceInfo> = (0..chain.len())
+            .map(|i| AppleEvidenceInfo {
+                status_bits: 0,
+                num_status_codes: 0,
+                status_codes: std::ptr::null_mut(),
+                index: i as u32,
+                _pad: 0,
+                dl_handle: 0,
+                db_handle: 0,
+                unique_record: std::ptr::null_mut(),
+            })
+            .collect();
