+pub unsafe extern "C" fn SSLRead(
+    ctx: CFTypeRef,
+    data: *mut c_void,
+    data_len: usize,
+    processed: *mut usize,
+) -> i32 {
+    if !processed.is_null() {
+        unsafe { *processed = 0 };
+    }
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    if data_len == 0 {
+        return ERR_SEC_SUCCESS;
+    }
+    if data.is_null() {
+        return ERR_SEC_PARAM;
+    }
+    if inner.conn.is_none() {
+        return ERR_SSL_CLOSED_ABORT;
+    }
+
+    let out = unsafe { std::slice::from_raw_parts_mut(data.cast::<u8>(), data_len) };
+    let mut total = 0usize;
+    loop {
+        if total == data_len {
+            if !processed.is_null() {
+                unsafe { *processed = total };
+            }
+            return ERR_SEC_SUCCESS;
+        }
+        let read_res = {
+            let conn = inner.conn.as_mut().expect("checked above");
+            conn.reader().read(&mut out[total..])
+        };
+        match read_res {
+            Ok(0) => {
+                if !processed.is_null() {
+                    unsafe { *processed = total };
+                }
+                inner.state = SSL_STATE_CLOSED;
+                return if total > 0 {
+                    ERR_SEC_SUCCESS
+                } else {
+                    ERR_SSL_CLOSED_GRACEFUL
+                };
+            }
+            Ok(n) => {
+                total += n;
+                continue;
+            }
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => {}
+            Err(_) => {
+                if !processed.is_null() {
+                    unsafe { *processed = total };
+                }
+                inner.state = SSL_STATE_ABORTED;
+                return ERR_SSL_CLOSED_ABORT;
+            }
+        }
+        let _ = flush_writes(inner);
+        let rst = feed_read(inner);
+        if rst != ERR_SEC_SUCCESS {
+            if !processed.is_null() {
+                unsafe { *processed = total };
+            }
+            return if rst == ERR_SSL_CLOSED_GRACEFUL && total > 0 {
+                ERR_SEC_SUCCESS
+            } else {
+                rst
+            };
+        }
+    }
+}
+
+pub unsafe extern "C" fn SSLWrite(
+    ctx: CFTypeRef,
+    data: *const c_void,
+    data_len: usize,
+    processed: *mut usize,
+) -> i32 {
+    if !processed.is_null() {
+        unsafe { *processed = 0 };
+    }
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    if inner.conn.is_none() {
+        return ERR_SSL_CLOSED_ABORT;
+    }
+    if !inner.pending_write.is_empty() {
+        let wst = flush_writes(inner);
+        if wst != ERR_SEC_SUCCESS {
+            return wst;
+        }
+    }
+    if data_len == 0 {
+        return ERR_SEC_SUCCESS;
+    }
+    if data.is_null() {
+        return ERR_SEC_PARAM;
+    }
+    let slice = unsafe { std::slice::from_raw_parts(data.cast::<u8>(), data_len) };
+    {
+        let conn = inner.conn.as_mut().expect("checked above");
+        if conn.writer().write_all(slice).is_err() {
+            return ERR_SSL_CLOSED_ABORT;
+        }
+    }
+    let wst = flush_writes(inner);
+    if !processed.is_null() {
+        unsafe { *processed = data_len };
+    }
+    if wst == ERR_SSL_WOULD_BLOCK || wst == ERR_SEC_SUCCESS {
+        wst
+    } else {
+        inner.state = SSL_STATE_ABORTED;
+        wst
+    }
+}
