diff --git a/crates/security/src/ssl.rs b/crates/security/src/ssl.rs
new file mode 100644
index 00000000..90cbe154
--- /dev/null
+++ b/crates/security/src/ssl.rs
@@ -0,0 +1,1050 @@
+//! SecureTransport (`SSL*`) backed by `rustls` and PKCS#12 stubs for Qt's
+//! `libqsecuretransportbackend.dylib`.
+//!
+//! Runs real TLS 1.2 / 1.3 handshakes and encrypted reads/writes over the
+//! caller's `SSLSetIOFuncs` non-blocking callbacks, exposes peer certificate
+//! chains via `SSLCopyPeerTrust` (compatible with `SecTrustEvaluate`), and
+//! honors `kSSLSessionOptionBreakOnServerAuth` (`errSSLPeerAuthCompleted`) and
+//! ALPN negotiation.
+
+#![allow(non_snake_case)]
+
+use std::ffi::{c_char, c_int, c_void};
+use std::io::{self, Read, Write};
+use std::sync::{Arc, OnceLock};
+
+use corefoundation::base::CFTypeRef;
+use objc::class::Class;
+use objc::object::Id;
+use objc::sel::Sel;
+use rustls::pki_types::{CertificateDer, ServerName, UnixTime};
+use rustls::{ClientConfig, ClientConnection, ProtocolVersion, RootCertStore};
+
+const ERR_SEC_SUCCESS: i32 = 0;
+const ERR_SEC_PARAM: i32 = -50;
+const ERR_SEC_UNIMPLEMENTED: i32 = -4;
+
+const ERR_SSL_PROTOCOL: i32 = -9800;
+const ERR_SSL_WOULD_BLOCK: i32 = -9803;
+const ERR_SSL_CLOSED_GRACEFUL: i32 = -9805;
+const ERR_SSL_CLOSED_ABORT: i32 = -9806;
+const ERR_SSL_BAD_CERT: i32 = -9808;
+const ERR_SSL_PEER_AUTH_COMPLETED: i32 = -9841;
+
+const SSL_STATE_IDLE: i32 = 0;
+const SSL_STATE_HANDSHAKE: i32 = 1;
+const SSL_STATE_CONNECTED: i32 = 2;
+const SSL_STATE_CLOSED: i32 = 3;
+const SSL_STATE_ABORTED: i32 = 4;
+
+const SSL_PROTOCOL_TLS_1_2: i32 = 8;
+const SSL_PROTOCOL_TLS_1_3: i32 = 10;
+
+const SSL_OPT_BREAK_ON_SERVER_AUTH: i32 = 0;
+
+type SslReadFunc = unsafe extern "C" fn(*const c_void, *mut c_void, *mut usize) -> i32;
+type SslWriteFunc = unsafe extern "C" fn(*const c_void, *const c_void, *mut usize) -> i32;
+
+/// `kSecImport*` global string keys used by `SecPKCS12Import`.
+pub const KEYS: &[(&str, &str)] = &[
+    ("_kSecImportExportKeychain", "keychain"),
+    ("_kSecImportExportPassphrase", "passphrase"),
+    ("_kSecImportItemCertChain", "chain"),
+    ("_kSecImportItemIdentity", "identity"),
+];
+
+/// Standard TLS 1.2 / 1.3 cipher suite IDs reported by `SSLGetSupportedCiphers`.
+const SUPPORTED_CIPHERS: &[u16] = &[
+    0x1301, // TLS_AES_128_GCM_SHA256
+    0x1302, // TLS_AES_256_GCM_SHA384
+    0x1303, // TLS_CHACHA20_POLY1305_SHA256
+    0xC02F, // TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
+    0xC030, // TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
+    0xC02B, // TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
+    0xC02C, // TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
+];
+
+struct SslInner {
+    state: i32,
+    min_version: i32,
+    max_version: i32,
+    negotiated_version: i32,
+    negotiated_cipher: u16,
+    read_func: Option<SslReadFunc>,
+    write_func: Option<SslWriteFunc>,
+    connection: *const c_void,
+    peer_name: Option<String>,
+    alpn_protocols: Vec<Vec<u8>>,
+    break_on_server_auth: bool,
+    peer_auth_done: bool,
+    peer_auth_pending: bool,
+    conn: Option<ClientConnection>,
+    pending_write: Vec<u8>,
+}
+
+impl Default for SslInner {
+    fn default() -> Self {
+        Self {
+            state: SSL_STATE_IDLE,
+            min_version: SSL_PROTOCOL_TLS_1_2,
+            max_version: SSL_PROTOCOL_TLS_1_3,
+            negotiated_version: 0,
+            negotiated_cipher: 0,
+            read_func: None,
+            write_func: None,
+            connection: std::ptr::null(),
+            peer_name: None,
+            alpn_protocols: Vec::new(),
+            break_on_server_auth: false,
+            peer_auth_done: false,
+            peer_auth_pending: false,
+            conn: None,
+            pending_write: Vec::new(),
+        }
+    }
+}
+
+#[repr(C)]
+struct SslContext {
+    _isa: *const Class,
+    inner: *mut SslInner,
+}
+
+fn ssl_context_class() -> &'static Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    let ptr = *CLASS.get_or_init(|| {
+        let class = corefoundation::base::register(
+            c"RosemarySSLContext",
+            None,
+            std::mem::size_of::<SslContext>(),
+            false,
+        );
+        class.replace_method(
+            objc::sel::get("dealloc"),
+            ssl_dealloc as *const c_void,
+            c"v16@0:8",
+        );
+        objc::class::ptr(class) as usize
+    });
+    // SAFETY: registered once for the life of the process.
+    unsafe { &*(ptr as *const Class) }
+}
+
+unsafe extern "C" fn ssl_dealloc(receiver: Id, _sel: Sel) {
+    let ctx = receiver as *mut SslContext;
+    unsafe {
+        if !(*ctx).inner.is_null() {
+            drop(Box::from_raw((*ctx).inner));
+            (*ctx).inner = std::ptr::null_mut();
+        }
+        objc::arc::finalize(receiver);
+    }
+}
+
+unsafe fn inner_mut<'a>(ctx: CFTypeRef) -> Option<&'a mut SslInner> {
+    if ctx.is_null() {
+        return None;
+    }
+    let ptr = unsafe { (*(ctx as *const SslContext)).inner };
+    if ptr.is_null() {
+        None
+    } else {
+        Some(unsafe { &mut *ptr })
+    }
+}
+
+/// Shared root certificate store built once from Mozilla's WebPKI roots.
+fn root_store() -> Arc<RootCertStore> {
+    static ROOTS: OnceLock<Arc<RootCertStore>> = OnceLock::new();
+    ROOTS
+        .get_or_init(|| {
+            let mut roots = RootCertStore::empty();
+            roots.extend(webpki_roots::TLS_SERVER_ROOTS.iter().cloned());
+            Arc::new(roots)
+        })
+        .clone()
+}
+
+/// Certificate verifier used when `kSSLSessionOptionBreakOnServerAuth` is set:
+/// SecureTransport hands the server's certificate chain to the caller via
+/// `errSSLPeerAuthCompleted` + `SSLCopyPeerTrust`, and the caller (e.g. Qt)
+/// evaluates trust itself via `SecTrustEvaluate`. Signature checks on TLS 1.2/1.3
+/// handshake messages are still verified using `ring`.
+#[derive(Debug)]
+struct DeferredServerAuthVerifier {
+    provider: Arc<rustls::crypto::CryptoProvider>,
+}
+
+impl rustls::client::danger::ServerCertVerifier for DeferredServerAuthVerifier {
+    fn verify_server_cert(
+        &self,
+        _end_entity: &CertificateDer<'_>,
+        _intermediates: &[CertificateDer<'_>],
+        _server_name: &ServerName<'_>,
+        _ocsp_response: &[u8],
+        _now: UnixTime,
+    ) -> Result<rustls::client::danger::ServerCertVerified, rustls::Error> {
+        Ok(rustls::client::danger::ServerCertVerified::assertion())
+    }
+
+    fn verify_tls12_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &rustls::DigitallySignedStruct,
+    ) -> Result<rustls::client::danger::HandshakeSignatureValid, rustls::Error> {
+        rustls::crypto::verify_tls12_signature(
+            message,
+            cert,
+            dss,
+            &self.provider.signature_verification_algorithms,
+        )
+    }
+
+    fn verify_tls13_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &rustls::DigitallySignedStruct,
+    ) -> Result<rustls::client::danger::HandshakeSignatureValid, rustls::Error> {
+        rustls::crypto::verify_tls13_signature(
+            message,
+            cert,
+            dss,
+            &self.provider.signature_verification_algorithms,
+        )
+    }
+
+    fn supported_verify_schemes(&self) -> Vec<rustls::SignatureScheme> {
+        self.provider
+            .signature_verification_algorithms
+            .supported_schemes()
+    }
+}
+
+fn build_client_config(inner: &SslInner) -> Result<Arc<ClientConfig>, rustls::Error> {
+    let provider = Arc::new(rustls::crypto::ring::default_provider());
+    let mut versions: Vec<&'static rustls::SupportedProtocolVersion> = Vec::new();
+    if inner.max_version >= SSL_PROTOCOL_TLS_1_3 && inner.min_version <= SSL_PROTOCOL_TLS_1_3 {
+        versions.push(&rustls::version::TLS13);
+    }
+    if inner.min_version <= SSL_PROTOCOL_TLS_1_2 && inner.max_version >= SSL_PROTOCOL_TLS_1_2 {
+        versions.push(&rustls::version::TLS12);
+    }
+    if versions.is_empty() {
+        versions.push(&rustls::version::TLS13);
+        versions.push(&rustls::version::TLS12);
+    }
+
+    let builder = ClientConfig::builder_with_provider(provider.clone())
+        .with_protocol_versions(&versions)?;
+    let mut config = if inner.break_on_server_auth {
+        builder
+            .dangerous()
+            .with_custom_certificate_verifier(Arc::new(DeferredServerAuthVerifier { provider }))
+            .with_no_client_auth()
+    } else {
+        builder
+            .with_root_certificates(root_store())
+            .with_no_client_auth()
+    };
+    if !inner.alpn_protocols.is_empty() {
+        config.alpn_protocols = inner.alpn_protocols.clone();
+    }
+    Ok(Arc::new(config))
+}
+
+fn ensure_connection(inner: &mut SslInner) -> Result<(), i32> {
+    if inner.conn.is_some() {
+        return Ok(());
+    }
+    let config = build_client_config(inner).map_err(|_| ERR_SSL_PROTOCOL)?;
+    let host = inner.peer_name.as_deref().unwrap_or("localhost");
+    let server_name = ServerName::try_from(host.to_owned())
+        .or_else(|_| ServerName::try_from("localhost".to_owned()))
+        .map_err(|_| ERR_SEC_PARAM)?;
+    let conn = ClientConnection::new(config, server_name).map_err(|_| ERR_SSL_PROTOCOL)?;
+    inner.conn = Some(conn);
+    Ok(())
+}
+
+/// Drain any encrypted bytes from `rustls` into `pending_write`, then push them
+/// through the caller's `write_func`.
+fn flush_writes(inner: &mut SslInner) -> i32 {
+    let Some(write_func) = inner.write_func else {
+        return ERR_SSL_CLOSED_ABORT;
+    };
+    if let Some(conn) = inner.conn.as_mut() {
+        while conn.wants_write() {
+            if conn.write_tls(&mut inner.pending_write).is_err() {
+                return ERR_SSL_CLOSED_ABORT;
+            }
+        }
+    }
+    while !inner.pending_write.is_empty() {
+        let mut len = inner.pending_write.len();
+        let status = unsafe {
+            write_func(
+                inner.connection,
+                inner.pending_write.as_ptr().cast(),
+                &mut len,
+            )
+        };
+        let written = len.min(inner.pending_write.len());
+        if written > 0 {
+            inner.pending_write.drain(..written);
+        }
+        if status == ERR_SSL_WOULD_BLOCK {
+            return ERR_SSL_WOULD_BLOCK;
+        }
+        if status != ERR_SEC_SUCCESS {
+            return status;
+        }
+        if written == 0 {
+            return ERR_SSL_WOULD_BLOCK;
+        }
+    }
+    ERR_SEC_SUCCESS
+}
+
+/// Pull encrypted bytes from the caller's `read_func` and feed them into
+/// `rustls`. Note that SecureTransport's non-blocking `read_func` may return
+/// `errSSLWouldBlock` alongside a nonzero byte count, so any received bytes
+/// MUST be fed to `rustls` before returning `errSSLWouldBlock`.
+fn feed_read(inner: &mut SslInner) -> i32 {
+    let Some(read_func) = inner.read_func else {
+        return ERR_SSL_CLOSED_ABORT;
+    };
+    let Some(conn) = inner.conn.as_mut() else {
+        return ERR_SSL_CLOSED_ABORT;
+    };
+    let mut buf = [0u8; 16384];
+    let mut len = buf.len();
+    let status = unsafe { read_func(inner.connection, buf.as_mut_ptr().cast(), &mut len) };
+    let got = len.min(buf.len());
+    if got > 0 {
+        let mut slice = &buf[..got];
+        while !slice.is_empty() {
+            match conn.read_tls(&mut slice) {
+                Ok(0) => break,
+                Ok(_) => {}
+                Err(_) => return ERR_SSL_PROTOCOL,
+            }
+        }
+        if let Err(err) = conn.process_new_packets() {
+            let _ = flush_writes(inner);
+            return match err {
+                rustls::Error::InvalidCertificate(_) => ERR_SSL_BAD_CERT,
+                _ => ERR_SSL_PROTOCOL,
+            };
+        }
+        return ERR_SEC_SUCCESS;
+    }
+    match status {
+        ERR_SSL_WOULD_BLOCK => ERR_SSL_WOULD_BLOCK,
+        ERR_SSL_CLOSED_GRACEFUL => ERR_SSL_CLOSED_GRACEFUL,
+        ERR_SEC_SUCCESS => ERR_SSL_WOULD_BLOCK,
+        other => other,
+    }
+}
+
+fn record_negotiated(inner: &mut SslInner) {
+    let Some(conn) = inner.conn.as_ref() else {
+        return;
+    };
+    inner.negotiated_version = match conn.protocol_version() {
+        Some(ProtocolVersion::TLSv1_3) => SSL_PROTOCOL_TLS_1_3,
+        Some(ProtocolVersion::TLSv1_2) => SSL_PROTOCOL_TLS_1_2,
+        _ => SSL_PROTOCOL_TLS_1_2,
+    };
+    if let Some(suite) = conn.negotiated_cipher_suite() {
+        inner.negotiated_cipher = u16::from(suite.suite());
+    }
+}
+
+pub unsafe extern "C" fn SSLCreateContext(
+    _alloc: CFTypeRef,
+    _protocol_side: i32,
+    _connection_type: i32,
+) -> CFTypeRef {
+    let ctx: *mut SslContext = unsafe { corefoundation::base::allocate(ssl_context_class()) };
+    if ctx.is_null() {
+        return std::ptr::null();
+    }
+    unsafe {
+        (*ctx).inner = Box::into_raw(Box::new(SslInner::default()));
+    }
+    ctx as CFTypeRef
+}
+
+pub unsafe extern "C" fn SSLClose(ctx: CFTypeRef) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    if let Some(conn) = inner.conn.as_mut() {
+        conn.send_close_notify();
+    }
+    let _ = flush_writes(inner);
+    inner.state = SSL_STATE_CLOSED;
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLGetSessionState(ctx: CFTypeRef, state: *mut i32) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    if state.is_null() {
+        return ERR_SEC_PARAM;
+    }
+    unsafe { *state = inner.state };
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLGetNumberSupportedCiphers(ctx: CFTypeRef, num_ciphers: *mut usize) -> i32 {
+    if ctx.is_null() || num_ciphers.is_null() {
+        return ERR_SEC_PARAM;
+    }
+    unsafe { *num_ciphers = SUPPORTED_CIPHERS.len() };
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLGetSupportedCiphers(
+    ctx: CFTypeRef,
+    ciphers: *mut u16,
+    num_ciphers: *mut usize,
+) -> i32 {
+    if ctx.is_null() || ciphers.is_null() || num_ciphers.is_null() {
+        return ERR_SEC_PARAM;
+    }
+    let cap = unsafe { *num_ciphers };
+    let count = cap.min(SUPPORTED_CIPHERS.len());
+    unsafe {
+        std::ptr::copy_nonoverlapping(SUPPORTED_CIPHERS.as_ptr(), ciphers, count);
+        *num_ciphers = count;
+    }
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLSetEnabledCiphers(
+    ctx: CFTypeRef,
+    _ciphers: *const u16,
+    _num_ciphers: usize,
+) -> i32 {
+    if ctx.is_null() { ERR_SEC_PARAM } else { ERR_SEC_SUCCESS }
+}
+
+pub unsafe extern "C" fn SSLSetIOFuncs(
+    ctx: CFTypeRef,
+    read_func: *const c_void,
+    write_func: *const c_void,
+) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    inner.read_func = if read_func.is_null() {
+        None
+    } else {
+        Some(unsafe { std::mem::transmute::<*const c_void, SslReadFunc>(read_func) })
+    };
+    inner.write_func = if write_func.is_null() {
+        None
+    } else {
+        Some(unsafe { std::mem::transmute::<*const c_void, SslWriteFunc>(write_func) })
+    };
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLSetConnection(ctx: CFTypeRef, connection: *const c_void) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    inner.connection = connection;
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLSetPeerDomainName(
+    ctx: CFTypeRef,
+    peer_name: *const c_char,
+    peer_name_len: usize,
+) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    if peer_name.is_null() || peer_name_len == 0 {
+        inner.peer_name = None;
+    } else {
+        let bytes = unsafe { std::slice::from_raw_parts(peer_name.cast::<u8>(), peer_name_len) };
+        let trimmed = bytes.split(|&b| b == 0).next().unwrap_or(bytes);
+        inner.peer_name = std::str::from_utf8(trimmed).ok().map(str::to_owned);
+    }
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLSetProtocolVersionMin(ctx: CFTypeRef, min_version: i32) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    inner.min_version = min_version;
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLSetProtocolVersionMax(ctx: CFTypeRef, max_version: i32) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    inner.max_version = max_version;
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLSetSessionOption(
+    ctx: CFTypeRef,
+    option: i32,
+    value: u8,
+) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    if option == SSL_OPT_BREAK_ON_SERVER_AUTH {
+        inner.break_on_server_auth = value != 0;
+    }
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLSetCertificate(ctx: CFTypeRef, _cert_refs: CFTypeRef) -> i32 {
+    if ctx.is_null() { ERR_SEC_PARAM } else { ERR_SEC_SUCCESS }
+}
+
+pub unsafe extern "C" fn SSLSetClientSideAuthenticate(ctx: CFTypeRef, _auth: i32) -> i32 {
