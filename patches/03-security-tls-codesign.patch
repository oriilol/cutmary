+    #[test]
+    fn context_lifecycle_and_alpn_config() {
+        unsafe {
+            let ctx = SSLCreateContext(std::ptr::null(), 1, 0);
+            assert!(!ctx.is_null());
+            let mut state = -1;
+            assert_eq!(SSLGetSessionState(ctx, &mut state), ERR_SEC_SUCCESS);
+            assert_eq!(state, SSL_STATE_IDLE);
+            let host = c"editor-api.capcutapi.com";
+            assert_eq!(
+                SSLSetPeerDomainName(ctx, host.as_ptr(), host.to_bytes().len()),
+                ERR_SEC_SUCCESS
+            );
+            assert_eq!(
+                SSLSetSessionOption(ctx, SSL_OPT_BREAK_ON_SERVER_AUTH, 1),
+                ERR_SEC_SUCCESS
+            );
+            assert_eq!(SSLClose(ctx), ERR_SEC_SUCCESS);
+            assert_eq!(SSLGetSessionState(ctx, &mut state), ERR_SEC_SUCCESS);
+            assert_eq!(state, SSL_STATE_CLOSED);
+            corefoundation::api::CFRelease(ctx);
+        }
+    }
+
+    #[test]
+    fn non_blocking_tls_handshake_against_live_https_if_reachable() {
+        // Integration smoke test against CapCut's Akamai endpoint; skips cleanly offline.
+        let host_name = "editor-api.capcutapi.com";
+        let Ok(stream) = TcpStream::connect((host_name, 443)) else {
+            return;
+        };
+        let _ = stream.set_nonblocking(true);
+
+        unsafe extern "C" fn read_cb(
+            conn: *const c_void,
+            data: *mut c_void,
+            len: *mut usize,
+        ) -> i32 {
+            let stream = unsafe { &mut *(conn as *mut TcpStream) };
+            let cap = unsafe { *len };
+            let buf = unsafe { std::slice::from_raw_parts_mut(data.cast::<u8>(), cap) };
+            match stream.read(buf) {
+                Ok(0) => {
+                    unsafe { *len = 0 };
+                    ERR_SSL_CLOSED_GRACEFUL
+                }
+                Ok(n) => {
+                    unsafe { *len = n };
+                    if n < cap {
+                        ERR_SSL_WOULD_BLOCK
+                    } else {
+                        ERR_SEC_SUCCESS
+                    }
+                }
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                    unsafe { *len = 0 };
+                    ERR_SSL_WOULD_BLOCK
+                }
+                Err(e) => {
+                    eprintln!("read_cb err: {e:?}");
+                    unsafe { *len = 0 };
+                    ERR_SSL_CLOSED_ABORT
+                }
+            }
+        }
+
+        unsafe extern "C" fn write_cb(
+            conn: *const c_void,
+            data: *const c_void,
+            len: *mut usize,
+        ) -> i32 {
+            let stream = unsafe { &mut *(conn as *mut TcpStream) };
+            let cap = unsafe { *len };
+            let buf = unsafe { std::slice::from_raw_parts(data.cast::<u8>(), cap) };
+            match stream.write(buf) {
+                Ok(n) => {
+                    unsafe { *len = n };
+                    if n < cap {
+                        ERR_SSL_WOULD_BLOCK
+                    } else {
+                        ERR_SEC_SUCCESS
+                    }
+                }
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                    unsafe { *len = 0 };
+                    ERR_SSL_WOULD_BLOCK
+                }
+                Err(e) => {
+                    eprintln!("read_cb err: {e:?}");
+                    unsafe { *len = 0 };
+                    ERR_SSL_CLOSED_ABORT
+                }
+            }
+        }
+
+        let mut stream = stream;
+        unsafe {
+            let ctx = SSLCreateContext(std::ptr::null(), 1, 0);
+            assert_eq!(
+                SSLSetIOFuncs(ctx, read_cb as *const c_void, write_cb as *const c_void),
+                ERR_SEC_SUCCESS
+            );
+            assert_eq!(
+                SSLSetConnection(ctx, (&mut stream as *mut TcpStream).cast()),
+                ERR_SEC_SUCCESS
+            );
+            assert_eq!(
+                SSLSetPeerDomainName(ctx, host_name.as_ptr().cast(), host_name.len()),
+                ERR_SEC_SUCCESS
+            );
+            assert_eq!(
+                SSLSetSessionOption(ctx, SSL_OPT_BREAK_ON_SERVER_AUTH, 1),
+                ERR_SEC_SUCCESS
+            );
+
+            let mut saw_peer_auth = false;
+            for _ in 0..500 {
+                let st = SSLHandshake(ctx);
+                if st == ERR_SEC_SUCCESS {
+                    break;
+                } else if st == ERR_SSL_PEER_AUTH_COMPLETED {
+                    saw_peer_auth = true;
+                    let mut trust = std::ptr::null();
+                    assert_eq!(SSLCopyPeerTrust(ctx, &mut trust), ERR_SEC_SUCCESS);
+                    assert!(!trust.is_null());
+                    assert!(crate::trust::SecTrustGetCertificateCount(trust) >= 1);
+                    let mut result = 0u32;
+                    assert_eq!(
+                        crate::trust::SecTrustEvaluate(trust, &mut result),
+                        ERR_SEC_SUCCESS
+                    );
+                    assert_eq!(result, 4); // kSecTrustResultUnspecified (trusted)
+                    corefoundation::api::CFRelease(trust);
+                } else if st == ERR_SSL_WOULD_BLOCK {
+                    std::thread::sleep(std::time::Duration::from_millis(5));
+                } else {
+                    panic!("SSLHandshake failed with {st}");
+                }
+            }
+            assert!(saw_peer_auth);
+
+            let req = format!("HEAD / HTTP/1.1\r\nHost: {host_name}\r\nConnection: close\r\n\r\n");
+            let req = req.as_bytes();
+            let mut written = 0usize;
+            let st = SSLWrite(ctx, req.as_ptr().cast(), req.len(), &mut written);
+            assert!(st == ERR_SEC_SUCCESS || st == ERR_SSL_WOULD_BLOCK);
+            assert_eq!(written, req.len());
+
+            let mut resp = [0u8; 256];
+            let mut got = 0usize;
+            for _ in 0..500 {
+                let mut n = 0usize;
+                let st = SSLRead(
+                    ctx,
+                    resp[got..].as_mut_ptr().cast(),
+                    resp.len() - got,
+                    &mut n,
+                );
+                got += n;
+                if got >= 12 || st == ERR_SSL_CLOSED_GRACEFUL {
+                    break;
+                }
+                if st == ERR_SSL_WOULD_BLOCK {
+                    std::thread::sleep(std::time::Duration::from_millis(5));
+                } else if st != ERR_SEC_SUCCESS {
+                    panic!("SSLRead failed with {st}");
+                }
+            }
+            assert!(
+                resp[..got].starts_with(b"HTTP/1.1 "),
+                "unexpected HTTP response: {:?}",
+                String::from_utf8_lossy(&resp[..got])
+            );
+            assert_eq!(SSLClose(ctx), ERR_SEC_SUCCESS);
+            corefoundation::api::CFRelease(ctx);
+        }
+    }
+}
