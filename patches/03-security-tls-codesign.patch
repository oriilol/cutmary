+pub unsafe extern "C" fn SSLSetALPNProtocols(ctx: CFTypeRef, protocols: CFTypeRef) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    inner.alpn_protocols.clear();
+    if protocols.is_null() {
+        return ERR_SEC_SUCCESS;
+    }
+    if let Some(array) = unsafe { corefoundation::collections::array(protocols) } {
+        for &item in &array.values {
+            if let Some(s) = unsafe { corefoundation::string::as_string(item) } {
+                let bytes = s.utf8();
+                if !bytes.is_empty() {
+                    inner.alpn_protocols.push(bytes);
+                }
+            }
+        }
+    }
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLCopyALPNProtocols(
+    ctx: CFTypeRef,
+    protocols: *mut CFTypeRef,
+) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    if protocols.is_null() {
+        return ERR_SEC_PARAM;
+    }
+    let negotiated = inner
+        .conn
+        .as_ref()
+        .and_then(|c| c.alpn_protocol())
+        .map(|p| corefoundation::string::from_bytes(p, false));
+    if let Some(s) = negotiated {
+        let items = [s];
+        let arr = corefoundation::collections::new_array(
+            &items,
+            corefoundation::callbacks::Policy::from_type_callbacks(),
+            false,
+        );
+        unsafe { corefoundation::api::CFRelease(s) };
+        unsafe { *protocols = arr };
+    } else {
+        unsafe { *protocols = std::ptr::null() };
+    }
+    ERR_SEC_SUCCESS
+}
+
+pub unsafe extern "C" fn SSLCopyPeerTrust(ctx: CFTypeRef, trust: *mut CFTypeRef) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    if trust.is_null() {
+        return ERR_SEC_PARAM;
+    }
+    let chain: Vec<Vec<u8>> = inner
+        .conn
+        .as_ref()
+        .and_then(|c| c.peer_certificates())
+        .map(|certs| certs.iter().map(|c| c.as_ref().to_vec()).collect())
+        .unwrap_or_default();
+    if chain.is_empty() {
+        unsafe { *trust = std::ptr::null() };
+        return ERR_SEC_SUCCESS;
+    }
+    let handle = crate::trust::new_trust(chain, inner.peer_name.clone());
+    unsafe { *trust = handle };
+    ERR_SEC_SUCCESS
+}
