+pub unsafe extern "C" fn SSLHandshake(ctx: CFTypeRef) -> i32 {
+    let Some(inner) = (unsafe { inner_mut(ctx) }) else {
+        return ERR_SEC_PARAM;
+    };
+    if inner.state == SSL_STATE_CONNECTED {
+        return ERR_SEC_SUCCESS;
+    }
+    if inner.peer_auth_pending {
+        inner.peer_auth_pending = false;
+        inner.state = SSL_STATE_CONNECTED;
+        return ERR_SEC_SUCCESS;
+    }
+    if let Err(code) = ensure_connection(inner) {
+        inner.state = SSL_STATE_ABORTED;
+        return code;
+    }
+    inner.state = SSL_STATE_HANDSHAKE;
+
+    loop {
+        let wst = flush_writes(inner);
+        if wst != ERR_SEC_SUCCESS {
+            if wst != ERR_SSL_WOULD_BLOCK {
+                inner.state = SSL_STATE_ABORTED;
+            }
+            return wst;
+        }
+        let handshaking = inner
+            .conn
+            .as_ref()
+            .is_some_and(|c| c.is_handshaking());
+        if !handshaking {
+            record_negotiated(inner);
+            if inner.break_on_server_auth && !inner.peer_auth_done {
+                inner.peer_auth_done = true;
+                inner.peer_auth_pending = true;
+                return ERR_SSL_PEER_AUTH_COMPLETED;
+            }
+            inner.state = SSL_STATE_CONNECTED;
+            return ERR_SEC_SUCCESS;
+        }
+        let rst = feed_read(inner);
+        if rst != ERR_SEC_SUCCESS {
+            if rst != ERR_SSL_WOULD_BLOCK {
+                inner.state = SSL_STATE_ABORTED;
+            }
+            return rst;
+        }
+    }
+}
