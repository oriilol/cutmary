+unsafe extern "C" fn ci_filter_with_name(class: Id, _sel: Sel, name: Id) -> Id {
+    unsafe { ci_filter_with_name_params(class, _sel, name, ptr::null_mut()) }
+}
+
+unsafe extern "C" fn ci_filter_with_name_params(
+    class: Id,
+    _sel: Sel,
+    name: Id,
+    params: Id,
+) -> Id {
+    let obj = alloc_of(class);
+    if obj.is_null() {
+        return ptr::null_mut();
+    }
+    let filter_name = if name.is_null() {
+        String::new()
+    } else {
+        String::from_utf8_lossy(&unsafe { foundation::string::bytes(name) }).into_owned()
+    };
+    let mut map = HashMap::new();
+    if !params.is_null()
+        && let Some(dict) = unsafe { corefoundation::collections::dictionary(params as CFTypeRef) }
+    {
+        for (k, v) in dict.entries() {
+            let key = String::from_utf8_lossy(&unsafe { foundation::string::bytes(*k as Id) })
+                .into_owned();
+            map.insert(key, objc::arc::retain(*v as Id));
+        }
+    }
+    let inner = Box::new(CiFilterInner {
+        name: filter_name,
+        params: map,
+    });
+    unsafe { (*(obj as *mut CiFilterObj)).inner = Box::into_raw(inner) };
+    autorelease(obj)
+}
+
+unsafe extern "C" fn ci_filter_names_in_category(_class: Id, _sel: Sel, _category: Id) -> Id {
+    let empty = corefoundation::collections::new_array(
+        &[],
+        corefoundation::callbacks::Policy::from_type_callbacks(),
+        false,
+    );
+    autorelease(empty as Id)
+}
+
+unsafe extern "C" fn ci_filter_dealloc(receiver: Id, _sel: Sel) {
+    let obj = unsafe { &mut *(receiver as *mut CiFilterObj) };
+    if !obj.inner.is_null() {
+        drop(unsafe { Box::from_raw(obj.inner) });
+        obj.inner = ptr::null_mut();
+    }
+    objc::arc::finalize(receiver);
+}
+
+unsafe extern "C" fn ci_filter_set_value(receiver: Id, _sel: Sel, value: Id, key: Id) {
+    let ptr = unsafe { (*(receiver as *mut CiFilterObj)).inner };
+    if ptr.is_null() || key.is_null() {
+        return;
+    }
+    let key_str =
+        String::from_utf8_lossy(&unsafe { foundation::string::bytes(key) }).into_owned();
+    let inner = unsafe { &mut *ptr };
+    let old = if value.is_null() {
+        inner.params.remove(&key_str)
+    } else {
+        inner.params.insert(key_str, objc::arc::retain(value))
+    };
+    if let Some(prev) = old {
+        objc::arc::release(prev);
+    }
+}
+
+unsafe extern "C" fn ci_filter_value_for_key(receiver: Id, sel: Sel, key: Id) -> Id {
+    if key.is_null() {
+        return ptr::null_mut();
+    }
+    let key_str =
+        String::from_utf8_lossy(&unsafe { foundation::string::bytes(key) }).into_owned();
+    if key_str == "outputImage" || key_str == "kCIOutputImageKey" {
+        return unsafe { ci_filter_output_image(receiver, sel) };
+    }
+    let ptr = unsafe { (*(receiver as *const CiFilterObj)).inner };
+    if ptr.is_null() {
+        return ptr::null_mut();
+    }
+    let inner = unsafe { &*ptr };
+    inner.params.get(&key_str).copied().unwrap_or(ptr::null_mut())
+}
+
+unsafe extern "C" fn ci_filter_output_image(receiver: Id, sel: Sel) -> Id {
+    let ptr = unsafe { (*(receiver as *const CiFilterObj)).inner };
+    if ptr.is_null() {
+        return ptr::null_mut();
+    }
+    let inner = unsafe { &*ptr };
+    let input = inner
+        .params
+        .get("inputImage")
+        .or_else(|| inner.params.get("kCIInputImageKey"))
+        .copied()
+        .unwrap_or(ptr::null_mut());
+    if input.is_null() {
+        return ptr::null_mut();
+    }
+    if inner.name == "CILanczosScaleTransform" {
+        let scale = inner
+            .params
+            .get("inputScale")
+            .and_then(|v| unsafe { corefoundation::collections::number(*v as CFTypeRef) })
+            .map_or(1.0, |n| n.as_f64());
+        let aspect = inner
+            .params
+            .get("inputAspectRatio")
+            .and_then(|v| unsafe { corefoundation::collections::number(*v as CFTypeRef) })
+            .map_or(1.0, |n| n.as_f64());
+        let t = CGAffineTransform {
+            a: scale * aspect,
+            b: 0.0,
+            c: 0.0,
+            d: scale,
+            tx: 0.0,
+            ty: 0.0,
+        };
+        return unsafe { ci_image_by_applying_transform_hq(input, sel, t, 1) };
+    }
+    autorelease(objc::arc::retain(input))
+}
+
+unsafe extern "C" fn ci_filter_attributes(_receiver: Id, _sel: Sel) -> Id {
+    let empty = corefoundation::collections::new_dictionary(
+        &[],
+        corefoundation::callbacks::Policy::from_key_callbacks(),
+        corefoundation::callbacks::Policy::from_type_callbacks(),
+        false,
+    );
+    autorelease(empty as Id)
+}
