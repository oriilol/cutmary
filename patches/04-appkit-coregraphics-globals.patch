+    /// The display's current mode pixel density. On Wayland with fractional
+    /// scaling (e.g. KDE Plasma at 1.25x), `SDL_GetDisplayContentScale` reports
+    /// `1.0` while `SDL_GetCurrentDisplayMode()->pixel_density` reports `1.25`.
+    pub fn display_pixel_density(display: u32) -> f32 {
+        let Some(f) = api().and_then(|a| a.SDL_GetCurrentDisplayMode) else {
+            return 1.0;
+        };
+        // SAFETY: a display id; the returned pointer is SDL-owned and read-only.
+        let mode = unsafe { f(display) };
+        if mode.is_null() {
+            return 1.0;
+        }
+        // SAFETY: non-null SDL_DisplayMode returned by SDL_GetCurrentDisplayMode.
+        let density = unsafe { (*mode).pixel_density };
+        match density.is_finite() && density > 0.0 {
+            true => density,
+            false => 1.0,
+        }
+    }
