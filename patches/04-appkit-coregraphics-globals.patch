+/// Whether the host is Wayland running with a fractional display scale (e.g.
+/// 1.25x or 1.5x).
+///
+/// macOS AppKit only ever exposes integer backing scales (1.0 or 2.0), and
+/// toolkits like Qt 6's `libqcocoa` assume integer backing factors — on a
+/// 1.25x Wayland surface with `HIGH_PIXEL_DENSITY`, either Qt rounds up to 2x
+/// and clips, or (if AppKit reports 1.0) Qt draws into 80%×80% of the physical
+/// framebuffer leaving the rest uninitialized. Dropping `HIGH_PIXEL_DENSITY`
+/// on fractional Wayland lets the compositor scale a clean 1.0x surface with
+/// exact 1:1 agreement across OpenGL, Metal, CoreAnimation, and mouse input.
+pub(crate) fn is_fractional_wayland() -> bool {
+    if !sdl3::video::is_wayland() {
+        return false;
+    }
+    sdl3::video::displays().into_iter().any(|display| {
+        let density = sdl3::video::display_pixel_density(display) as f64;
+        let content = sdl3::video::display_content_scale(display) as f64;
+        let is_frac = |s: f64| s > 0.0 && (s - s.round()).abs() > 0.01;
+        is_frac(density) || is_frac(content)
+    })
+}
+
+pub(crate) fn effective_display_scale(display: u32) -> CGFloat {
+    if is_fractional_wayland() {
+        return 1.0;
+    }
+    let scale = sdl3::video::display_content_scale(display) as f64;
+    if !(scale > 0.0) {
+        return 1.0;
+    }
+    scale
+}
