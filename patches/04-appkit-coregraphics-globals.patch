+unsafe extern "C" fn ci_context_render_to_cvpb(
+    receiver: Id,
+    sel: Sel,
+    image: Id,
+    buffer: CFTypeRef,
+) {
+    let w = unsafe { corevideo::pixel_buffer::CVPixelBufferGetWidth(buffer) } as f64;
+    let h = unsafe { corevideo::pixel_buffer::CVPixelBufferGetHeight(buffer) } as f64;
+    let bounds = NSRect {
+        origin: NSPoint { x: 0.0, y: 0.0 },
+        size: NSSize {
+            width: w,
+            height: h,
+        },
+    };
+    unsafe { ci_context_render_to_cvpb_bounds(receiver, sel, image, buffer, bounds, ptr::null()) };
+}
+
+unsafe extern "C" fn ci_context_render_to_cvpb_bounds(
+    receiver: Id,
+    _sel: Sel,
+    image: Id,
+    buffer: CFTypeRef,
+    bounds: NSRect,
+    _color_space: CFTypeRef,
+) {
+    let Some(img) = image_inner(image) else {
+        return;
+    };
+    if buffer.is_null() {
+        return;
+    }
+    let pb_w = unsafe { corevideo::pixel_buffer::CVPixelBufferGetWidth(buffer) };
+    let pb_h = unsafe { corevideo::pixel_buffer::CVPixelBufferGetHeight(buffer) };
+    let fmt = unsafe { corevideo::pixel_buffer::CVPixelBufferGetPixelFormatType(buffer) };
+    if pb_w == 0 || pb_h == 0 {
+        return;
+    }
+    let eff_bounds = if bounds.size.width > 0.0 && bounds.size.height > 0.0 {
+        bounds
+    } else {
+        NSRect {
+            origin: NSPoint { x: 0.0, y: 0.0 },
+            size: NSSize {
+                width: pb_w as f64,
+                height: pb_h as f64,
+            },
+        }
+    };
+    let output_premul = unsafe { (*(receiver as *const CiContextObj)).output_premultiplied } != 0;
+    let rgba = rasterize_bounds(img, eff_bounds, pb_w, pb_h, output_premul);
+
+    // Lock with flags=0 (write) so unlock increments cpu_generation / IOSurface seed.
+    if unsafe { corevideo::pixel_buffer::CVPixelBufferLockBaseAddress(buffer, 0) } != 0 {
+        return;
+    }
+    let base = unsafe { corevideo::pixel_buffer::CVPixelBufferGetBaseAddress(buffer) } as *mut u8;
+    let row_bytes = unsafe { corevideo::pixel_buffer::CVPixelBufferGetBytesPerRow(buffer) };
+    if !base.is_null() {
+        match fmt {
+            PIXEL_FORMAT_BGRA => {
+                for y in 0..pb_h {
+                    let src = &rgba[y * pb_w * 4..(y + 1) * pb_w * 4];
+                    let dst = unsafe { std::slice::from_raw_parts_mut(base.add(y * row_bytes), pb_w * 4) };
+                    for (s, d) in src.chunks_exact(4).zip(dst.chunks_exact_mut(4)) {
+                        d[0] = s[2];
+                        d[1] = s[1];
+                        d[2] = s[0];
+                        d[3] = s[3];
+                    }
+                }
+            }
+            PIXEL_FORMAT_RGBA => {
+                for y in 0..pb_h {
+                    let src = &rgba[y * pb_w * 4..(y + 1) * pb_w * 4];
+                    let dst = unsafe { std::slice::from_raw_parts_mut(base.add(y * row_bytes), pb_w * 4) };
+                    dst.copy_from_slice(src);
+                }
+            }
+            PIXEL_FORMAT_ARGB => {
+                for y in 0..pb_h {
+                    let src = &rgba[y * pb_w * 4..(y + 1) * pb_w * 4];
+                    let dst = unsafe { std::slice::from_raw_parts_mut(base.add(y * row_bytes), pb_w * 4) };
+                    for (s, d) in src.chunks_exact(4).zip(dst.chunks_exact_mut(4)) {
+                        d[0] = s[3];
+                        d[1] = s[0];
+                        d[2] = s[1];
+                        d[3] = s[2];
+                    }
+                }
+            }
+            PIXEL_FORMAT_RGBA_HALF => {
+                for y in 0..pb_h {
+                    let src = &rgba[y * pb_w * 4..(y + 1) * pb_w * 4];
+                    let dst = unsafe { std::slice::from_raw_parts_mut(base.add(y * row_bytes), pb_w * 8) };
+                    for (s, d) in src.chunks_exact(4).zip(dst.chunks_exact_mut(8)) {
+                        for c in 0..4 {
+                            let h = f16::from_f32(f32::from(s[c]) / 255.0).to_le_bytes();
+                            d[c * 2] = h[0];
+                            d[c * 2 + 1] = h[1];
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    unsafe { corevideo::pixel_buffer::CVPixelBufferUnlockBaseAddress(buffer, 0) };
+}
+
+unsafe extern "C" fn ci_context_create_cgimage(
+    _receiver: Id,
+    _sel: Sel,
+    image: Id,
+    rect: NSRect,
+) -> CFTypeRef {
+    let Some(img) = image_inner(image) else {
+        return ptr::null();
+    };
+    if rect.size.width <= 0.0 || rect.size.height <= 0.0 {
+        return ptr::null();
+    }
+    let w = rect.size.width.round().clamp(1.0, f64::from(MAX_RENDER_DIM)) as usize;
+    let h = rect.size.height.round().clamp(1.0, f64::from(MAX_RENDER_DIM)) as usize;
+    let rgba = rasterize_bounds(img, rect, w, h, true);
+    let mut bgra = vec![0u8; w * h * 4];
+    for (s, d) in rgba.chunks_exact(4).zip(bgra.chunks_exact_mut(4)) {
+        d[0] = s[2];
+        d[1] = s[1];
+        d[2] = s[0];
+        d[3] = s[3];
+    }
+    crate::graphics::image_from_pixels(bgra, w, h, w * 4, crate::graphics::PREMULTIPLIED_BGRA)
+}
+
+unsafe extern "C" fn ci_context_create_cgimage_format(
+    receiver: Id,
+    sel: Sel,
+    image: Id,
+    rect: NSRect,
+    _format: i32,
+    _color_space: CFTypeRef,
+) -> CFTypeRef {
+    unsafe { ci_context_create_cgimage(receiver, sel, image, rect) }
+}
