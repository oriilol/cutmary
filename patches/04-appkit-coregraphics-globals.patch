+pub unsafe extern "C" fn CGImageSourceGetType(source: CFTypeRef) -> CFTypeRef {
+    let Some(bytes) = (unsafe { image_source_bytes(source) }) else {
+        return std::ptr::null();
+    };
+    let uti: Option<&str> = if bytes.starts_with(b"\x89PNG\r\n\x1a\n") {
+        Some("public.png")
+    } else if bytes.starts_with(&[0xFF, 0xD8, 0xFF]) {
+        Some("public.jpeg")
+    } else if bytes.starts_with(b"GIF87a") || bytes.starts_with(b"GIF89a") {
+        Some("com.compuserve.gif")
+    } else if bytes.starts_with(b"BM") {
+        Some("com.microsoft.bmp")
+    } else if bytes.len() >= 12 && &bytes[0..4] == b"RIFF" && &bytes[8..12] == b"WEBP" {
+        Some("org.webmproject.webp")
+    } else if bytes.starts_with(b"II*\0") || bytes.starts_with(b"MM\0*") {
+        Some("public.tiff")
+    } else {
+        None
+    };
+    match uti {
+        Some(name) => foundation::notification::name_object(name) as CFTypeRef,
+        None => std::ptr::null(),
+    }
