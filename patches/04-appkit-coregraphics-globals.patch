+unsafe extern "C" fn color_with_catalog_name(
+    _class: Id,
+    _sel: Sel,
+    _catalog: Id,
+    color_name: Id,
+) -> Id {
+    let raw = unsafe { foundation::string::bytes(color_name) };
+    let name = String::from_utf8_lossy(&raw).into_owned();
+    let dark = crate::appearance::is_dark();
+    if let Some((r, g, b, a)) = components_in(&name, dark)
+        .or_else(|| components_in(&format!("{name}Color"), dark))
+    {
+        let key = format!("catalog:{name}:{dark}");
+        return singleton(&key, r, g, b, a);
+    }
+    // Fall back to a valid color for standard macOS system catalog names we don't list explicitly.
+    if name.contains("Background") || name.contains("Window") {
+        let g = if dark { 0.15 } else { 0.94 };
+        return singleton(&format!("catalog:{name}:{dark}"), g, g, g, 1.0);
+    }
+    if name.contains("Text") || name.contains("Label") {
+        let g = if dark { 1.0 } else { 0.0 };
+        return singleton(&format!("catalog:{name}:{dark}"), g, g, g, 1.0);
+    }
+    if name.contains("Selected") || name.contains("Accent") || name.contains("Highlight") {
+        return singleton(&format!("catalog:{name}:{dark}"), 0.0, 0.39, 0.88, 1.0);
+    }
+    singleton(&format!("catalog:{name}:{dark}"), 0.5, 0.5, 0.5, 1.0)
+}
+
+unsafe extern "C" fn color_with_hsba(
+    _class: Id,
+    _sel: Sel,
+    h: f64,
+    s: f64,
+    v: f64,
+    a: f64,
+) -> Id {
+    let h = (h.rem_euclid(1.0)) * 6.0;
+    let i = h.floor() as i32;
+    let f = h - i as f64;
+    let p = v * (1.0 - s);
+    let q = v * (1.0 - s * f);
+    let t = v * (1.0 - s * (1.0 - f));
+    let (r, g, b) = match i % 6 {
+        0 => (v, t, p),
+        1 => (q, v, p),
+        2 => (p, v, t),
+        3 => (p, q, v),
+        4 => (t, p, v),
+        _ => (v, p, q),
+    };
+    make(r, g, b, a)
+}
+
+unsafe extern "C" fn color_with_color_space_components(
+    _class: Id,
+    _sel: Sel,
+    _space: Id,
+    components: *const f64,
+    count: isize,
+) -> Id {
+    if components.is_null() || count <= 0 {
+        return make(0.0, 0.0, 0.0, 1.0);
+    }
+    let slice = unsafe { std::slice::from_raw_parts(components, count as usize) };
+    match slice.len() {
+        1 => make(slice[0], slice[0], slice[0], 1.0),
+        2 => make(slice[0], slice[0], slice[0], slice[1]),
+        3 => make(slice[0], slice[1], slice[2], 1.0),
+        _ => make(slice[0], slice[1], slice[2], slice[3]),
+    }
+}
