+#[repr(C)]
+struct CMTime {
+    value: i64,
+    timescale: i32,
+    flags: u32,
+    epoch: i64,
+}
+
+#[repr(C)]
+struct CMTimeRange {
+    start: CMTime,
+    duration: CMTime,
+}
+
+#[repr(C)]
+struct CMSampleTimingInfo {
+    duration: CMTime,
+    pts: CMTime,
+    dts: CMTime,
+}
+
+static CM_TIME_INDEFINITE: CMTime = CMTime { value: 0, timescale: 0, flags: 17, epoch: 0 };
+static CM_TIME_INVALID: CMTime = CMTime { value: 0, timescale: 0, flags: 0, epoch: 0 };
+static CM_TIME_ZERO: CMTime = CMTime { value: 0, timescale: 1, flags: 1, epoch: 0 };
+static CM_TIME_RANGE_INVALID: CMTimeRange = CMTimeRange {
+    start: CMTime { value: 0, timescale: 0, flags: 0, epoch: 0 },
+    duration: CMTime { value: 0, timescale: 0, flags: 0, epoch: 0 },
+};
+static CM_TIME_RANGE_ZERO: CMTimeRange = CMTimeRange {
+    start: CMTime { value: 0, timescale: 1, flags: 1, epoch: 0 },
+    duration: CMTime { value: 0, timescale: 1, flags: 1, epoch: 0 },
+};
+static CM_TIMING_INFO_INVALID: CMSampleTimingInfo = CMSampleTimingInfo {
+    duration: CMTime { value: 0, timescale: 0, flags: 0, epoch: 0 },
+    pts: CMTime { value: 0, timescale: 0, flags: 0, epoch: 0 },
+    dts: CMTime { value: 0, timescale: 0, flags: 0, epoch: 0 },
+};
+static TASK_PRIORITY_HIGH: f32 = 1.0;
+static CI_FORMAT_ARGB8: i32 = 264;
+static CI_FORMAT_RGBA8: i32 = 266;
+static LOC_ACC_BEST: f64 = -1.0;
+static LOC_ACC_100M: f64 = 100.0;
+static DISPATCH_SOURCE_MEMORYPRESSURE: u64 = 0;
+
+pub fn extra_data_symbols() -> Vec<(String, u64)> {
+    let mut out = corefoundation::base::string_globals(STRING_GLOBALS);
+    out.push(("_kCMTimeIndefinite".to_string(), &CM_TIME_INDEFINITE as *const _ as usize as u64));
+    out.push(("_kCMTimeRangeInvalid".to_string(), &CM_TIME_RANGE_INVALID as *const _ as usize as u64));
+    out.push(("_kCMTimeRangeZero".to_string(), &CM_TIME_RANGE_ZERO as *const _ as usize as u64));
+    out.push(("_kCMTimingInfoInvalid".to_string(), &CM_TIMING_INFO_INVALID as *const _ as usize as u64));
+    let _ = &CM_TIME_INVALID;
+    let _ = &CM_TIME_ZERO;
+    out.push(("_NSURLSessionTaskPriorityHigh".to_string(), &TASK_PRIORITY_HIGH as *const _ as usize as u64));
+    out.push(("_kCIFormatARGB8".to_string(), &CI_FORMAT_ARGB8 as *const _ as usize as u64));
+    out.push(("_kCIFormatRGBA8".to_string(), &CI_FORMAT_RGBA8 as *const _ as usize as u64));
+    out.push(("_kCLLocationAccuracyBest".to_string(), &LOC_ACC_BEST as *const _ as usize as u64));
+    out.push(("_kCLLocationAccuracyHundredMeters".to_string(), &LOC_ACC_100M as *const _ as usize as u64));
+    out.push(("__dispatch_source_type_memorypressure".to_string(), &DISPATCH_SOURCE_MEMORYPRESSURE as *const _ as usize as u64));
+    out.push(("_APP_SANDBOX_READ".to_string(), corefoundation::base::global_cell("_APP_SANDBOX_READ", c"com.apple.app-sandbox.read".as_ptr() as usize as u64)));
+    out.push(("_APP_SANDBOX_READ_WRITE".to_string(), corefoundation::base::global_cell("_APP_SANDBOX_READ_WRITE", c"com.apple.app-sandbox.read-write".as_ptr() as usize as u64)));
+    out.push(("_malloc_logger".to_string(), corefoundation::base::global_cell("_malloc_logger", 0)));
+    out
+}
