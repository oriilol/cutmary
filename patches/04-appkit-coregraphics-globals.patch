+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+fn autorelease(object: Id) -> Id {
+    if object.is_null() {
+        return ptr::null_mut();
+    }
+    unsafe { corefoundation::api::CFAutorelease(object as CFTypeRef) as Id }
+}
+
+fn alloc_of(class: Id) -> Id {
+    let Some(cls) = (unsafe { objc::class::from_ptr(class as *const objc::class::Class) }) else {
+        return ptr::null_mut();
+    };
+    objc::object::create_instance(cls, 0)
+}
+
+fn is_ci_image(obj: Id) -> bool {
+    if obj.is_null() {
+        return false;
+    }
+    objc::class::lookup(c"CIImage").is_some_and(|base| {
+        unsafe { objc::object::class_of(obj) }
+            .is_some_and(|cls| cls.chain().any(|c| ptr::eq(c, base)))
+    })
+}
+
+fn image_inner<'a>(obj: Id) -> Option<&'a CiImageInner> {
+    if !is_ci_image(obj) {
+        return None;
+    }
+    let ptr = unsafe { (*(obj as *const CiImageObj)).inner };
+    if ptr.is_null() {
+        None
+    } else {
+        Some(unsafe { &*ptr })
+    }
+}
+
+fn set_image_inner(obj: Id, inner: CiImageInner) {
+    let slot = unsafe { &mut (*(obj as *mut CiImageObj)).inner };
+    if !slot.is_null() {
+        drop(unsafe { Box::from_raw(*slot) });
+    }
+    *slot = Box::into_raw(Box::new(inner));
+}
+
+fn make_ci_image(class: Id, inner: CiImageInner) -> Id {
+    let obj = alloc_of(class);
+    if obj.is_null() {
+        return ptr::null_mut();
+    }
+    set_image_inner(obj, inner);
+    obj
+}
+
+fn default_color_space() -> CFTypeRef {
+    unsafe { crate::graphics::CGColorSpaceCreateDeviceRGB() }
+}
+
+fn dict_value(dict: Id, keys: &[&str]) -> CFTypeRef {
+    if dict.is_null() {
+        return ptr::null();
+    }
+    for key in keys {
+        let cf_key = corefoundation::base::interned_name(key) as usize as CFTypeRef;
+        let val = unsafe { corefoundation::api::CFDictionaryGetValue(dict as CFTypeRef, cf_key) };
+        if !val.is_null() {
+            return val;
+        }
+    }
+    ptr::null()
+}
+
+fn option_bool(options: Id, keys: &[&str], default: bool) -> bool {
+    let val = dict_value(options, keys);
+    if val.is_null() {
+        return default;
+    }
+    if unsafe { corefoundation::api::CFGetTypeID(val) }
+        == unsafe { corefoundation::api::CFBooleanGetTypeID() }
+    {
+        return unsafe { corefoundation::api::CFBooleanGetValue(val) } != 0;
+    }
+    if let Some(num) = unsafe { corefoundation::collections::number(val) } {
+        return num.as_f64() != 0.0;
+    }
+    default
+}
+
+fn option_color_space(options: Id) -> CFTypeRef {
+    let val = dict_value(options, &["kCIImageColorSpace", "CIImageColorSpace"]);
+    if !val.is_null() && crate::graphics::space_components(val).is_some() {
+        unsafe { corefoundation::api::CFRetain(val) }
+    } else {
+        default_color_space()
+    }
+}
+
+fn nsdata_bytes(data: Id) -> Option<Vec<u8>> {
+    if data.is_null() {
+        return None;
+    }
+    let cf_ptr = unsafe { corefoundation::api::CFDataGetBytePtr(data as CFTypeRef) };
+    if !cf_ptr.is_null() {
+        let len = unsafe { corefoundation::api::CFDataGetLength(data as CFTypeRef) };
+        let len = usize::try_from(len).ok()?;
+        return Some(unsafe { std::slice::from_raw_parts(cf_ptr, len) }.to_vec());
+    }
+    unsafe {
+        let len_fn: unsafe extern "C" fn(Id, Sel) -> usize = std::mem::transmute(objc::msg::entry());
+        let bytes_fn: unsafe extern "C" fn(Id, Sel) -> *const u8 =
+            std::mem::transmute(objc::msg::entry());
+        let len = len_fn(data, objc::sel::get("length"));
+        let ptr = bytes_fn(data, objc::sel::get("bytes"));
+        if ptr.is_null() || len == 0 {
+            return None;
+        }
+        Some(std::slice::from_raw_parts(ptr, len).to_vec())
+    }
+}
+
+fn data_from_url(url: Id) -> Option<Vec<u8>> {
+    if url.is_null() {
+        return None;
+    }
+    let cls = objc::class::lookup(c"NSData")?;
+    let data = unsafe {
+        let f: unsafe extern "C" fn(Id, Sel, Id) -> Id = std::mem::transmute(objc::msg::entry());
+        f(
+            objc::class::ptr(cls) as Id,
+            objc::sel::get("dataWithContentsOfURL:"),
+            url,
+        )
+    };
+    nsdata_bytes(data)
+}
+
+#[inline]
+fn premul(c: u8, a: u8) -> u8 {
+    ((u16::from(c) * u16::from(a) + 127) / 255) as u8
+}
+
+#[inline]
+fn unpremul(c: u8, a: u8) -> u8 {
+    if a == 0 {
+        0
+    } else if a == 255 {
+        c
+    } else {
+        ((u32::from(c) * 255 + u32::from(a) / 2) / u32::from(a)).min(255) as u8
+    }
+}
+
+/// Extract EXIF orientation (1..=8) from JPEG APP1 or TIFF bytes.
+fn parse_exif_orientation(bytes: &[u8]) -> u32 {
+    if bytes.starts_with(b"II") || bytes.starts_with(b"MM") {
+        return parse_tiff_orientation(bytes).unwrap_or(1);
+    }
+    if !bytes.starts_with(&[0xFF, 0xD8]) {
+        return 1;
+    }
+    let mut i = 2usize;
+    while i + 4 <= bytes.len() {
+        if bytes[i] != 0xFF {
+            break;
+        }
+        let marker = bytes[i + 1];
+        i += 2;
+        if marker == 0xD9 || marker == 0xDA {
+            break;
+        }
+        if (0xD0..=0xD8).contains(&marker) || marker == 0x01 {
+            continue;
+        }
+        let seg_len = u16::from_be_bytes([bytes[i], bytes[i + 1]]) as usize;
+        if seg_len < 2 || i + seg_len > bytes.len() {
+            break;
+        }
+        if marker == 0xE1 && seg_len >= 8 && &bytes[i + 2..i + 8] == b"Exif\0\0" {
+            if let Some(o) = parse_tiff_orientation(&bytes[i + 8..i + seg_len]) {
+                return o;
+            }
+        }
+        i += seg_len;
+    }
+    1
+}
+
+fn parse_tiff_orientation(tiff: &[u8]) -> Option<u32> {
+    if tiff.len() < 8 {
+        return None;
+    }
+    let le = match &tiff[0..2] {
+        b"II" => true,
+        b"MM" => false,
+        _ => return None,
+    };
+    let r16 = |off: usize| -> Option<u16> {
+        let s = tiff.get(off..off + 2)?;
+        Some(if le {
+            u16::from_le_bytes([s[0], s[1]])
+        } else {
+            u16::from_be_bytes([s[0], s[1]])
+        })
+    };
+    let r32 = |off: usize| -> Option<u32> {
+        let s = tiff.get(off..off + 4)?;
+        Some(if le {
+            u32::from_le_bytes([s[0], s[1], s[2], s[3]])
+        } else {
+            u32::from_be_bytes([s[0], s[1], s[2], s[3]])
+        })
+    };
+    if r16(2)? != 42 {
+        return None;
+    }
+    let ifd = r32(4)? as usize;
+    let count = r16(ifd)? as usize;
+    for idx in 0..count {
+        let entry = ifd + 2 + idx * 12;
+        if entry + 12 > tiff.len() {
+            break;
+        }
+        if r16(entry)? == 0x0112 {
+            let val = u32::from(r16(entry + 8)?);
+            if (1..=8).contains(&val) {
+                return Some(val);
+            }
+        }
+    }
+    None
+}
+
+/// Apply EXIF orientation `1..=8` to a top-row-first RGBA bitmap.
+fn apply_orientation(w: u32, h: u32, pixels: &[u8], orientation: u32) -> (u32, u32, Vec<u8>) {
+    if orientation <= 1 || orientation > 8 || w == 0 || h == 0 {
+        return (w, h, pixels.to_vec());
+    }
+    let sw = w as usize;
+    let sh = h as usize;
+    let (dw, dh) = if orientation >= 5 { (sh, sw) } else { (sw, sh) };
+    let mut out = vec![0u8; dw * dh * 4];
+    for sy in 0..sh {
+        for sx in 0..sw {
+            let (dx, dy) = match orientation {
+                2 => (sw - 1 - sx, sy),
+                3 => (sw - 1 - sx, sh - 1 - sy),
+                4 => (sx, sh - 1 - sy),
+                5 => (sy, sx),
+                6 => (sh - 1 - sy, sx),
+                7 => (sh - 1 - sy, sw - 1 - sx),
+                8 => (sy, sw - 1 - sx),
+                _ => (sx, sy),
+            };
+            let src = (sy * sw + sx) * 4;
+            let dst = (dy * dw + dx) * 4;
+            out[dst..dst + 4].copy_from_slice(&pixels[src..src + 4]);
+        }
+    }
+    (dw as u32, dh as u32, out)
+}
+
+fn make_properties_dict(width: u32, height: u32, orientation: u32) -> CFTypeRef {
+    let kw = corefoundation::string::from_bytes(b"PixelWidth", false);
+    let vw = corefoundation::collections::new_number(corefoundation::collections::Number::Integer(
+        i64::from(width),
+    ));
+    let kh = corefoundation::string::from_bytes(b"PixelHeight", false);
+    let vh = corefoundation::collections::new_number(corefoundation::collections::Number::Integer(
+        i64::from(height),
+    ));
+    let ko = corefoundation::string::from_bytes(b"Orientation", false);
+    let vo = corefoundation::collections::new_number(corefoundation::collections::Number::Integer(
+        i64::from(orientation),
+    ));
+    let dict = corefoundation::collections::new_dictionary(
+        &[(kw, vw), (kh, vh), (ko, vo)],
+        corefoundation::callbacks::Policy::from_key_callbacks(),
+        corefoundation::callbacks::Policy::from_type_callbacks(),
+        false,
+    );
+    for obj in [kw, vw, kh, vh, ko, vo] {
+        unsafe { corefoundation::api::CFRelease(obj) };
+    }
+    dict
+}
+
+fn decode_bytes_to_inner(bytes: &[u8], options: Id) -> Option<CiImageInner> {
+    let bitmap = crate::raster::decode(bytes)?;
+    if bitmap.width == 0 || bitmap.height == 0 {
+        return None;
+    }
+    let apply_orient = option_bool(
+        options,
+        &[
+            "kCIImageApplyOrientationProperty",
+            "CIImageApplyOrientationProperty",
+        ],
+        false,
+    );
+    let raw_orient = parse_exif_orientation(bytes);
+    let (width, height, pixels, stored_orient) = if apply_orient && raw_orient > 1 {
+        let (w, h, p) = apply_orientation(bitmap.width, bitmap.height, &bitmap.pixels, raw_orient);
+        (w, h, p, 1)
+    } else {
+        (bitmap.width, bitmap.height, bitmap.pixels, raw_orient)
+    };
+    Some(CiImageInner {
+        width,
+        height,
+        pixels,
+        premultiplied: false,
+        extent: NSRect {
+            origin: NSPoint { x: 0.0, y: 0.0 },
+            size: NSSize {
+                width: f64::from(width),
+                height: f64::from(height),
+            },
+        },
+        color_space: option_color_space(options),
+        properties: make_properties_dict(width, height, stored_orient),
+    })
+}
+
+fn decode_cgimage_to_inner(cg_image: CFTypeRef, options: Id) -> Option<CiImageInner> {
+    if cg_image.is_null() {
+        return None;
+    }
+    let (w, h, bgra) = crate::graphics::image_bgra(cg_image)?;
+    if w == 0 || h == 0 {
+        return None;
+    }
+    let mut rgba = vec![0u8; w * h * 4];
+    for (src, dst) in bgra.chunks_exact(4).zip(rgba.chunks_exact_mut(4)) {
+        dst[0] = src[2];
+        dst[1] = src[1];
+        dst[2] = src[0];
+        dst[3] = src[3];
+    }
+    let cs = {
+        let opt = dict_value(options, &["kCIImageColorSpace", "CIImageColorSpace"]);
+        if !opt.is_null() && crate::graphics::space_components(opt).is_some() {
+            unsafe { corefoundation::api::CFRetain(opt) }
+        } else {
+            let img_cs = unsafe { crate::graphics::CGImageGetColorSpace(cg_image) };
+            if !img_cs.is_null() {
+                unsafe { corefoundation::api::CFRetain(img_cs) }
+            } else {
+                default_color_space()
+            }
+        }
+    };
+    Some(CiImageInner {
+        width: w as u32,
+        height: h as u32,
+        pixels: rgba,
+        premultiplied: true,
+        extent: NSRect {
+            origin: NSPoint { x: 0.0, y: 0.0 },
+            size: NSSize {
+                width: w as f64,
+                height: h as f64,
+            },
+        },
+        color_space: cs,
+        properties: make_properties_dict(w as u32, h as u32, 1),
+    })
+}
+
+fn decode_cvpixelbuffer_to_inner(pb: CFTypeRef, options: Id) -> Option<CiImageInner> {
+    if pb.is_null() {
+        return None;
+    }
+    let w = unsafe { corevideo::pixel_buffer::CVPixelBufferGetWidth(pb) };
+    let h = unsafe { corevideo::pixel_buffer::CVPixelBufferGetHeight(pb) };
+    let fmt = unsafe { corevideo::pixel_buffer::CVPixelBufferGetPixelFormatType(pb) };
+    if w == 0 || h == 0 {
+        return None;
+    }
+    if unsafe { corevideo::pixel_buffer::CVPixelBufferLockBaseAddress(pb, READ_ONLY_LOCK) } != 0 {
+        return None;
+    }
+    let base = unsafe { corevideo::pixel_buffer::CVPixelBufferGetBaseAddress(pb) } as *const u8;
+    let row_bytes = unsafe { corevideo::pixel_buffer::CVPixelBufferGetBytesPerRow(pb) };
+    if base.is_null() {
+        unsafe { corevideo::pixel_buffer::CVPixelBufferUnlockBaseAddress(pb, READ_ONLY_LOCK) };
+        return None;
+    }
+    let mut rgba = vec![0u8; w * h * 4];
+    let ok = match fmt {
+        PIXEL_FORMAT_BGRA => {
+            for y in 0..h {
+                let row = unsafe { std::slice::from_raw_parts(base.add(y * row_bytes), w * 4) };
+                let dst = &mut rgba[y * w * 4..(y + 1) * w * 4];
+                for (s, d) in row.chunks_exact(4).zip(dst.chunks_exact_mut(4)) {
+                    d[0] = s[2];
+                    d[1] = s[1];
+                    d[2] = s[0];
+                    d[3] = s[3];
+                }
+            }
+            true
+        }
+        PIXEL_FORMAT_RGBA => {
+            for y in 0..h {
+                let row = unsafe { std::slice::from_raw_parts(base.add(y * row_bytes), w * 4) };
+                rgba[y * w * 4..(y + 1) * w * 4].copy_from_slice(row);
+            }
+            true
+        }
+        PIXEL_FORMAT_ARGB => {
+            for y in 0..h {
+                let row = unsafe { std::slice::from_raw_parts(base.add(y * row_bytes), w * 4) };
+                let dst = &mut rgba[y * w * 4..(y + 1) * w * 4];
+                for (s, d) in row.chunks_exact(4).zip(dst.chunks_exact_mut(4)) {
+                    d[0] = s[1];
+                    d[1] = s[2];
+                    d[2] = s[3];
+                    d[3] = s[0];
+                }
+            }
+            true
+        }
+        PIXEL_FORMAT_RGBA_HALF => {
+            for y in 0..h {
+                let row = unsafe { std::slice::from_raw_parts(base.add(y * row_bytes), w * 8) };
+                let dst = &mut rgba[y * w * 4..(y + 1) * w * 4];
+                for (s, d) in row.chunks_exact(8).zip(dst.chunks_exact_mut(4)) {
+                    for c in 0..4 {
+                        let bits = u16::from_le_bytes([s[c * 2], s[c * 2 + 1]]);
+                        let v = f16::from_bits(bits).to_f32().clamp(0.0, 1.0);
+                        d[c] = (v * 255.0 + 0.5) as u8;
+                    }
+                }
+            }
+            true
+        }
+        _ => false,
+    };
+    unsafe { corevideo::pixel_buffer::CVPixelBufferUnlockBaseAddress(pb, READ_ONLY_LOCK) };
+    if !ok {
+        return None;
+    }
+    Some(CiImageInner {
+        width: w as u32,
+        height: h as u32,
+        pixels: rgba,
+        premultiplied: true,
+        extent: NSRect {
+            origin: NSPoint { x: 0.0, y: 0.0 },
+            size: NSSize {
+                width: w as f64,
+                height: h as f64,
+            },
+        },
+        color_space: option_color_space(options),
+        properties: make_properties_dict(w as u32, h as u32, 1),
+    })
+}
+
+/// Bilinear sample of an RGBA image at top-down pixel coordinates `(u, v)`
+/// where pixel centers are at integer coordinates `(0, 0)..(w-1, h-1)`.
+#[inline]
+fn sample_bilinear(img: &CiImageInner, u: f64, v: f64) -> [u8; 4] {
+    let w = img.width as isize;
+    let h = img.height as isize;
+    if w == 0 || h == 0 {
+        return [0, 0, 0, 0];
+    }
+    let u = u.clamp(0.0, (w - 1) as f64);
+    let v = v.clamp(0.0, (h - 1) as f64);
+    let x0 = u.floor() as isize;
+    let y0 = v.floor() as isize;
+    let x1 = (x0 + 1).min(w - 1);
+    let y1 = (y0 + 1).min(h - 1);
+    let fx = (u - x0 as f64) as f32;
+    let fy = (v - y0 as f64) as f32;
+    let w00 = (1.0 - fx) * (1.0 - fy);
+    let w10 = fx * (1.0 - fy);
+    let w01 = (1.0 - fx) * fy;
+    let w11 = fx * fy;
+    let stride = w as usize * 4;
+    let p00 = y0 as usize * stride + x0 as usize * 4;
+    let p10 = y0 as usize * stride + x1 as usize * 4;
+    let p01 = y1 as usize * stride + x0 as usize * 4;
+    let p11 = y1 as usize * stride + x1 as usize * 4;
+    let px = &img.pixels;
+    let mut out = [0u8; 4];
+    for c in 0..4 {
+        let val = f32::from(px[p00 + c]) * w00
+            + f32::from(px[p10 + c]) * w10
+            + f32::from(px[p01 + c]) * w01
+            + f32::from(px[p11 + c]) * w11;
+        out[c] = val.round().clamp(0.0, 255.0) as u8;
+    }
+    out
+}
+
+/// Box-filtered downsample for clean reduction when `scale_x` or `scale_y` > 2.
+fn resample_axis_aligned_scale(
+    img: &CiImageInner,
+    out_w: u32,
+    out_h: u32,
+    flip_x: bool,
+    flip_y: bool,
+    high_quality: bool,
+) -> Vec<u8> {
+    let sw = img.width as usize;
+    let sh = img.height as usize;
+    let dw = out_w as usize;
+    let dh = out_h as usize;
+    let mut out = vec![0u8; dw * dh * 4];
+    let ratio_x = sw as f64 / dw as f64;
+    let ratio_y = sh as f64 / dh as f64;
+
+    if high_quality && (ratio_x >= 1.5 || ratio_y >= 1.5) {
+        for dy in 0..dh {
+            let fy = if flip_y { dh - 1 - dy } else { dy };
+            let y_start = (fy as f64 * ratio_y).floor().max(0.0) as usize;
+            let y_end = (((fy + 1) as f64) * ratio_y)
+                .ceil()
+                .min(sh as f64)
+                .max((y_start + 1) as f64) as usize;
+            for dx in 0..dw {
+                let fx = if flip_x { dw - 1 - dx } else { dx };
+                let x_start = (fx as f64 * ratio_x).floor().max(0.0) as usize;
+                let x_end = (((fx + 1) as f64) * ratio_x)
+                    .ceil()
+                    .min(sw as f64)
+                    .max((x_start + 1) as f64) as usize;
+                let mut acc = [0u64; 4];
+                let mut count = 0u64;
+                for sy in y_start..y_end {
+                    let row_off = sy * sw * 4;
+                    for sx in x_start..x_end {
+                        let off = row_off + sx * 4;
+                        acc[0] += u64::from(img.pixels[off]);
+                        acc[1] += u64::from(img.pixels[off + 1]);
+                        acc[2] += u64::from(img.pixels[off + 2]);
+                        acc[3] += u64::from(img.pixels[off + 3]);
+                        count += 1;
+                    }
+                }
+                let dst = (dy * dw + dx) * 4;
+                let half = count / 2;
+                out[dst] = ((acc[0] + half) / count) as u8;
+                out[dst + 1] = ((acc[1] + half) / count) as u8;
+                out[dst + 2] = ((acc[2] + half) / count) as u8;
+                out[dst + 3] = ((acc[3] + half) / count) as u8;
+            }
+        }
+        return out;
+    }
+
+    for dy in 0..dh {
+        let fy = if flip_y { dh - 1 - dy } else { dy };
+        let v = (fy as f64 + 0.5) * ratio_y - 0.5;
+        for dx in 0..dw {
+            let fx = if flip_x { dw - 1 - dx } else { dx };
+            let u = (fx as f64 + 0.5) * ratio_x - 0.5;
+            let px = sample_bilinear(img, u, v);
+            let dst = (dy * dw + dx) * 4;
+            out[dst..dst + 4].copy_from_slice(&px);
+        }
+    }
+    out
+}
+
+fn transform_image(img: &CiImageInner, t: CGAffineTransform, high_quality: bool) -> Option<CiImageInner> {
+    if img.width == 0 || img.height == 0 {
+        return None;
+    }
+    let det = t.a * t.d - t.b * t.c;
+    if !det.is_finite() || det.abs() < 1e-12 {
+        return None;
+    }
+    let ex = img.extent.origin.x;
+    let ey = img.extent.origin.y;
+    let ew = img.extent.size.width;
+    let eh = img.extent.size.height;
+    let corners = [
+        t.apply(ex, ey),
+        t.apply(ex + ew, ey),
+        t.apply(ex, ey + eh),
+        t.apply(ex + ew, ey + eh),
+    ];
+    let min_x = corners.iter().map(|p| p.0).fold(f64::INFINITY, f64::min);
+    let max_x = corners.iter().map(|p| p.0).fold(f64::NEG_INFINITY, f64::max);
+    let min_y = corners.iter().map(|p| p.1).fold(f64::INFINITY, f64::min);
+    let max_y = corners.iter().map(|p| p.1).fold(f64::NEG_INFINITY, f64::max);
+    let out_ew = (max_x - min_x).max(0.0);
+    let out_eh = (max_y - min_y).max(0.0);
+    let out_w = (out_ew.round().clamp(1.0, f64::from(MAX_RENDER_DIM))) as u32;
+    let out_h = (out_eh.round().clamp(1.0, f64::from(MAX_RENDER_DIM))) as u32;
+
+    let out_extent = NSRect {
+        origin: NSPoint { x: min_x, y: min_y },
+        size: NSSize {
+            width: out_ew,
+            height: out_eh,
+        },
+    };
+    let cs = if !img.color_space.is_null() {
+        unsafe { corefoundation::api::CFRetain(img.color_space) }
+    } else {
+        default_color_space()
+    };
+
+    // Fast path for pure axis-aligned scale / translate / flip (b == 0, c == 0).
+    let pixels = if t.b.abs() < 1e-9 && t.c.abs() < 1e-9 {
+        let flip_x = t.a < 0.0;
+        let flip_y = t.d < 0.0;
+        if out_w == img.width && out_h == img.height && !flip_x && !flip_y {
+            img.pixels.clone()
+        } else {
+            resample_axis_aligned_scale(img, out_w, out_h, flip_x, flip_y, high_quality)
+        }
+    } else {
+        // General 2D affine inverse in CoreImage y-up coordinates.
+        let inv_det = 1.0 / det;
+        let ia = t.d * inv_det;
+        let ib = -t.b * inv_det;
+        let ic = -t.c * inv_det;
+        let id = t.a * inv_det;
+        let itx = (t.c * t.ty - t.d * t.tx) * inv_det;
+        let ity = (t.b * t.tx - t.a * t.ty) * inv_det;
+        let mut out = vec![0u8; out_w as usize * out_h as usize * 4];
+        let step_x = out_ew / f64::from(out_w);
+        let step_y = out_eh / f64::from(out_h);
+        let sx_scale = f64::from(img.width) / ew.max(1e-9);
+        let sy_scale = f64::from(img.height) / eh.max(1e-9);
+        for dy in 0..out_h as usize {
+            let oy = max_y - (dy as f64 + 0.5) * step_y;
+            for dx in 0..out_w as usize {
+                let ox = min_x + (dx as f64 + 0.5) * step_x;
+                let sx = ia * ox + ic * oy + itx;
+                let sy = ib * ox + id * oy + ity;
+                if sx >= ex && sx <= ex + ew && sy >= ey && sy <= ey + eh {
+                    let u = (sx - ex) * sx_scale - 0.5;
+                    let v = (ey + eh - sy) * sy_scale - 0.5;
+                    let px = sample_bilinear(img, u, v);
+                    let off = (dy * out_w as usize + dx) * 4;
+                    out[off..off + 4].copy_from_slice(&px);
+                }
+            }
+        }
+        out
+    };
+
+    Some(CiImageInner {
+        width: out_w,
+        height: out_h,
+        pixels,
+        premultiplied: img.premultiplied,
+        extent: out_extent,
+        color_space: cs,
+        properties: make_properties_dict(out_w, out_h, 1),
+    })
+}
+
+/// Convert RGBA `[r, g, b, a]` to the requested alpha premultiplication state.
+#[inline]
+fn convert_alpha(px: [u8; 4], src_premul: bool, dst_premul: bool) -> [u8; 4] {
+    if src_premul == dst_premul {
+        return px;
+    }
+    let [r, g, b, a] = px;
+    if dst_premul {
+        [premul(r, a), premul(g, a), premul(b, a), a]
+    } else {
+        [unpremul(r, a), unpremul(g, a), unpremul(b, a), a]
+    }
+}
+
+/// Render `img` inside `bounds` (CoreImage y-up) into an RGBA buffer of size `(dst_w, dst_h)`
+/// top-row-first with `dst_premul` alpha.
+fn rasterize_bounds(
+    img: &CiImageInner,
+    bounds: NSRect,
+    dst_w: usize,
+    dst_h: usize,
+    dst_premul: bool,
+) -> Vec<u8> {
+    let mut out = vec![0u8; dst_w * dst_h * 4];
+    if img.width == 0
+        || img.height == 0
+        || dst_w == 0
+        || dst_h == 0
+        || bounds.size.width <= 0.0
+        || bounds.size.height <= 0.0
+    {
+        return out;
+    }
+
+    let ex = img.extent.origin.x;
+    let ey = img.extent.origin.y;
+    let ew = img.extent.size.width;
+    let eh = img.extent.size.height;
+
+    // Fast 1:1 direct copy when bounds match the image's extent and dimensions.
+    let same_bounds = (bounds.origin.x - ex).abs() < 1e-3
+        && (bounds.origin.y - ey).abs() < 1e-3
+        && (bounds.size.width - ew).abs() < 1e-3
+        && (bounds.size.height - eh).abs() < 1e-3
+        && dst_w == img.width as usize
+        && dst_h == img.height as usize;
+
+    if same_bounds {
+        if img.premultiplied == dst_premul {
+            out.copy_from_slice(&img.pixels);
+        } else {
+            for (s, d) in img.pixels.chunks_exact(4).zip(out.chunks_exact_mut(4)) {
+                let c = convert_alpha([s[0], s[1], s[2], s[3]], img.premultiplied, dst_premul);
+                d.copy_from_slice(&c);
+            }
+        }
+        return out;
+    }
+
+    let bx = bounds.origin.x;
+    let by = bounds.origin.y;
+    let bw = bounds.size.width;
+    let bh = bounds.size.height;
+    let sx_scale = f64::from(img.width) / ew.max(1e-9);
+    let sy_scale = f64::from(img.height) / eh.max(1e-9);
+    let step_x = bw / dst_w as f64;
+    let step_y = bh / dst_h as f64;
+
+    for dy in 0..dst_h {
+        let ci_y = by + bh - (dy as f64 + 0.5) * step_y;
+        if ci_y < ey || ci_y > ey + eh {
+            continue;
+        }
+        let v = (ey + eh - ci_y) * sy_scale - 0.5;
+        let row_off = dy * dst_w * 4;
+        for dx in 0..dst_w {
+            let ci_x = bx + (dx as f64 + 0.5) * step_x;
+            if ci_x < ex || ci_x > ex + ew {
+                continue;
+            }
+            let u = (ci_x - ex) * sx_scale - 0.5;
+            let raw = sample_bilinear(img, u, v);
+            let px = convert_alpha(raw, img.premultiplied, dst_premul);
+            let off = row_off + dx * 4;
+            out[off..off + 4].copy_from_slice(&px);
+        }
+    }
+    out
+}
