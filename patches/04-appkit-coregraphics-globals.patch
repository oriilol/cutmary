+//! CoreImage (`CIImage`, `CIContext`, `CIVector`, `CIFilter`, `CIColor`).
+//!
+//! Decodes images from `NSData`, `NSURL`, `CGImageRef`, and `CVPixelBufferRef`,
+//! applies affine transforms / orientation / crops in CoreImage's y-up space,
+//! and renders into `CVPixelBufferRef` or `CGImageRef` targets.
+
+use std::collections::HashMap;
+use std::ffi::c_void;
+use std::ptr;
+
+use corefoundation::base::CFTypeRef;
+use foundation::geometry::{NSPoint, NSRect, NSSize};
+use half::f16;
+use objc::object::Id;
+use objc::sel::Sel;
+
+use crate::cgcontext::CGAffineTransform;
+use crate::define::{class_methods, methods};
+
+const PIXEL_FORMAT_BGRA: u32 = u32::from_be_bytes(*b"BGRA");
+const PIXEL_FORMAT_RGBA: u32 = u32::from_be_bytes(*b"RGBA");
+const PIXEL_FORMAT_ARGB: u32 = 0x20;
+const PIXEL_FORMAT_RGBA_HALF: u32 = u32::from_be_bytes(*b"RGhA");
+const READ_ONLY_LOCK: u64 = 1;
+
+const MAX_RENDER_DIM: u32 = 16_384;
+
+struct CiImageInner {
+    /// RGBA pixels, top row first, `width * height * 4` bytes.
+    width: u32,
+    height: u32,
+    pixels: Vec<u8>,
+    premultiplied: bool,
+    /// Image bounds in CoreImage's y-up coordinate space.
+    extent: NSRect,
+    /// Retained `CGColorSpaceRef`.
+    color_space: CFTypeRef,
+    /// Retained `CFDictionaryRef` properties, or null.
+    properties: CFTypeRef,
+}
+
+impl Drop for CiImageInner {
+    fn drop(&mut self) {
+        if !self.color_space.is_null() {
+            unsafe { crate::graphics::CGColorSpaceRelease(self.color_space) };
+        }
+        if !self.properties.is_null() {
+            unsafe { corefoundation::api::CFRelease(self.properties) };
+        }
+    }
+}
+
+#[repr(C)]
+struct CiImageObj {
+    isa: *const c_void,
+    inner: *mut CiImageInner,
+}
+
+pub const IMAGE_INSTANCE_SIZE: usize = size_of::<CiImageObj>();
+
+#[repr(C)]
+struct CiContextObj {
