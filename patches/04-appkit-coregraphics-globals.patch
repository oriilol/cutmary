+            init_decompress: std::mem::transmute(load(c"tjInitDecompress")?),
+            decompress_header3: std::mem::transmute(load(c"tjDecompressHeader3")?),
+            decompress2: std::mem::transmute(load(c"tjDecompress2")?),
+            init_compress: std::mem::transmute(load(c"tjInitCompress")?),
+            compress2: std::mem::transmute(load(c"tjCompress2")?),
+            free: std::mem::transmute(load(c"tjFree")?),
+            destroy: std::mem::transmute(load(c"tjDestroy")?),
+        })
+    })
+    .as_ref()
