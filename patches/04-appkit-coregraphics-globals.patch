+/// Decode a JPEG image into RGBA via system `libturbojpeg.so.0`.
+fn jpeg(bytes: &[u8]) -> Option<Bitmap> {
+    const TJPF_RGBA: libc::c_int = 7;
+    let tj = turbojpeg()?;
+    unsafe {
+        let handle = (tj.init_decompress)();
+        if handle.is_null() {
+            return None;
+        }
+        let mut width: libc::c_int = 0;
+        let mut height: libc::c_int = 0;
+        let mut subsamp: libc::c_int = 0;
+        let mut colorspace: libc::c_int = 0;
+        let ok = (tj.decompress_header3)(
+            handle,
+            bytes.as_ptr(),
+            bytes.len() as libc::c_ulong,
+            &mut width,
+            &mut height,
+            &mut subsamp,
+            &mut colorspace,
+        );
+        if ok != 0 || width <= 0 || height <= 0 {
+            (tj.destroy)(handle);
+            return None;
+        }
+        let (w, h) = (width as u32, height as u32);
+        let len = (w as usize).checked_mul(h as usize)?.checked_mul(4)?;
+        let mut pixels = vec![0u8; len];
+        let rc = (tj.decompress2)(
+            handle,
+            bytes.as_ptr(),
+            bytes.len() as libc::c_ulong,
+            pixels.as_mut_ptr(),
+            width,
+            0,
+            height,
+            TJPF_RGBA,
+            0,
+        );
+        (tj.destroy)(handle);
+        if rc != 0 {
+            return None;
+        }
+        Some(Bitmap {
+            width: w,
+            height: h,
+            pixels,
+        })
+    }
+}
+
+/// Encode an RGBA bitmap to JPEG via system `libturbojpeg.so.0`.
+pub fn encode_jpeg(bitmap: &Bitmap, quality: i32) -> Option<Vec<u8>> {
+    const TJPF_RGBA: libc::c_int = 7;
+    const TJSAMP_420: libc::c_int = 2;
+    let tj = turbojpeg()?;
+    if bitmap.width == 0 || bitmap.height == 0 {
+        return None;
+    }
+    unsafe {
+        let handle = (tj.init_compress)();
+        if handle.is_null() {
+            return None;
+        }
+        let mut out_buf: *mut u8 = std::ptr::null_mut();
+        let mut out_size: libc::c_ulong = 0;
+        let rc = (tj.compress2)(
+            handle,
+            bitmap.pixels.as_ptr(),
+            bitmap.width as libc::c_int,
+            0,
+            bitmap.height as libc::c_int,
+            TJPF_RGBA,
+            &mut out_buf,
+            &mut out_size,
+            TJSAMP_420,
+            quality.clamp(1, 100),
+            0,
+        );
+        (tj.destroy)(handle);
+        if rc != 0 || out_buf.is_null() || out_size == 0 {
+            if !out_buf.is_null() {
+                (tj.free)(out_buf);
+            }
+            return None;
+        }
+        let vec = std::slice::from_raw_parts(out_buf, out_size as usize).to_vec();
+        (tj.free)(out_buf);
+        Some(vec)
+    }
+}
+
+struct WebpApi {
+    decode_rgba:
+        unsafe extern "C" fn(*const u8, usize, *mut libc::c_int, *mut libc::c_int) -> *mut u8,
+    free: unsafe extern "C" fn(*mut std::ffi::c_void),
+}
+
+fn webp_api() -> Option<&'static WebpApi> {
+    static API: std::sync::OnceLock<Option<WebpApi>> = std::sync::OnceLock::new();
+    API.get_or_init(|| unsafe {
+        let mut handle = std::ptr::null_mut();
+        for name in [c"libwebpdecoder.so.3", c"libwebp.so.7", c"libwebp.so"] {
+            handle = libc::dlopen(name.as_ptr(), libc::RTLD_LAZY | libc::RTLD_LOCAL);
+            if !handle.is_null() {
+                break;
+            }
+        }
+        if handle.is_null() {
+            return None;
+        }
+        let dec = libc::dlsym(handle, c"WebPDecodeRGBA".as_ptr());
+        let free = libc::dlsym(handle, c"WebPFree".as_ptr());
+        if dec.is_null() || free.is_null() {
+            return None;
+        }
+        Some(WebpApi {
+            decode_rgba: std::mem::transmute(dec),
+            free: std::mem::transmute(free),
+        })
+    })
+    .as_ref()
+}
+
+/// Decode a WebP image into RGBA via system `libwebpdecoder`.
+fn webp(bytes: &[u8]) -> Option<Bitmap> {
+    let api = webp_api()?;
+    unsafe {
+        let mut w: libc::c_int = 0;
+        let mut h: libc::c_int = 0;
+        let ptr = (api.decode_rgba)(bytes.as_ptr(), bytes.len(), &mut w, &mut h);
+        if ptr.is_null() || w <= 0 || h <= 0 {
+            if !ptr.is_null() {
+                (api.free)(ptr.cast());
+            }
+            return None;
+        }
+        let len = (w as usize).checked_mul(h as usize)?.checked_mul(4)?;
+        let pixels = std::slice::from_raw_parts(ptr, len).to_vec();
+        (api.free)(ptr.cast());
+        Some(Bitmap {
+            width: w as u32,
+            height: h as u32,
+            pixels,
+        })
+    }
+}
+
+/// Encode an RGBA bitmap as a valid uncompressed PNG (stored DEFLATE blocks).
+pub fn encode_png(bitmap: &Bitmap) -> Vec<u8> {
+    fn crc32(data: &[u8]) -> u32 {
+        let mut crc = 0xffff_ffffu32;
+        for &byte in data {
+            crc ^= u32::from(byte);
+            for _ in 0..8 {
+                crc = if crc & 1 != 0 {
+                    (crc >> 1) ^ 0xedb8_8320
+                } else {
+                    crc >> 1
+                };
+            }
+        }
+        !crc
+    }
+    fn push_chunk(out: &mut Vec<u8>, kind: &[u8; 4], payload: &[u8]) {
+        out.extend_from_slice(&(payload.len() as u32).to_be_bytes());
+        let start = out.len();
+        out.extend_from_slice(kind);
+        out.extend_from_slice(payload);
+        let crc = crc32(&out[start..]);
+        out.extend_from_slice(&crc.to_be_bytes());
+    }
+    let w = bitmap.width as usize;
+    let h = bitmap.height as usize;
+    let mut raw = Vec::with_capacity(h * (1 + w * 4));
+    for y in 0..h {
+        raw.push(0); // filter type None
+        let row = &bitmap.pixels[y * w * 4..(y + 1) * w * 4];
+        raw.extend_from_slice(row);
+    }
+    // Wrap raw scanlines in a valid zlib stream using uncompressed DEFLATE blocks.
+    let mut zlib = Vec::with_capacity(raw.len() + (raw.len() / 65535 + 1) * 5 + 6);
+    zlib.extend_from_slice(&[0x78, 0x01]);
+    let mut adler_a: u32 = 1;
+    let mut adler_b: u32 = 0;
+    for &byte in &raw {
+        adler_a = (adler_a + u32::from(byte)) % 65521;
+        adler_b = (adler_b + adler_a) % 65521;
+    }
+    let mut pos = 0;
+    while pos < raw.len() || (raw.is_empty() && pos == 0) {
+        let chunk_len = (raw.len() - pos).min(65535);
+        let is_last = pos + chunk_len >= raw.len();
+        zlib.push(if is_last { 0x01 } else { 0x00 });
+        let len16 = chunk_len as u16;
+        zlib.extend_from_slice(&len16.to_le_bytes());
+        zlib.extend_from_slice(&(!len16).to_le_bytes());
+        zlib.extend_from_slice(&raw[pos..pos + chunk_len]);
+        pos += chunk_len;
+        if raw.is_empty() {
+            break;
+        }
+    }
+    zlib.extend_from_slice(&((adler_b << 16) | adler_a).to_be_bytes());
+
+    let mut out = Vec::with_capacity(64 + zlib.len());
+    out.extend_from_slice(PNG_SIGNATURE);
+    let mut ihdr = [0u8; 13];
+    ihdr[0..4].copy_from_slice(&bitmap.width.to_be_bytes());
+    ihdr[4..8].copy_from_slice(&bitmap.height.to_be_bytes());
+    ihdr[8] = 8; // bit depth
+    ihdr[9] = 6; // RGBA
+    push_chunk(&mut out, b"IHDR", &ihdr);
+    push_chunk(&mut out, b"IDAT", &zlib);
+    push_chunk(&mut out, b"IEND", &[]);
+    out
+}
