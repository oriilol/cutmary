+unsafe extern "C" fn cg_color_space(receiver: Id, _sel: Sel) -> *const c_void {
+    let model = color_spaces()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get(&(receiver as usize))
+        .map_or(1, |s| s.model);
+    if model == 0 {
+        static GRAY_SPACE: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+        // SAFETY: creates an object this runtime keeps for the process.
+        return *GRAY_SPACE
+            .get_or_init(|| unsafe { crate::graphics::CGColorSpaceCreateDeviceGray() } as usize)
+            as *const c_void;
+    }
     static SPACE: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
     // SAFETY: creates an object this runtime keeps for the process.
     *SPACE.get_or_init(|| unsafe { crate::graphics::CGColorSpaceCreateDeviceRGB() } as usize)
         as *const c_void
 }
 
