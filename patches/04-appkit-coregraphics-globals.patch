+/// Whether `window` is already presenting with Metal/Vulkan (or owns a
+/// `CAMetalLayer`). Rebuilding such a window as `SDL_WINDOW_OPENGL` would
+/// destroy its Vulkan swapchain and force every Metal frame onto slow CPU
+/// readback.
+fn window_uses_metal(window: Id) -> bool {
+    if window.is_null() {
+        return false;
+    }
+    // SAFETY: null or a window this crate made.
+    let sdl = unsafe { crate::window::sdl_window(window) };
+    if !sdl.is_null()
+        && (sdl3::video::vulkan::owns_window(sdl)
+            || crate::view::metal_scene(sdl).is_some_and(|scene| !scene.is_empty()))
+    {
+        return true;
+    }
+    crate::view::window_has_metal_layer(window)
+}
