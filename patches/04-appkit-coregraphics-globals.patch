+            0,
+            height,
+            TJPF_RGBA,
+            0,
+        );
+        (tj.destroy)(handle);
+        if rc != 0 {
+            return None;
+        }
+        Some(Bitmap {
+            width: w,
+            height: h,
+            pixels,
+        })
+    }
