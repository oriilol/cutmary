+struct ColorSpaceState {
+    icc_data: usize,
+    model: isize,
+    components: isize,
+}
+
+static COLOR_SPACES: std::sync::OnceLock<Mutex<HashMap<usize, ColorSpaceState>>> =
+    std::sync::OnceLock::new();
+
+fn color_spaces() -> &'static Mutex<HashMap<usize, ColorSpaceState>> {
+    COLOR_SPACES.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+fn parse_icc_model_and_components(bytes: &[u8]) -> (isize, isize) {
+    if bytes.len() >= 40 && &bytes[36..40] == b"acsp" {
+        return match &bytes[16..20] {
+            b"GRAY" => (0, 1), // NSColorSpaceModelGray
+            b"RGB " => (1, 3), // NSColorSpaceModelRGB
+            b"CMYK" => (2, 4), // NSColorSpaceModelCMYK
+            b"Lab " => (3, 3), // NSColorSpaceModelLAB
+            _ => (1, 3),
+        };
+    }
+    (1, 3)
+}
+
+fn make_immortal_color_space(model: isize, components: isize) -> Id {
+    let class = objc::class::lookup(c"NSColorSpace").expect("declared");
+    let obj = objc::object::create_instance(class, 0);
+    objc::arc::make_immortal(obj);
+    let owned_data = corefoundation::collections::new_data(crate::icc::srgb_profile()) as usize;
+    color_spaces()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(
+            obj as usize,
+            ColorSpaceState {
+                icc_data: owned_data,
+                model,
+                components,
+            },
+        );
+    obj
+}
+
 pub(crate) unsafe extern "C" fn shared_color_space(_receiver: Id, _sel: Sel) -> Id {
     shared_instance(c"NSColorSpace")
 }
 
+unsafe extern "C" fn shared_gray_color_space(_receiver: Id, _sel: Sel) -> Id {
+    static GRAY: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *GRAY.get_or_init(|| make_immortal_color_space(0, 1) as usize) as Id
+}
+
+unsafe extern "C" fn shared_cmyk_color_space(_receiver: Id, _sel: Sel) -> Id {
+    static CMYK: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *CMYK.get_or_init(|| make_immortal_color_space(2, 4) as usize) as Id
+}
+
+/// `-[NSColorSpace initWithICCProfileData:]`: parses the ICC color space model
+/// and retains an immutable copy of the profile bytes. Returns `nil` when
+/// `icc_data` is nil or empty, matching macOS.
+unsafe extern "C" fn color_space_init_with_icc(receiver: Id, _sel: Sel, icc_data: Id) -> Id {
+    if receiver.is_null() {
+        return std::ptr::null_mut();
+    }
+    if icc_data.is_null() {
+        objc::arc::release(receiver);
+        return std::ptr::null_mut();
+    }
+    // SAFETY: `icc_data` is non-null and expected to be an `NSData` / `CFData`.
+    let Some(bytes) = (unsafe { corefoundation::collections::data(icc_data as *const c_void) })
+        .filter(|b| !b.is_empty())
+        .cloned()
+    else {
+        objc::arc::release(receiver);
+        return std::ptr::null_mut();
+    };
+    let (model, components) = parse_icc_model_and_components(&bytes);
+    let owned_data = corefoundation::collections::new_data(bytes) as usize;
+    let prev = color_spaces()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(
+            receiver as usize,
+            ColorSpaceState {
+                icc_data: owned_data,
+                model,
+                components,
+            },
+        );
+    if let Some(old) = prev {
+        // SAFETY: `old.icc_data` was created by `new_data` above.
+        unsafe { corefoundation::api::CFRelease(old.icc_data as *const c_void) };
+    }
+    receiver
+}
+
+/// `-[NSColorSpace initWithCGColorSpace:]`.
+unsafe extern "C" fn color_space_init_with_cg(
+    receiver: Id,
+    _sel: Sel,
+    cg_space: *const c_void,
+) -> Id {
+    if receiver.is_null() {
+        return std::ptr::null_mut();
+    }
+    if cg_space.is_null() {
+        objc::arc::release(receiver);
+        return std::ptr::null_mut();
+    }
+    let components = crate::graphics::space_components(cg_space).unwrap_or(3) as isize;
+    let model = match components {
+        1 => 0, // NSColorSpaceModelGray
+        4 => 2, // NSColorSpaceModelCMYK
+        _ => 1, // NSColorSpaceModelRGB
+    };
+    let bytes = crate::icc::srgb_profile();
+    let owned_data = corefoundation::collections::new_data(bytes) as usize;
+    let prev = color_spaces()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(
+            receiver as usize,
+            ColorSpaceState {
+                icc_data: owned_data,
+                model,
+                components,
+            },
+        );
+    if let Some(old) = prev {
+        unsafe { corefoundation::api::CFRelease(old.icc_data as *const c_void) };
+    }
+    receiver
+}
+
+unsafe extern "C" fn color_space_dealloc(receiver: Id, _sel: Sel) {
+    let removed = color_spaces()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .remove(&(receiver as usize));
+    if let Some(state) = removed {
+        // SAFETY: `state.icc_data` was owned by this entry.
+        unsafe { corefoundation::api::CFRelease(state.icc_data as *const c_void) };
+    }
+    objc::arc::finalize(receiver);
+}
