+++ b/crates/appkit/src/mtkview.rs
@@ -0,0 +1,464 @@
+//! `MTKView` (MetalKit): an `NSView` backed by a `CAMetalLayer`.
+
+use std::ffi::c_void;
+
+use foundation::geometry::{NSRect, NSSize};
+use objc::object::Id;
+use objc::sel::Sel;
+
+use crate::define::methods;
+
+/// `MTLClearColor`: four `double` channels.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ClearColor {
+    pub red: f64,
+    pub green: f64,
+    pub blue: f64,
+    pub alpha: f64,
+}
+
+/// Storage added by `MTKView` immediately after its `NSView` body.
+#[repr(C)]
+struct MtkView {
+    delegate: Id,
+    clear_color: ClearColor,
+    preferred_fps: i64,
+    depth_stencil_pixel_format: u64,
+    sample_count: u64,
+    paused: u8,
+    enable_set_needs_display: u8,
+    auto_resize_drawable: u8,
+}
+
+pub const INSTANCE_SIZE: usize = crate::view::INSTANCE_SIZE + size_of::<MtkView>();
+
+fn mtk_view_of<'a>(receiver: Id) -> &'a mut MtkView {
+    let base = objc::class::lookup(c"NSView")
+        .expect("NSView is declared before MTKView")
+        .instance_size();
+    // SAFETY: MTKView adds exactly this body after NSView's storage, and
+    // subclasses inherit it at the same offset.
+    unsafe { &mut *receiver.cast::<u8>().add(base).cast::<MtkView>() }
+}
+
+unsafe fn send_id(receiver: Id, sel: &str) -> Id {
+    if receiver.is_null() {
+        return std::ptr::null_mut();
+    }
+    let f: unsafe extern "C" fn(Id, Sel) -> Id = unsafe { std::mem::transmute(objc::msg::entry()) };
+    unsafe { darwin::call_as_darwin!(f(receiver, objc::sel::get(sel))) }
+}
+
+unsafe fn send_set_id(receiver: Id, sel: &str, value: Id) {
+    if receiver.is_null() {
+        return;
+    }
+    let f: unsafe extern "C" fn(Id, Sel, Id) = unsafe { std::mem::transmute(objc::msg::entry()) };
+    unsafe { darwin::call_as_darwin!(f(receiver, objc::sel::get(sel), value)) };
+}
+
+unsafe fn send_u64(receiver: Id, sel: &str) -> u64 {
+    if receiver.is_null() {
+        return 0;
+    }
+    let f: unsafe extern "C" fn(Id, Sel) -> u64 = unsafe { std::mem::transmute(objc::msg::entry()) };
+    unsafe { darwin::call_as_darwin!(f(receiver, objc::sel::get(sel))) }
+}
+
+unsafe fn send_set_u64(receiver: Id, sel: &str, value: u64) {
+    if receiver.is_null() {
+        return;
+    }
+    let f: unsafe extern "C" fn(Id, Sel, u64) = unsafe { std::mem::transmute(objc::msg::entry()) };
+    unsafe { darwin::call_as_darwin!(f(receiver, objc::sel::get(sel), value)) };
+}
+
+unsafe fn send_u8(receiver: Id, sel: &str) -> u8 {
+    if receiver.is_null() {
+        return 0;
+    }
+    let f: unsafe extern "C" fn(Id, Sel) -> u8 = unsafe { std::mem::transmute(objc::msg::entry()) };
+    unsafe { darwin::call_as_darwin!(f(receiver, objc::sel::get(sel))) }
+}
+
+unsafe fn send_set_u8(receiver: Id, sel: &str, value: u8) {
+    if receiver.is_null() {
+        return;
+    }
+    let f: unsafe extern "C" fn(Id, Sel, u8) = unsafe { std::mem::transmute(objc::msg::entry()) };
+    unsafe { darwin::call_as_darwin!(f(receiver, objc::sel::get(sel), value)) };
+}
+
+unsafe fn send_size(receiver: Id, sel: &str) -> NSSize {
+    if receiver.is_null() {
+        return NSSize::default();
+    }
+    let f: unsafe extern "C" fn(Id, Sel) -> NSSize =
+        unsafe { std::mem::transmute(objc::msg::entry()) };
+    unsafe { darwin::call_as_darwin!(f(receiver, objc::sel::get(sel))) }
+}
+
+unsafe fn send_set_size(receiver: Id, sel: &str, size: NSSize) {
+    if receiver.is_null() {
+        return;
+    }
+    let f: unsafe extern "C" fn(Id, Sel, NSSize) =
+        unsafe { std::mem::transmute(objc::msg::entry()) };
+    unsafe { darwin::call_as_darwin!(f(receiver, objc::sel::get(sel), size)) };
+}
+
+fn new_metal_layer() -> Id {
+    let Some(class) = objc::class::lookup(c"CAMetalLayer") else {
+        return std::ptr::null_mut();
+    };
+    unsafe { send_id(objc::class::ptr(class) as Id, "layer") }
+}
+
+fn ensure_metal_layer(view: Id) -> Id {
+    let existing = unsafe { send_id(view, "layer") };
+    if !existing.is_null() && crate::layer::is_metal(existing) {
+        return existing;
+    }
+    let metal = new_metal_layer();
+    if !metal.is_null() {
+        unsafe {
+            send_set_id(view, "setLayer:", metal);
+            send_set_u8(view, "setWantsLayer:", 1);
+        }
+    }
+    metal
+}
+
+fn init_body(receiver: Id, frame: NSRect, device: Id) {
+    let body = mtk_view_of(receiver);
+    body.delegate = std::ptr::null_mut();
+    body.clear_color = ClearColor {
+        red: 0.0,
+        green: 0.0,
+        blue: 0.0,
+        alpha: 1.0,
+    };
+    body.preferred_fps = 60;
+    body.depth_stencil_pixel_format = 0;
+    body.sample_count = 1;
+    body.paused = 0;
+    body.enable_set_needs_display = 0;
+    body.auto_resize_drawable = 1;
+
+    let layer = ensure_metal_layer(receiver);
+    if !layer.is_null() {
+        if !device.is_null() {
+            unsafe { send_set_id(layer, "setDevice:", device) };
+        }
+        if frame.size.width > 0.0 && frame.size.height > 0.0 {
+            unsafe { send_set_size(layer, "setDrawableSize:", frame.size) };
+        }
+    }
+}
+
+/// `-[MTKView initWithFrame:device:]`.
+unsafe extern "C" fn init_with_frame_device(
+    receiver: Id,
+    _sel: Sel,
+    frame: NSRect,
+    device: Id,
+) -> Id {
+    let receiver =
+        unsafe { crate::view::init_with_frame(receiver, objc::sel::get("initWithFrame:"), frame) };
+    if !receiver.is_null() {
+        init_body(receiver, frame, device);
+    }
+    receiver
+}
+
+/// `-[MTKView initWithFrame:]`.
+unsafe extern "C" fn init_with_frame(receiver: Id, sel: Sel, frame: NSRect) -> Id {
+    unsafe { init_with_frame_device(receiver, sel, frame, std::ptr::null_mut()) }
+}
+
+/// `-[MTKView initWithCoder:]`.
+unsafe extern "C" fn init_with_coder(receiver: Id, _sel: Sel, _coder: Id) -> Id {
+    let frame = NSRect::default();
+    let receiver =
+        unsafe { crate::view::init_with_frame(receiver, objc::sel::get("initWithFrame:"), frame) };
+    if !receiver.is_null() {
+        init_body(receiver, frame, std::ptr::null_mut());
+    }
+    receiver
+}
+
+/// `-[MTKView makeBackingLayer]`.
+unsafe extern "C" fn make_backing_layer(_receiver: Id, _sel: Sel) -> Id {
+    new_metal_layer()
+}
+
+unsafe extern "C" fn device(receiver: Id, _sel: Sel) -> Id {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_id(layer, "device") }
+}
+
+unsafe extern "C" fn set_device(receiver: Id, _sel: Sel, device: Id) {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_set_id(layer, "setDevice:", device) };
+}
+
+unsafe extern "C" fn color_pixel_format(receiver: Id, _sel: Sel) -> u64 {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_u64(layer, "pixelFormat") }
+}
+
+unsafe extern "C" fn set_color_pixel_format(receiver: Id, _sel: Sel, format: u64) {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_set_u64(layer, "setPixelFormat:", format) };
+}
+
+unsafe extern "C" fn drawable_size(receiver: Id, _sel: Sel) -> NSSize {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_size(layer, "drawableSize") }
+}
+
+unsafe extern "C" fn set_drawable_size(receiver: Id, _sel: Sel, size: NSSize) {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_set_size(layer, "setDrawableSize:", size) };
+}
+
+unsafe extern "C" fn framebuffer_only(receiver: Id, _sel: Sel) -> u8 {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_u8(layer, "framebufferOnly") }
+}
+
+unsafe extern "C" fn set_framebuffer_only(receiver: Id, _sel: Sel, value: u8) {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_set_u8(layer, "setFramebufferOnly:", value) };
+}
+
+unsafe extern "C" fn colorspace(receiver: Id, _sel: Sel) -> Id {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_id(layer, "colorspace") }
+}
+
+unsafe extern "C" fn set_colorspace(receiver: Id, _sel: Sel, cs: Id) {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_set_id(layer, "setColorspace:", cs) };
+}
+
+unsafe extern "C" fn current_drawable(receiver: Id, _sel: Sel) -> Id {
+    let layer = ensure_metal_layer(receiver);
+    unsafe { send_id(layer, "nextDrawable") }
+}
+
+unsafe extern "C" fn current_render_pass_descriptor(receiver: Id, _sel: Sel) -> Id {
+    let drawable = unsafe { current_drawable(receiver, objc::sel::get("currentDrawable")) };
+    if drawable.is_null() {
+        return std::ptr::null_mut();
+    }
+    let texture = unsafe { send_id(drawable, "texture") };
+    if texture.is_null() {
+        return std::ptr::null_mut();
+    }
+    let Some(rpd_cls) = objc::class::lookup(c"MTLRenderPassDescriptor") else {
+        return std::ptr::null_mut();
+    };
+    let desc = unsafe { send_id(objc::class::ptr(rpd_cls) as Id, "renderPassDescriptor") };
+    if desc.is_null() {
+        return std::ptr::null_mut();
+    }
+    let attachments = unsafe { send_id(desc, "colorAttachments") };
+    if !attachments.is_null() {
+        let indexed: unsafe extern "C" fn(Id, Sel, u64) -> Id =
+            unsafe { std::mem::transmute(objc::msg::entry()) };
+        let att0 = unsafe {
+            darwin::call_as_darwin!(indexed(
+                attachments,
+                objc::sel::get("objectAtIndexedSubscript:"),
+                0
+            ))
+        };
+        if !att0.is_null() {
+            unsafe {
+                send_set_id(att0, "setTexture:", texture);
+                send_set_u64(att0, "setLoadAction:", 2); // MTLLoadActionClear
+                send_set_u64(att0, "setStoreAction:", 1); // MTLStoreActionStore
+                let set_clear: unsafe extern "C" fn(Id, Sel, ClearColor) =
+                    std::mem::transmute(objc::msg::entry());
+                darwin::call_as_darwin!(set_clear(
+                    att0,
+                    objc::sel::get("setClearColor:"),
+                    mtk_view_of(receiver).clear_color
+                ));
+            }
+        }
+    }
+    desc
+}
+
+unsafe extern "C" fn delegate(receiver: Id, _sel: Sel) -> Id {
+    mtk_view_of(receiver).delegate
+}
+
+unsafe extern "C" fn set_delegate(receiver: Id, _sel: Sel, value: Id) {
+    mtk_view_of(receiver).delegate = value;
+}
+
+unsafe extern "C" fn clear_color(receiver: Id, _sel: Sel) -> ClearColor {
+    mtk_view_of(receiver).clear_color
+}
+
+unsafe extern "C" fn set_clear_color(receiver: Id, _sel: Sel, color: ClearColor) {
+    mtk_view_of(receiver).clear_color = color;
+}
+
+unsafe extern "C" fn preferred_fps(receiver: Id, _sel: Sel) -> i64 {
+    mtk_view_of(receiver).preferred_fps
+}
+
+unsafe extern "C" fn set_preferred_fps(receiver: Id, _sel: Sel, fps: i64) {
+    mtk_view_of(receiver).preferred_fps = fps;
+}
+
+unsafe extern "C" fn is_paused(receiver: Id, _sel: Sel) -> u8 {
+    mtk_view_of(receiver).paused
+}
+
+unsafe extern "C" fn set_paused(receiver: Id, _sel: Sel, value: u8) {
+    mtk_view_of(receiver).paused = u8::from(value != 0);
+}
+
+unsafe extern "C" fn enable_set_needs_display(receiver: Id, _sel: Sel) -> u8 {
+    mtk_view_of(receiver).enable_set_needs_display
+}
+
+unsafe extern "C" fn set_enable_set_needs_display(receiver: Id, _sel: Sel, value: u8) {
+    mtk_view_of(receiver).enable_set_needs_display = u8::from(value != 0);
+}
+
+unsafe extern "C" fn auto_resize_drawable(receiver: Id, _sel: Sel) -> u8 {
+    mtk_view_of(receiver).auto_resize_drawable
+}
+
+unsafe extern "C" fn set_auto_resize_drawable(receiver: Id, _sel: Sel, value: u8) {
+    mtk_view_of(receiver).auto_resize_drawable = u8::from(value != 0);
+}
+
+unsafe extern "C" fn sample_count(receiver: Id, _sel: Sel) -> u64 {
+    mtk_view_of(receiver).sample_count.max(1)
+}
+
+unsafe extern "C" fn set_sample_count(receiver: Id, _sel: Sel, count: u64) {
+    mtk_view_of(receiver).sample_count = count.max(1);
+}
+
+unsafe extern "C" fn depth_stencil_pixel_format(receiver: Id, _sel: Sel) -> u64 {
+    mtk_view_of(receiver).depth_stencil_pixel_format
+}
+
+unsafe extern "C" fn set_depth_stencil_pixel_format(receiver: Id, _sel: Sel, format: u64) {
+    mtk_view_of(receiver).depth_stencil_pixel_format = format;
+}
+
+unsafe extern "C" fn draw(receiver: Id, _sel: Sel) {
+    let delegate = mtk_view_of(receiver).delegate;
+    if !delegate.is_null() {
+        let responds: unsafe extern "C" fn(Id, Sel, Sel) -> u8 =
+            unsafe { std::mem::transmute(objc::msg::entry()) };
+        let draw_sel = objc::sel::get("drawInMTKView:");
+        if unsafe {
+            darwin::call_as_darwin!(responds(
+                delegate,
+                objc::sel::get("respondsToSelector:"),
+                draw_sel
+            ))
+        } != 0
+        {
+            unsafe { send_set_id(delegate, "drawInMTKView:", receiver) };
+        }
+    }
+}
+
+unsafe extern "C" fn release_drawables(_receiver: Id, _sel: Sel) {}
+
+pub(crate) fn install() {
+    let class = objc::class::lookup(c"MTKView").expect("MTKView is declared before its methods");
+    methods!(class, {
+        "initWithFrame:" => init_with_frame, c"@48@0:8{CGRect={CGPoint=dd}{CGSize=dd}}16";
+        "initWithFrame:device:" => init_with_frame_device, c"@56@0:8{CGRect={CGPoint=dd}{CGSize=dd}}16@48";
+        "initWithCoder:" => init_with_coder, c"@24@0:8@16";
+        "makeBackingLayer" => make_backing_layer, c"@16@0:8";
+        "device" => device, c"@16@0:8";
+        "setDevice:" => set_device, c"v24@0:8@16";
+        "colorPixelFormat" => color_pixel_format, c"Q16@0:8";
+        "setColorPixelFormat:" => set_color_pixel_format, c"v24@0:8Q16";
+        "drawableSize" => drawable_size, c"{CGSize=dd}16@0:8";
+        "setDrawableSize:" => set_drawable_size, c"v32@0:8{CGSize=dd}16";
+        "framebufferOnly" => framebuffer_only, c"c16@0:8";
+        "setFramebufferOnly:" => set_framebuffer_only, c"v20@0:8c16";
+        "colorspace" => colorspace, c"^{CGColorSpace=}16@0:8";
+        "setColorspace:" => set_colorspace, c"v24@0:8^{CGColorSpace=}16";
+        "currentDrawable" => current_drawable, c"@16@0:8";
+        "currentRenderPassDescriptor" => current_render_pass_descriptor, c"@16@0:8";
+        "delegate" => delegate, c"@16@0:8";
+        "setDelegate:" => set_delegate, c"v24@0:8@16";
+        "clearColor" => clear_color, c"{?=dddd}16@0:8";
+        "setClearColor:" => set_clear_color, c"v48@0:8{?=dddd}16";
+        "preferredFramesPerSecond" => preferred_fps, c"q16@0:8";
+        "setPreferredFramesPerSecond:" => set_preferred_fps, c"v24@0:8q16";
+        "isPaused" => is_paused, c"c16@0:8";
+        "paused" => is_paused, c"c16@0:8";
+        "setPaused:" => set_paused, c"v20@0:8c16";
+        "enableSetNeedsDisplay" => enable_set_needs_display, c"c16@0:8";
+        "setEnableSetNeedsDisplay:" => set_enable_set_needs_display, c"v20@0:8c16";
+        "autoResizeDrawable" => auto_resize_drawable, c"c16@0:8";
+        "setAutoResizeDrawable:" => set_auto_resize_drawable, c"v20@0:8c16";
+        "sampleCount" => sample_count, c"Q16@0:8";
+        "setSampleCount:" => set_sample_count, c"v24@0:8Q16";
+        "depthStencilPixelFormat" => depth_stencil_pixel_format, c"Q16@0:8";
+        "setDepthStencilPixelFormat:" => set_depth_stencil_pixel_format, c"v24@0:8Q16";
+        "draw" => draw, c"v16@0:8";
+        "releaseDrawables" => release_drawables, c"v16@0:8";
+    });
+    let _ = std::ptr::null::<c_void>();
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use foundation::geometry::NSPoint;
+
+    #[test]
+    fn mtk_view_creates_metal_backing_layer_and_forwards_properties() {
+        crate::bootstrap();
+        let class = objc::class::lookup(c"MTKView").expect("MTKView");
+        let view = objc::object::create_instance(class, 0);
+        let frame = NSRect {
+            origin: NSPoint { x: 0.0, y: 0.0 },
+            size: NSSize {
+                width: 640.0,
+                height: 360.0,
+            },
+        };
+        let view = unsafe { init_with_frame(view, objc::sel::get("initWithFrame:"), frame) };
+        assert!(!view.is_null());
+
+        let layer = unsafe { send_id(view, "layer") };
+        assert!(!layer.is_null(), "MTKView must have a backing layer");
+        assert!(
+            crate::layer::is_metal(layer),
+            "MTKView backing layer must be a CAMetalLayer"
+        );
+        assert_eq!(unsafe { send_u8(view, "wantsLayer") }, 1);
+        assert_eq!(
+            unsafe { send_size(view, "drawableSize") },
+            NSSize {
+                width: 640.0,
+                height: 360.0,
+            }
+        );
+
+        unsafe { send_set_u64(view, "setColorPixelFormat:", 115) };
+        assert_eq!(unsafe { send_u64(layer, "pixelFormat") }, 115);
+        assert_eq!(unsafe { send_u64(view, "colorPixelFormat") }, 115);
+
+        objc::arc::release(view);
+    }
+}
