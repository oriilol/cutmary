+pub unsafe extern "C" fn CGImageDestinationFinalize(dst: CFTypeRef) -> u8 {
+    let Some(dst) = destination_of(dst) else {
+        return 0;
+    };
+    let Some((width, height, bgra)) = image_bgra(dst.image) else {
+        return 0;
+    };
+    // Convert premultiplied BGRA to straight RGBA for encoders.
+    let mut rgba = Vec::with_capacity(width * height * 4);
+    for px in bgra.chunks_exact(4) {
+        let (b, g, r, a) = (px[0], px[1], px[2], px[3]);
+        if a == 0 || a == 255 {
+            rgba.extend_from_slice(&[r, g, b, a]);
+        } else {
+            let un = |c: u8| ((u16::from(c) * 255 + u16::from(a) / 2) / u16::from(a)).min(255) as u8;
+            rgba.extend_from_slice(&[un(r), un(g), un(b), a]);
+        }
+    }
+    let bitmap = crate::raster::Bitmap {
+        width: width as u32,
+        height: height as u32,
+        pixels: rgba,
+    };
+    let uti = if dst.uti.is_null() {
+        String::new()
+    } else {
+        String::from_utf8_lossy(&unsafe { foundation::string::bytes(dst.uti as _) })
+            .to_ascii_lowercase()
+    };
+    let encoded = if uti.contains("jpeg") || uti.contains("jpg") {
+        crate::raster::encode_jpeg(&bitmap, (dst.quality * 100.0).round() as i32)
+            .unwrap_or_else(|| crate::raster::encode_png(&bitmap))
+    } else if uti.contains("tiff") {
+        crate::raster::encode_tiff(&bitmap)
+    } else {
+        crate::raster::encode_png(&bitmap)
+    };
+    if !dst.target_data.is_null() {
+        unsafe {
+            corefoundation::api::CFDataAppendBytes(
+                dst.target_data,
+                encoded.as_ptr(),
+                encoded.len() as isize,
+            );
+        }
+        return 1;
+    }
+    if !dst.target_url.is_null() {
+        let Some(path) =
+            (unsafe { corefoundation::url::as_url(dst.target_url) }).and_then(|u| u.file_path())
+        else {
+            return 0;
+        };
+        let host = prefix::ns::host_path(&path);
+        if let Some(parent) = host.parent() {
+            let _ = std::fs::create_dir_all(parent);
+        }
+        return u8::from(std::fs::write(host, &encoded).is_ok());
+    }
+    0
+}
