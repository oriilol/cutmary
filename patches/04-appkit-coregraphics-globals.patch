+unsafe extern "C" fn ci_image_applying_filter(
+    receiver: Id,
+    _sel: Sel,
+    name: Id,
+    params: Id,
+) -> Id {
+    let filter_name = if name.is_null() {
+        String::new()
+    } else {
+        String::from_utf8_lossy(&unsafe { foundation::string::bytes(name) }).into_owned()
+    };
+    if filter_name == "CILanczosScaleTransform"
+        && let Some(scale_val) = Some(dict_value(params, &["inputScale"]))
+            .filter(|v| !v.is_null())
+            .and_then(|v| unsafe { corefoundation::collections::number(v) })
+    {
+        let scale = scale_val.as_f64();
+        let aspect = Some(dict_value(params, &["inputAspectRatio"]))
+            .filter(|v| !v.is_null())
+            .and_then(|v| unsafe { corefoundation::collections::number(v) })
+            .map_or(1.0, |n| n.as_f64());
+        let t = CGAffineTransform {
+            a: scale * aspect,
+            b: 0.0,
+            c: 0.0,
+            d: scale,
+            tx: 0.0,
+            ty: 0.0,
+        };
+        return unsafe { ci_image_by_applying_transform_hq(receiver, _sel, t, 1) };
+    }
+    autorelease(objc::arc::retain(receiver))
+}
