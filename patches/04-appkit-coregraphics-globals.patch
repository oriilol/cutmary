+        1 => make(slice[0], slice[0], slice[0], 1.0),
+        2 => make(slice[0], slice[0], slice[0], slice[1]),
+        3 => make(slice[0], slice[1], slice[2], 1.0),
+        _ => make(slice[0], slice[1], slice[2], slice[3]),
