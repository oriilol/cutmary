+    #[test]
+    fn ci_image_decodes_png_scales_and_renders_premultiplied_bgra_and_rgha_pixel_buffers() {
+        crate::bootstrap();
+        let pool = objc::arc::pool_push();
+        // 4x2 image: top half bright red opaque, bottom half semi-transparent green.
+        let mut rgba = Vec::with_capacity(4 * 2 * 4);
+        for _ in 0..4 {
+            rgba.extend_from_slice(&[255, 0, 0, 255]);
+        }
+        for _ in 0..4 {
+            rgba.extend_from_slice(&[0, 200, 0, 128]);
+        }
+        let png = encode_test_png(4, 2, &rgba);
+        let data = corefoundation::collections::new_data(png);
+
+        let ci_image_cls = objc::class::ptr(objc::class::lookup(c"CIImage").unwrap()) as Id;
+        let ci_context_cls = objc::class::ptr(objc::class::lookup(c"CIContext").unwrap()) as Id;
+
+        let image = unsafe {
+            let f: unsafe extern "C" fn(Id, Sel, Id, Id) -> Id =
+                std::mem::transmute(objc::msg::entry());
+            f(
+                ci_image_cls,
+                objc::sel::get("imageWithData:options:"),
+                data as Id,
+                ptr::null_mut(),
+            )
+        };
+        assert!(!image.is_null());
+
+        let extent = unsafe {
+            let f: unsafe extern "C" fn(Id, Sel) -> NSRect =
+                std::mem::transmute(objc::msg::entry_stret());
+            f(image, objc::sel::get("extent"))
+        };
+        assert_eq!(extent.size.width, 4.0);
+        assert_eq!(extent.size.height, 2.0);
+
+        let cs = unsafe {
+            let f: unsafe extern "C" fn(Id, Sel) -> CFTypeRef =
+                std::mem::transmute(objc::msg::entry());
+            f(image, objc::sel::get("colorSpace"))
+        };
+        assert!(!cs.is_null());
+
+        // Scale 2x via imageByApplyingTransform:highQualityDownsample:
+        let scale = unsafe { crate::cgcontext::CGAffineTransformMakeScale(2.0, 2.0) };
+        let scaled = unsafe {
+            let f: unsafe extern "C" fn(Id, Sel, CGAffineTransform, u8) -> Id =
+                std::mem::transmute(objc::msg::entry());
+            f(
+                image,
+                objc::sel::get("imageByApplyingTransform:highQualityDownsample:"),
+                scale,
+                1,
+            )
+        };
+        assert!(!scaled.is_null());
+        let scaled_extent = unsafe {
+            let f: unsafe extern "C" fn(Id, Sel) -> NSRect =
+                std::mem::transmute(objc::msg::entry_stret());
+            f(scaled, objc::sel::get("extent"))
+        };
+        assert_eq!((scaled_extent.size.width, scaled_extent.size.height), (8.0, 4.0));
+
+        // Render to 8x4 BGRA CVPixelBuffer (premultiplied default).
+        let ctx = unsafe {
+            let f: unsafe extern "C" fn(Id, Sel, Id) -> Id =
+                std::mem::transmute(objc::msg::entry());
+            f(
+                ci_context_cls,
+                objc::sel::get("contextWithOptions:"),
+                ptr::null_mut(),
+            )
+        };
+        let mut pb: CFTypeRef = ptr::null();
+        assert_eq!(
+            unsafe {
+                corevideo::pixel_buffer::CVPixelBufferCreate(
+                    ptr::null(),
+                    8,
+                    4,
+                    PIXEL_FORMAT_BGRA,
+                    ptr::null(),
+                    &mut pb,
+                )
+            },
+            0
+        );
+        unsafe {
+            let render: unsafe extern "C" fn(Id, Sel, Id, CFTypeRef, NSRect, CFTypeRef) =
+                std::mem::transmute(objc::msg::entry());
+            render(
+                ctx,
+                objc::sel::get("render:toCVPixelBuffer:bounds:colorSpace:"),
+                scaled,
+                pb,
+                scaled_extent,
+                cs,
+            );
+            assert_eq!(
+                corevideo::pixel_buffer::CVPixelBufferLockBaseAddress(pb, READ_ONLY_LOCK),
+                0
+            );
+            let base = corevideo::pixel_buffer::CVPixelBufferGetBaseAddress(pb) as *const u8;
+            let stride = corevideo::pixel_buffer::CVPixelBufferGetBytesPerRow(pb);
+            // Row 0 (top): bright red in BGRA -> [0, 0, 255, 255]
+            let top = std::slice::from_raw_parts(base, 4);
+            assert_eq!(top, &[0, 0, 255, 255]);
+            // Row 3 (bottom): semi-transparent green premultiplied -> [0, ~100, 0, 128]
+            let bottom = std::slice::from_raw_parts(base.add(3 * stride), 4);
+            assert_eq!(bottom[0], 0);
+            assert!((i32::from(bottom[1]) - 100).abs() <= 1, "bottom={bottom:?}");
+            assert_eq!(bottom[2], 0);
+            assert_eq!(bottom[3], 128);
+            corevideo::pixel_buffer::CVPixelBufferUnlockBaseAddress(pb, READ_ONLY_LOCK);
+            corevideo::pixel_buffer::CVPixelBufferRelease(pb);
+        }
+
+        // Also render original 4x2 into RGhA (64-bit half-float RGBA) pixel buffer.
+        let mut pb_hdr: CFTypeRef = ptr::null();
+        assert_eq!(
+            unsafe {
+                corevideo::pixel_buffer::CVPixelBufferCreate(
+                    ptr::null(),
+                    4,
+                    2,
+                    PIXEL_FORMAT_RGBA_HALF,
+                    ptr::null(),
+                    &mut pb_hdr,
+                )
+            },
+            0
+        );
+        unsafe {
+            let render: unsafe extern "C" fn(Id, Sel, Id, CFTypeRef, NSRect, CFTypeRef) =
+                std::mem::transmute(objc::msg::entry());
+            render(
+                ctx,
+                objc::sel::get("render:toCVPixelBuffer:bounds:colorSpace:"),
+                image,
+                pb_hdr,
+                extent,
+                cs,
+            );
+            assert_eq!(
+                corevideo::pixel_buffer::CVPixelBufferLockBaseAddress(pb_hdr, READ_ONLY_LOCK),
+                0
+            );
+            let base = corevideo::pixel_buffer::CVPixelBufferGetBaseAddress(pb_hdr) as *const u8;
+            let px = std::slice::from_raw_parts(base, 8);
+            let r = f16::from_le_bytes([px[0], px[1]]).to_f32();
+            let g = f16::from_le_bytes([px[2], px[3]]).to_f32();
+            let a = f16::from_le_bytes([px[6], px[7]]).to_f32();
+            assert!((r - 1.0).abs() < 0.01 && g.abs() < 0.01 && (a - 1.0).abs() < 0.01);
+            corevideo::pixel_buffer::CVPixelBufferUnlockBaseAddress(pb_hdr, READ_ONLY_LOCK);
+            corevideo::pixel_buffer::CVPixelBufferRelease(pb_hdr);
+            corefoundation::api::CFRelease(data);
+        }
+        objc::arc::pool_pop(pool);
+    }
