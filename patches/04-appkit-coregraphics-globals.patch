+
+pub unsafe extern "C" fn CGRectStandardize(
+    mut rect: foundation::geometry::NSRect,
+) -> foundation::geometry::NSRect {
+    if rect.origin.x.is_infinite() || rect.origin.y.is_infinite() {
+        return rect;
+    }
+    if rect.size.width < 0.0 {
+        rect.origin.x += rect.size.width;
+        rect.size.width = -rect.size.width;
+    }
+    if rect.size.height < 0.0 {
+        rect.origin.y += rect.size.height;
+        rect.size.height = -rect.size.height;
+    }
+    rect
+}
+
+pub unsafe extern "C" fn CGRectUnion(
+    a: foundation::geometry::NSRect,
+    b: foundation::geometry::NSRect,
+) -> foundation::geometry::NSRect {
+    if a.origin.x.is_infinite() || a.origin.y.is_infinite() {
+        return unsafe { CGRectStandardize(b) };
+    }
+    if b.origin.x.is_infinite() || b.origin.y.is_infinite() {
+        return unsafe { CGRectStandardize(a) };
+    }
+    let a = unsafe { CGRectStandardize(a) };
+    let b = unsafe { CGRectStandardize(b) };
+    let min_x = a.origin.x.min(b.origin.x);
+    let min_y = a.origin.y.min(b.origin.y);
+    let max_x = (a.origin.x + a.size.width).max(b.origin.x + b.size.width);
+    let max_y = (a.origin.y + a.size.height).max(b.origin.y + b.size.height);
+    foundation::geometry::NSRect {
+        origin: foundation::geometry::NSPoint { x: min_x, y: min_y },
+        size: foundation::geometry::NSSize {
+            width: max_x - min_x,
+            height: max_y - min_y,
+        },
+    }
+}
