+unsafe extern "C" fn ci_image_by_cropping(receiver: Id, _sel: Sel, rect: NSRect) -> Id {
+    let Some(img) = image_inner(receiver) else {
+        return ptr::null_mut();
+    };
+    let x0 = rect.origin.x.max(img.extent.origin.x);
+    let y0 = rect.origin.y.max(img.extent.origin.y);
+    let x1 = (rect.origin.x + rect.size.width).min(img.extent.origin.x + img.extent.size.width);
+    let y1 = (rect.origin.y + rect.size.height).min(img.extent.origin.y + img.extent.size.height);
+    if x1 <= x0 || y1 <= y0 {
+        let class = objc::class::lookup(c"CIImage").expect("CIImage installed");
+        return unsafe { ci_image_empty(objc::class::ptr(class) as Id, _sel) };
+    }
+    let crop = NSRect {
+        origin: NSPoint { x: x0, y: y0 },
+        size: NSSize {
+            width: x1 - x0,
+            height: y1 - y0,
+        },
+    };
+    let out_w = crop.size.width.round().clamp(1.0, f64::from(MAX_RENDER_DIM)) as usize;
+    let out_h = crop.size.height.round().clamp(1.0, f64::from(MAX_RENDER_DIM)) as usize;
+    let pixels = rasterize_bounds(img, crop, out_w, out_h, img.premultiplied);
+    let cs = if !img.color_space.is_null() {
+        unsafe { corefoundation::api::CFRetain(img.color_space) }
+    } else {
+        default_color_space()
+    };
+    let next = CiImageInner {
+        width: out_w as u32,
+        height: out_h as u32,
+        pixels,
+        premultiplied: img.premultiplied,
+        extent: crop,
+        color_space: cs,
+        properties: make_properties_dict(out_w as u32, out_h as u32, 1),
+    };
+    let class = objc::class::lookup(c"CIImage").expect("CIImage installed");
+    autorelease(make_ci_image(objc::class::ptr(class) as Id, next))
+}
