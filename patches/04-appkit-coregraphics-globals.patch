+        return state.icc_data as Id;
+    }
     static DATA: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
     *DATA.get_or_init(|| corefoundation::collections::new_data(crate::icc::srgb_profile()) as usize)
         as Id
 }
 
+unsafe extern "C" fn color_space_model(receiver: Id, _sel: Sel) -> isize {
+    color_spaces()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get(&(receiver as usize))
+        .map_or(1, |s| s.model)
+}
+
+unsafe extern "C" fn color_space_components(receiver: Id, _sel: Sel) -> isize {
+    color_spaces()
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .get(&(receiver as usize))
+        .map_or(3, |s| s.components)
+}
