+/// `ROSEMARY_TRACE_SIGNALS`: report every signal handed to a guest handler.
+/// Read where handlers are installed, since [`deliver`] may not read the
+/// environment.
+static TRACE_SIGNALS: AtomicBool = AtomicBool::new(false);
+
+/// One line on stderr for a signal [`deliver`] is about to hand to `handler`.
+/// Async-signal-safe: formatted on the stack and written with `write(2)`.
+fn trace_signal(
+    darwin: i32,
+    host: c_int,
+    info: *const libc::siginfo_t,
+    context: *const c_void,
+    handler: u64,
+) {
+    struct Line {
+        bytes: [u8; 192],
+        len: usize,
+    }
+    impl core::fmt::Write for Line {
+        fn write_str(&mut self, s: &str) -> core::fmt::Result {
+            let take = s.len().min(self.bytes.len() - self.len);
+            self.bytes[self.len..self.len + take].copy_from_slice(&s.as_bytes()[..take]);
+            self.len += take;
+            Ok(())
+        }
+    }
+    // SAFETY: the kernel's own arguments to the running handler, or null.
+    let (code, addr) = match unsafe { info.as_ref() } {
+        Some(info) => (info.si_code, unsafe { info.si_addr() } as usize),
+        None => (0, 0),
+    };
+    #[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+    // SAFETY: on Linux the third argument is the interrupted `ucontext_t`.
+    let pc = unsafe { context.cast::<libc::ucontext_t>().as_ref() }.map_or(0, |uc| {
+        uc.uc_mcontext.gregs[libc::REG_RIP as usize] as usize
+    });
+    #[cfg(not(all(target_os = "linux", target_arch = "x86_64")))]
+    let pc = context as usize & 0;
+    let mut line = Line {
+        bytes: [0; 192],
+        len: 0,
+    };
+    let _ = core::fmt::write(
+        &mut line,
+        format_args!(
+            "rosemary: signal: {darwin} (host {host}) code {code} addr {addr:#x} pc {pc:#x} -> guest handler {handler:#x}\n"
+        ),
+    );
+    // SAFETY: a live buffer written to stderr.
+    unsafe { libc::write(2, line.bytes.as_ptr().cast(), line.len) };
+}
