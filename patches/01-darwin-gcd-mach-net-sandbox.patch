+pub unsafe fn invoke_usize(block: u64, index: usize) {
+    if block == 0 {
+        return;
+    }
+    let entry = unsafe { ((block + INVOKE_OFFSET) as *const u64).read() };
+    if entry == 0 {
+        return;
+    }
+    unsafe { std::mem::transmute::<u64, extern "C" fn(u64, usize)>(entry)(block, index) };
+}
