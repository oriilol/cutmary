+    let token = NEXT_NOTIFY_TOKEN.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    // If NOTIFY_REUSE (1) is not set, create a pipe and keep the write end open
+    // until `notify_cancel` so the read end does not immediately report EOF.
+    if !notify_fd.is_null() && (flags & 1) == 0 {
