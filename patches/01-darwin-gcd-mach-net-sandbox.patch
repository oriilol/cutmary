+/// `int res_9_getservers(res_state statp, union res_sockaddr_union *set, int cnt)`
+/// Each `res_sockaddr_union` is 128 bytes on Darwin (`char pad[128]`).
+unsafe extern "C" fn res_9_getservers(_statp: *mut c_void, set: *mut c_void, cnt: i32) -> i32 {
+    if set.is_null() || cnt <= 0 {
+        return 0;
+    }
+    let content = std::fs::read_to_string("/etc/resolv.conf").unwrap_or_default();
+    let mut written = 0i32;
+    let base = set as *mut u8;
+    for line in content.lines() {
+        if written >= cnt {
+            break;
+        }
+        let line = line.trim();
+        let Some(rest) = line.strip_prefix("nameserver") else {
+            continue;
+        };
+        let ip_str = rest.trim().split_whitespace().next().unwrap_or("");
+        if let Ok(ip) = ip_str.parse::<std::net::Ipv4Addr>() {
+            let slot = unsafe { base.add((written as usize) * 128) };
+            unsafe {
+                std::ptr::write_bytes(slot, 0, 128);
+                // Darwin struct sockaddr_in: sin_len (16), sin_family (AF_INET=2), sin_port (53 BE), sin_addr
+                *slot.add(0) = 16;
+                *slot.add(1) = 2;
+                let port = 53u16.to_be_bytes();
+                *slot.add(2) = port[0];
+                *slot.add(3) = port[1];
+                let octets = ip.octets();
+                std::ptr::copy_nonoverlapping(octets.as_ptr(), slot.add(4), 4);
+            }
+            written += 1;
+        }
+    }
+    written
+}
