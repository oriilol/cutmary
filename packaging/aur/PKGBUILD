# Maintainer: Cutmary contributors <https://github.com/oriilol/cutmary>
#
# Builds the Cutmary launcher from the main branch. CapCut itself is not
# packaged: the launcher downloads the official macOS DMG on first run.
pkgname=cutmary-git
_pkgname=cutmary
pkgver=0.1.0
pkgrel=1
pkgdesc="GTK4/Libadwaita launcher that installs and runs macOS CapCut on Linux via Rosemary"
arch=('x86_64')
url="https://github.com/oriilol/cutmary"
license=('MIT')
# The launcher links GTK/libadwaita; the rest are host libraries Rosemary's
# ImageIO (JPEG/WebP), windowing (SDL3) and Metal-on-Vulkan paths load at
# run time while CapCut runs. The launcher's preflight check reports them too.
depends=('gtk4' 'libadwaita' 'glib2' 'glibc' 'gcc-libs' '7zip'
         'libjpeg-turbo' 'libwebp' 'sdl3' 'vulkan-icd-loader')
makedepends=('cargo' 'git')
optdepends=('rosemary: macOS compatibility runtime (build the patched one with scripts/build-rosemary.sh)'
            'vulkan-driver: GPU rendering (nvidia-utils, vulkan-radeon or vulkan-intel)')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto' '!debug')
source=("$_pkgname::git+$url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    local version
    version=$(sed -n 's/^version = "\(.*\)"/\1/p' launcher/Cargo.toml | head -n1)
    printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$_pkgname/launcher"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_pkgname/launcher"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$_pkgname/launcher"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release
}

package() {
    cd "$_pkgname"
    install -Dm755 launcher/target/release/cutmary "$pkgdir/usr/bin/cutmary"
    install -Dm644 packaging/org.cutmary.Cutmary.desktop "$pkgdir/usr/share/applications/org.cutmary.Cutmary.desktop"
    install -Dm644 packaging/org.cutmary.Cutmary.metainfo.xml "$pkgdir/usr/share/metainfo/org.cutmary.Cutmary.metainfo.xml"
    local size
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "launcher/assets/icons/hicolor/${size}x${size}/apps/org.cutmary.Cutmary.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/org.cutmary.Cutmary.png"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
